---
// ============================================================
// Casa.astro — la plantilla de la web nueva de Salix (rediseño 2026-11).
// Lleva la barra, el menú del teléfono y el pie de la familia (Nav.astro y Footer.astro sobre
// publico-salix.css), el cuerpo que hace de cortina sobre el pie y el tema claro u oscuro.
// La página pone su contenido y, al final, su bloque de cierre (`.psx-cierre`).
// ============================================================
import '../styles/casa.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { VERSION_LOGO } from '../marca-version';
import { enlacesBarra, ctaBarra, columnasPie } from '../casa/navegacion';

interface Props {
  titulo: string;
  descripcion: string;
  /** '' en la portada (los saltos son de la misma página); '/' en las demás. */
  base?: string;
  /** A dónde lleva el logo. */
  inicio?: string;
  /** Una página que no se publica ni se indexa (las propuestas). */
  sinIndexar?: boolean;
}
const { titulo, descripcion, base = '/', inicio = '/', sinIndexar = false } = Astro.props;
const conVersion = (ruta: string) => `${ruta}?v=${VERSION_LOGO}`;
---

<!doctype html>
<html lang="es" data-tema="claro">
<head>
  <meta charset="utf-8" />
  <!-- El tema, antes de pintar: el elegido en el pie o, si no eligió, el del aparato. -->
  <script is:inline>
    (function () {
      var d = document.documentElement;
      function aplicar() {
        var p = 'sistema';
        try { p = localStorage.getItem('salix-tema') || 'sistema'; } catch (e) {}
        var t = p === 'sistema' ? (window.matchMedia('(prefers-color-scheme:dark)').matches ? 'oscuro' : 'claro') : p;
        d.setAttribute('data-tema', t);
        d.setAttribute('data-pref', p);
        d.style.colorScheme = t === 'oscuro' ? 'dark' : 'light';
      }
      aplicar();
      window.addEventListener('pageshow', aplicar);
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  {sinIndexar && <meta name="robots" content="noindex, nofollow" />}
  <link rel="preload" href="/fuentes/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" type="image/svg+xml" id="favicon" href={conVersion('/favicon.svg')} />
  <script is:inline define:vars={{ claro: conVersion('/favicon-claro.svg'), oscuro: conVersion('/favicon-oscuro.svg') }}>
    (function () {
      var m = window.matchMedia('(prefers-color-scheme: dark)');
      var l = document.getElementById('favicon');
      var aplicar = function () { if (l) l.setAttribute('href', m.matches ? oscuro : claro); };
      aplicar();
      m.addEventListener('change', aplicar);
    })();
  </script>
  <link rel="apple-touch-icon" href={conVersion('/apple-touch-icon.png')} />
</head>

<body>
  <Nav enlaces={enlacesBarra(base)} cta={ctaBarra(base)} inicio={inicio} />
  <main class="psx-cuerpo">
    <slot />
  </main>
  <Footer columnas={columnasPie(base)} inicio={inicio} />
</body>
</html>

<script>
  import { iniciarToggleTema } from '../scripts/utilidades.js';
  import { montarPublicoSalix } from '../scripts/publico-salix';
  import '../firma-stian/firma-stian.js';

  document.addEventListener('DOMContentLoaded', () => {
    iniciarToggleTema('boton-tema');
    // La barra, el menú del teléfono, el pie en cortina y el cierre que se acomoda (familia).
    montarPublicoSalix(document);
  });
</script>
