---
// ============================================================
// Plantilla.astro — Layout base del sitio
// Todos los componentes de pagina usan este layout.
// ============================================================
import { VERSION_LOGO } from '../marca-version';
import { LEMA_SALIX } from '../lema';

interface Props {
  titulo:      string;
  descripcion: string;
  imagen?:     string;
  keywords?:   string;
}

const {
  titulo,
  descripcion,
  // PNG, no SVG: ninguna plataforma renderiza SVG en la vista previa de un link
  // (WhatsApp, Facebook, Twitter/X, LinkedIn). Lo genera `npm run og`.
  imagen = '/og-image.png',
  keywords = 'CRM Argentina, software gestion, delivery, turnos online, canchas padel, PWA',
} = Astro.props;

const urlCanonica = Astro.url.href;
// La imagen de compartir y los íconos llevan la versión del logo en la URL: el CDN
// de Hostinger cachea public/ 7 días, y sin la `?v=` un logo nuevo tarda una semana
// en verse (y los que ya compartieron el link siguen con la vista previa vieja).
const conVersion = (ruta: string) => `${ruta}?v=${VERSION_LOGO}`;
const imagenAbsoluta = new URL(imagen === '/og-image.png' ? conVersion(imagen) : imagen, Astro.site).href;
const schemaOrg = JSON.stringify({
  "@context":    "https://schema.org",
  "@type":       "Organization",
  "name":        "Salix",
  "url":         "https://salixweb.com",
  "logo":        `https://salixweb.com/og-image.png?v=${VERSION_LOGO}`,
  "slogan":      `SALIX — ${LEMA_SALIX}`,
  "description": "Suite de productos de software para empresas argentinas",
  "address":     { "@type": "PostalAddress", "addressLocality": "Buenos Aires", "addressCountry": "AR" },
  "contactPoint": { "@type": "ContactPoint", "email": "info@salixweb.com", "contactType": "customer service", "availableLanguage": "Spanish" },
  "sameAs":      []
});
---

<!DOCTYPE html>
<html lang="es" data-tema="claro">
<head>
  <meta charset="UTF-8" />
  <script is:inline>
    (function(){
      var d=document.documentElement;
      function aplicar(){
        var p=localStorage.getItem('salix-tema')||'sistema';
        var t=p==='sistema'?(window.matchMedia('(prefers-color-scheme:dark)').matches?'oscuro':'claro'):p;
        d.setAttribute('data-tema',t);
        d.setAttribute('data-pref',p);
        d.style.colorScheme=t==='oscuro'?'dark':'light';
      }
      aplicar();
      window.addEventListener('pageshow',aplicar);
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#fafafa" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />

  <!-- Favicon: la Cortina oscura en tema claro y clara en tema oscuro. Se declara solo el SVG
       (con el .ico en la lista, Chrome podía elegirlo, y no cambia con el tema). El script elige el
       archivo fijo según el tema del navegador y lo cambia si el tema cambia con la pestaña abierta:
       la media query del SVG sola no alcanzaba (regla en docs/familia-salix/kit-marca.md de Flux). -->
  <link rel="icon" type="image/svg+xml" id="favicon" href={conVersion('/favicon.svg')} />
  <script is:inline define:vars={{ claro: conVersion('/favicon-claro.svg'), oscuro: conVersion('/favicon-oscuro.svg') }}>
    (function () {
      var m = window.matchMedia('(prefers-color-scheme: dark)');
      var l = document.getElementById('favicon');
      var aplicar = function () { if (l) l.setAttribute('href', m.matches ? oscuro : claro); };
      aplicar();
      m.addEventListener('change', aplicar);
    })();
  </script>
  <link rel="apple-touch-icon" href={conVersion('/apple-touch-icon.png')} />

  <!-- SEO Principal -->
  <title>{titulo}</title>
  <meta name="description"  content={descripcion} />
  <meta name="keywords"     content={keywords} />
  <meta name="author"       content="Salix" />
  <meta name="robots"       content="index, follow" />
  <link rel="canonical"     href={urlCanonica} />

  <!-- Open Graph -->
  <meta property="og:type"         content="website" />
  <meta property="og:url"          content={urlCanonica} />
  <meta property="og:title"        content={titulo} />
  <meta property="og:description"  content={descripcion} />
  <meta property="og:image"        content={imagenAbsoluta} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type"   content="image/png" />
  <meta property="og:locale"       content="es_AR" />
  <meta property="og:site_name"    content="Salix" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:site"        content="@salixweb" />
  <meta name="twitter:creator"     content="@salixweb" />
  <meta name="twitter:title"       content={titulo} />
  <meta name="twitter:description" content={descripcion} />
  <meta name="twitter:image"       content={imagenAbsoluta} />
  <meta name="twitter:image:alt"   content={titulo} />

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={schemaOrg}></script>

  <!-- Tipografia -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>

<body>
  <!-- Contenido de la pagina -->
  <slot />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<script>
  import {
    iniciarToggleTema,
    iniciarSmoothScroll,
    iniciarAnimacionIconos,
    iniciarTypewriter,
  } from '../scripts/utilidades.js';
  import { montarPublicoSalix } from '../scripts/publico-salix';
  import { iniciarParticulas } from '../scripts/particulas.js';
  import { iniciarAnimacionesScroll } from '../scripts/animaciones-scroll.js';
  import '../firma-stian/firma-stian.js';

  // Inicializar todo cuando el DOM este listo
  document.addEventListener('DOMContentLoaded', () => {
    iniciarToggleTema('boton-tema');
    // La barra, el menú móvil y el pie de la familia (publico-salix.ts, GENERADO).
    montarPublicoSalix(document);
    iniciarAnimacionIconos('.item-producto, .item-feature, .item-precio');
    iniciarTypewriter();

    // GSAP animaciones de scroll
    iniciarAnimacionesScroll();

    // Smooth scroll para links de ancla
    iniciarSmoothScroll();

    // Inicializar grids magneticos
    document.querySelectorAll('.grid-magnetico-canvas').forEach((c) => {
      iniciarParticulas(c.id);
    });

  });
</script>
