---
// Integraciones: sesiones de 45 minutos para dejar andando un sistema, sea de Salix o no. Cómo
// funciona, en qué ayudamos, la tarjeta para elegir cuántas sesiones (la misma de /planes de Flux),
// las preguntas y el formulario, que ya sabe de qué se trata la consulta.
// Los precios y las reglas son los que se publican desde siempre: primera US$ 70, cada extra US$ 50,
// hasta 10 por pedido. Están escritos una vez, en TarjetaSesiones.astro, y acá se nombran.
import Casa from '../layouts/Casa.astro';
import CierreCasa from '../components/CierreCasa.astro';
import FormularioCasa from '../components/FormularioCasa.astro';
import TarjetaSesiones from '../components/TarjetaSesiones.astro';
import IconoProducto from '../components/IconoProducto.astro';
import { ENTRADAS, CORREO } from '../casa/datos';
import { RAIZ_CASA } from '../casa/navegacion';

const e = ENTRADAS.find((x) => x.id === 'integraciones')!;

const CIFRAS = [
  { cifra: '45 min', que: 'dura cada sesión' },
  { cifra: 'US$ 70', que: 'la primera sesión' },
  { cifra: 'US$ 50', que: 'cada sesión extra' },
  { cifra: '10', que: 'sesiones como máximo por pedido' },
];

const PASOS = [
  { titulo: 'Contanos el software', texto: 'Puede ser Flux, otro producto de Salix o una herramienta que ya uses. Por WhatsApp, por correo o con el formulario de abajo.' },
  { titulo: 'Elegís las sesiones', texto: 'Cada una dura 45 minutos. La primera, US$ 70; cada extra, US$ 50. Hasta 10. La tarjeta de abajo se actualiza al sumar.' },
  { titulo: 'Coordinamos y lo dejamos andando', texto: 'Si es Flux, también podés pagar directo en flux.salixweb.com/planes. Si no, te pasamos el link y agendamos.' },
];

const SERVICIOS = [
  { titulo: 'Configurar el producto', texto: 'Flux o Menu: permisos, WhatsApp, módulos y el día a día de tu equipo.' },
  { titulo: 'Conectar sistemas', texto: 'WhatsApp, Mercado Pago, Google, planillas o una API. El dato entra una vez y viaja.' },
  { titulo: 'Sitios y landings', texto: 'Una web que carga rápido, preparada para que te encuentren y con un formulario que llega a tu operación.' },
  { titulo: 'Migrar lo que ya tenés', texto: 'Excel, otro software, contactos en el teléfono. Lo traemos sin una migración masiva.' },
  { titulo: 'Automatizaciones', texto: 'Avisos, menús de WhatsApp, flujos al cambiar un estado. Menos trabajo repetido.' },
  { titulo: 'Consultoría técnica', texto: 'Arquitectura, herramientas y el recorte justo: qué conviene hacer ahora y qué después.' },
];

const PREGUNTAS = [
  { p: '¿Sirve para cualquier software?', r: 'Sí. Configuramos los productos de Salix y también conectamos lo que ya tengas: WhatsApp, Mercado Pago, planillas, APIs. No hace falta que sea nuestro.' },
  { p: '¿Cuánto dura cada sesión?', r: '45 minutos de trabajo enfocado. No es una hora corrida ni una demostración: es implementación.' },
  { p: '¿Cuánto sale?', r: 'La primera sesión, US$ 70. Cada extra, US$ 50. Se cobra en pesos al cambio del día. Hasta 10 sesiones por pedido.' },
  { p: '¿Está incluido en la suscripción de Flux?', r: 'No. La prueba y el plan son el producto. Esto es configuración a pedido, aparte.' },
  { p: '¿Cómo se paga?', r: 'Si es implementación de Flux, pagás en flux.salixweb.com/planes. Para el resto, pedís las sesiones acá y te pasamos el link.' },
];

const paradas = [
  { id: 'como', nombre: 'Cómo funciona' },
  { id: 'en-que', nombre: 'En qué' },
  { id: 'sesiones', nombre: 'Sesiones' },
  { id: 'preguntas', nombre: 'Preguntas' },
  { id: 'contacto', nombre: 'Contacto' },
];
---

<Casa
  titulo="Integraciones · Te lo dejamos andando · Salix"
  descripcion="Sesiones de 45 minutos para configurar, conectar o implementar un sistema: Flux, tu sitio o el software que ya uses. La primera, US$ 70; cada extra, US$ 50."
  base={RAIZ_CASA}
  inicio={RAIZ_CASA}
>
  <div style="--c:var(--linea-integraciones)">
    <section class="cabeza con-riel" data-riel>
      <div class="riel" aria-hidden="true">
        <span class="riel-linea riel-linea--nace"></span>
        <span class="riel-punto" data-parada></span>
      </div>
      <div class="cabeza-caja riel-cuerpo ancho">
        <div>
          <nav class="migas" aria-label="Dónde estás">
            <a href={RAIZ_CASA}>Salix</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Integraciones</span>
          </nav>
          <p class="producto-nombre">
            <span class="producto-logo"><IconoProducto nombre="link" tamaño={20} /></span>
            {e.nombre}
            <span class="producto-que">{e.que}</span>
            <span class="estado">{e.estado}</span>
          </p>
          <h1 class="titulo titulo--pagina" data-asoma><span>Te lo dejamos andando.</span> En el software que uses.</h1>
          <p class="bajada" data-asoma style="--i:1">
            Configuramos Flux, tu sitio o lo que ya tengas: WhatsApp, Mercado Pago, una planilla, una API. No hace falta que sea nuestro.
          </p>
          <div class="acciones" data-asoma style="--i:2">
            <a class="boton" href="#sesiones">Elegir sesiones</a>
            <a class="boton boton-secundario" href="#contacto">Hablemos</a>
          </div>
        </div>
        <ul class="cifras" data-asoma style="--i:2">
          {CIFRAS.map((c) => <li><strong>{c.cifra}</strong><span>{c.que}</span></li>)}
        </ul>
      </div>

      <nav class="indice riel-cuerpo ancho" aria-label="Las partes de esta página" data-asoma style="--i:4">
        <ol>
          {paradas.map((p) => (
            <li><a href={`#${p.id}`}><span class="indice-punto" aria-hidden="true"></span>{p.nombre}</a></li>
          ))}
        </ol>
      </nav>
    </section>

    <section class="tramo con-riel con-parada" id="como" data-riel>
      <div class="riel" aria-hidden="true">
        <span class="riel-linea"></span>
        <span class="riel-punto" data-parada></span>
      </div>
      <div class="riel-cuerpo ancho">
        <p class="parada-nombre">Cómo funciona</p>
        <h2 class="titulo" data-asoma><span>Tres pasos.</span> Sin letra chica.</h2>
        <ol class="hechos hechos--nombre hechos--columnas pasos-numerados" data-asoma style="--i:1;--columnas:3">
          {PASOS.map((p, i) => <li><span class="paso-numero" aria-hidden="true">{i + 1}</span><strong>{p.titulo}</strong> {p.texto}</li>)}
        </ol>
      </div>
    </section>

    <section class="tramo con-riel con-parada" id="en-que" data-riel>
      <div class="riel" aria-hidden="true">
        <span class="riel-linea"></span>
        <span class="riel-punto" data-parada></span>
      </div>
      <div class="riel-cuerpo ancho">
        <p class="parada-nombre">En qué</p>
        <h2 class="titulo" data-asoma><span>Cualquier sistema.</span> El recorte justo.</h2>
        <ul class="hechos hechos--nombre hechos--columnas" data-asoma style="--i:1;--columnas:3">
          {SERVICIOS.map((s) => <li><strong>{s.titulo}</strong> {s.texto}</li>)}
        </ul>
      </div>
    </section>

    <section class="tramo con-riel con-parada" id="sesiones" data-riel>
      <div class="riel" aria-hidden="true">
        <span class="riel-linea"></span>
        <span class="riel-punto" data-parada></span>
      </div>
      <div class="riel-cuerpo ancho">
        <p class="parada-nombre">Sesiones</p>
        <div class="dos">
          <h2 class="titulo" data-asoma><span>Elegí las sesiones.</span> La tarjeta cambia.</h2>
          <p class="bajada" data-asoma style="--i:1">La primera, US$ 70. Cada extra, US$ 50. Hasta 10. Se cobra en pesos al cambio del día.</p>
        </div>
        <div class="sesiones" data-asoma style="--i:1">
          <TarjetaSesiones
            marca="Salix"
            codigo="SLX"
            titulo="¿Necesitás que te configuremos el sistema?"
            texto="Cada sesión dura 45 minutos. Te ayudamos a cargar datos, conectar WhatsApp, permisos y los módulos que uses, en Flux o en otra herramienta."
            ctaTexto="Pedir estas sesiones"
            ctaModo="contacto"
            nota="Si es implementación de Flux, también podés pagar directo en flux.salixweb.com/planes."
          />
        </div>
      </div>
    </section>

    <section class="tramo con-riel con-parada" id="preguntas" data-riel>
      <div class="riel" aria-hidden="true">
        <span class="riel-linea riel-linea--fin"></span>
        <span class="riel-punto" data-parada></span>
      </div>
      <div class="riel-cuerpo ancho">
        <p class="parada-nombre">Preguntas</p>
        <div class="dos dos--arriba">
          <h2 class="titulo" data-asoma><span>Antes</span> de escribirnos.</h2>
          <div class="preguntas" data-asoma style="--i:1">
            {PREGUNTAS.map((q) => (
              <details>
                <summary>{q.p}<span class="preguntas-marca" aria-hidden="true"></span></summary>
                <p>{q.r}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="tramo" id="contacto">
    <div class="contacto ancho">
      <div class="contacto-texto" data-asoma>
        <h2 class="titulo"><span>Contanos</span> qué hay que dejar andando.</h2>
        <p class="bajada">Flux, tu sitio o una herramienta que ya uses. Sin compromiso.</p>
        <a class="enlace" href={`mailto:${CORREO}`}>{CORREO} <span aria-hidden="true">→</span></a>
      </div>
      <FormularioCasa preseleccionado="Integraciones" />
    </div>
  </section>

  <CierreCasa
    liviana="¿Preferís hablarlo directo?"
    tinta="Escribinos."
    bajada="Lo vemos juntos: qué usás hoy y qué hay que dejar andando."
    contacto="#contacto"
  />
</Casa>

<style>
  /* Las cifras de la cabecera: cuatro datos, en la mesa neutra de la casa. */
  .cifras {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-radius: 0.875rem;
    background: var(--fondo-alt);
    box-shadow: inset 0 0 0 1px var(--borde);
    overflow: hidden;
  }
  .cifras li {
    display: grid;
    align-content: center;
    gap: 0.25rem;
    min-block-size: clamp(7rem, 14vw, 10rem);
    padding: clamp(1rem, 2.5vw, 1.75rem);
    border-top: 1px solid var(--borde);
    border-inline-start: 1px solid var(--borde);
    /* El borde de arriba y el de la izquierda de las celdas del borde quedan fuera de la caja. */
    margin: -1px 0 0 -1px;
  }
  .cifras strong {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .cifras span {
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--texto-secundario);
    text-wrap: balance;
  }

  /* Los pasos llevan su número, como una parada. */
  .paso-numero {
    display: grid;
    place-items: center;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    margin-bottom: 0.5rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--texto);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--texto);
  }

  .sesiones {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  /* Las preguntas: se abren de a una, con la misma línea fina de los hechos. */
  .preguntas details {
    border-top: 1px solid var(--borde);
  }
  .preguntas details:last-child {
    border-bottom: 1px solid var(--borde);
  }
  .preguntas summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-block-size: 3.25rem;
    padding-block: 0.75rem;
    font-size: 1rem;
    font-weight: 550;
    cursor: pointer;
    list-style: none;
  }
  .preguntas summary::-webkit-details-marker {
    display: none;
  }
  /* El más que gira a por: dos trazos del color del texto. */
  .preguntas-marca {
    position: relative;
    flex: none;
    inline-size: 0.875rem;
    block-size: 0.875rem;
    transition: rotate 0.35s var(--curva);
  }
  .preguntas-marca::before,
  .preguntas-marca::after {
    content: '';
    position: absolute;
    inset: calc(50% - 0.75px) 0 auto;
    block-size: 1.5px;
    background: var(--texto-secundario);
  }
  .preguntas-marca::after {
    rotate: 90deg;
  }
  details[open] .preguntas-marca {
    rotate: 45deg;
  }
  .preguntas p {
    padding-bottom: 1.125rem;
    max-inline-size: 52ch;
    font-size: 0.9375rem;
    color: var(--texto-secundario);
    text-wrap: pretty;
  }
  @media (prefers-reduced-motion: reduce) {
    .preguntas-marca {
      transition: none;
    }
  }
</style>
