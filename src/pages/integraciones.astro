---
import Plantilla from '../layouts/Plantilla.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import IconoSVG from '../components/ui/IconoSVG.astro';
import TarjetaSesiones from '../components/TarjetaSesiones.astro';
import FormularioContacto from '../components/FormularioContacto.astro';

const SERVICIOS = [
  { titulo: 'Configurar el producto', desc: 'Flux, Sites, Go, Play o Book: permisos, WhatsApp, módulos y el día a día de tu equipo.', icono: 'cubo' },
  { titulo: 'Conectar sistemas', desc: 'WhatsApp, Mercado Pago, Google, planillas o una API. El dato entra una vez y viaja.', icono: 'link' },
  { titulo: 'Sitios y landings', desc: 'Una web que carga rápido, con SEO y un formulario que llega a tu operación.', icono: 'sitio' },
  { titulo: 'Migrar lo que ya tenés', desc: 'Excel, otro software, contactos en el teléfono. Lo traemos sin una migración masiva.', icono: 'flecha' },
  { titulo: 'Automatizaciones', desc: 'Avisos, menús de WhatsApp, flujos al cambiar un estado. Menos trabajo repetido.', icono: 'rayo' },
  { titulo: 'Consultoría técnica', desc: 'Arquitectura, herramientas y el recorte justo: qué conviene hacer ahora y qué después.', icono: 'ia' },
];

const PASOS = [
  { num: '01', titulo: 'Contanos el software', desc: 'Puede ser Flux, un producto Salix o una herramienta que ya uses. WhatsApp, mail o el formulario de abajo.' },
  { num: '02', titulo: 'Elegís las sesiones', desc: 'Cada una dura 45 minutos. Primera US$ 70. Cada extra US$ 50. Hasta 10. La tarjeta de al lado se actualiza al sumar.' },
  { num: '03', titulo: 'Coordinamos y lo dejamos andando', desc: 'Si es Flux, también podés pagar directo en flux.salixweb.com/planes. Si no, te pasamos el link y agendamos.' },
];

const FAQ = [
  { q: '¿Sirve para cualquier software?', a: 'Sí. Configuramos productos Salix (Flux, Sites, Go, Play, Book) y también conectamos lo que ya tengas: WhatsApp, Mercado Pago, planillas, APIs. No hace falta que sea nuestro.' },
  { q: '¿Cuánto dura cada sesión?', a: '45 minutos de trabajo enfocado. No es una hora corrida ni una demo: es implementación.' },
  { q: '¿Cuánto sale?', a: 'Primera sesión US$ 70. Cada extra US$ 50. Se cobra en pesos al cambio del día. Hasta 10 sesiones por pedido.' },
  { q: '¿Está incluido en la suscripción de Flux?', a: 'No. La prueba y el plan son el producto. Esto es configuración a demanda, aparte.' },
  { q: '¿Cómo se paga?', a: 'Si es implementación de Flux, pagás en flux.salixweb.com/planes. Para el resto, pedís las sesiones acá y te pasamos el link.' },
];
---

<Plantilla
  titulo="Integraciones — Te lo dejamos andando"
  descripcion="Sesiones de 45 minutos para configurar, conectar o implementar cualquier software. Primera US$ 70. Cada extra US$ 50. Flux, Sites o lo que ya uses."
  keywords="implementacion software, configuracion WhatsApp, MercadoPago, consultoria tecnica Argentina, onboarding Flux, integracion sistemas"
>
  <Nav />
  <main>

    <section class="servicio-hero">
      <div class="servicio-hero-inner">
        <div class="hero-badge aparecer">
          <span class="punto-pulso"></span>
          Sesiones de 45 min
        </div>
        <h1 class="servicio-titulo aparecer delay-1">
          Te lo dejamos andando.<br />
          <span>En el software que uses.</span>
        </h1>
        <p class="servicio-sub aparecer delay-2">
          Configuramos Flux, Sites o lo que ya tengas. WhatsApp, Mercado Pago, una planilla, una API. No hace falta que sea nuestro.
        </p>
        <div class="servicio-ctas aparecer delay-3">
          <a href="#sesiones" class="boton boton-verde">
            Elegir sesiones
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/#productos" class="boton boton-secundario">Ver productos</a>
        </div>
      </div>
    </section>

    <section class="seccion">
      <div class="encabezado-seccion aparecer" style="text-align:center;align-items:center">
        <span class="etiqueta">Cómo funciona</span>
        <h2 class="titulo-seccion">Tres pasos. Sin letra chica.</h2>
      </div>
      <div class="pasos-grilla">
        {PASOS.map((p, i) => (
          <div class={`paso-card aparecer delay-${i + 1}`}>
            <span class="paso-numero">{p.num}</span>
            <h3 class="paso-titulo">{p.titulo}</h3>
            <p class="paso-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="seccion">
      <div class="encabezado-seccion aparecer" style="text-align:center;align-items:center">
        <span class="etiqueta">En qué</span>
        <h2 class="titulo-seccion">Cualquier sistema. El recorte justo.</h2>
      </div>
      <div class="servicios-grilla">
        {SERVICIOS.map((s, i) => (
          <div class={`card-servicio aparecer delay-${(i % 3) + 1}`}>
            <div class="icono-contenedor item-producto">
              <IconoSVG nombre={s.icono} tamaño={22} grosor={1.5} />
            </div>
            <h3 class="servicio-nombre">{s.titulo}</h3>
            <p class="servicio-texto">{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="fondo-puntos" id="sesiones">
      <div class="panel-interior">
        <section class="seccion">
          <div class="encabezado-seccion aparecer" style="text-align:center;align-items:center">
            <span class="etiqueta">Precios</span>
            <h2 class="titulo-seccion">Elegí las sesiones. <span style="color:var(--salix)">La tarjeta cambia.</span></h2>
            <p class="subtitulo" style="text-align:center">Primera US$ 70. Cada extra US$ 50. Hasta 10. Se cobra en pesos al cambio del día.</p>
          </div>
          <TarjetaSesiones
            marca="Salix"
            codigo="SLX"
            titulo="¿Necesitás que te configuremos el sistema?"
            texto="Cada sesión dura 45 minutos. Te ayudamos a cargar datos, conectar WhatsApp, permisos y los módulos que uses — en Flux o en otra herramienta. Primera sesión US$ 70. Cada extra US$ 50."
            ctaTexto="Pedir estas sesiones"
            ctaModo="contacto"
            nota="Si es implementación de Flux, también podés pagar directo en flux.salixweb.com/planes."
          />
        </section>
      </div>
    </div>

    <section class="seccion">
      <div class="encabezado-seccion aparecer" style="text-align:center;align-items:center">
        <span class="etiqueta">Preguntas</span>
        <h2 class="titulo-seccion">Antes de escribirnos.</h2>
      </div>
      <div class="faq-lista">
        {FAQ.map((item, i) => (
          <details class={`faq-item aparecer delay-${(i % 3) + 1}`}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="seccion" style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:1.25rem">
      <h2 class="titulo-seccion aparecer">Contanos qué hay que dejar andando.</h2>
      <p class="subtitulo aparecer delay-1" style="text-align:center">
        Flux, Sites o una herramienta que ya uses. Sin compromiso.
      </p>
    </section>

    <FormularioContacto productoPreseleccionado="Integraciones" />

  </main>
  <Footer />
</Plantilla>

<style>
  .servicio-hero {
    min-height: 78vh;
    display: flex; align-items: center; justify-content: center;
    padding: 120px 24px 72px;
    background: var(--gradiente-hero);
  }
  .servicio-hero-inner {
    max-width: 720px; text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 1rem;
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--card); border: 1px solid var(--borde);
    color: var(--texto-secundario); font-size: 13px; font-weight: 500;
    padding: 6px 16px; border-radius: 100px;
  }
  .punto-pulso {
    width: 6px; height: 6px; border-radius: 50%; background: var(--salix);
  }
  .servicio-titulo {
    font-size: clamp(2rem, 5vw, 3.15rem);
    font-weight: 600; line-height: 1.08; letter-spacing: -0.04em; color: var(--texto);
    max-width: 100%;
  }
  .servicio-titulo span {
    display: block;
    font-size: clamp(1.2rem, 2.8vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-top: 0.18em;
    color: color-mix(in srgb, var(--salix) 55%, var(--gris-titulo));
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    .servicio-titulo span { white-space: normal; }
  }
  .servicio-sub {
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    color: var(--texto-secundario); line-height: 1.7; max-width: 520px;
  }
  .servicio-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 0.25rem; }

  .encabezado-seccion {
    margin-bottom: 3rem;
    display: flex; flex-direction: column; gap: 0.75rem;
  }

  .pasos-grilla { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .paso-card {
    background: var(--card); border: 1px solid var(--borde);
    border-radius: var(--radio-card);
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex; flex-direction: column; gap: 0.75rem;
    transition: border-color var(--transicion), transform var(--transicion);
  }
  .paso-card:hover { border-color: var(--salix-borde); transform: translateY(-2px); }
  .paso-numero {
    font-size: 2rem; font-weight: 600; color: var(--salix);
    letter-spacing: -0.03em; line-height: 1;
  }
  .paso-titulo { font-size: 1.05rem; font-weight: 600; color: var(--texto); }
  .paso-desc { font-size: 0.85rem; color: var(--texto-secundario); line-height: 1.7; }

  .servicios-grilla { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .card-servicio {
    background: var(--card); border: 1px solid var(--borde);
    border-radius: var(--radio-card);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    display: flex; flex-direction: column; gap: 0.75rem;
    transition: border-color var(--transicion), transform var(--transicion);
  }
  .card-servicio:hover {
    border-color: var(--salix-borde); transform: translateY(-2px);
  }
  .card-servicio:hover :global(.icono-contenedor) { transform: scale(1.08) rotate(-4deg); }
  .servicio-nombre { font-size: 1rem; font-weight: 600; color: var(--texto); }
  .servicio-texto { font-size: 0.85rem; color: var(--texto-secundario); line-height: 1.7; }

  .faq-lista {
    max-width: 720px; margin: 0 auto;
    display: flex; flex-direction: column; gap: 8px;
  }
  .faq-item {
    background: var(--card); border: 1px solid var(--borde);
    border-radius: 14px; padding: 0 1.25rem;
  }
  .faq-item summary {
    cursor: pointer; list-style: none;
    font-size: 1rem; font-weight: 600; color: var(--texto);
    padding: 1.1rem 0;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p {
    font-size: 0.9rem; color: var(--texto-secundario); line-height: 1.7;
    padding: 0 0 1.15rem; margin: 0;
  }

  @media (max-width: 1024px) {
    .pasos-grilla { grid-template-columns: 1fr; }
    .servicios-grilla { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .servicios-grilla { grid-template-columns: 1fr; }
  }
</style>
