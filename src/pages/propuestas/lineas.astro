---
// Propuesta B · «Las líneas»: Salix como una red. Cada producto es una línea con su color que cuelga
// de la casa, como las ramas del isotipo; donde dos líneas comparten algo hay una combinación; lo que
// viene son líneas en obra. Al bajar, cada línea sigue por el costado de su tramo, con sus estaciones.
import Propuesta from '../../layouts/Propuesta.astro';
import LogoFlux from '../../components/LogoFlux.astro';
import LogoMenu from '../../components/LogoMenu.astro';
import { ENTRADAS, SITIOS, CORREO } from '../../propuestas/datos';

const hechos = ENTRADAS.filter((e) => !e.viene);
const vienen = ENTRADAS.filter((e) => e.viene);
// Hasta dónde baja cada línea en el plano de arriba (en % del alto): el perfil de la copa del isotipo.
const LARGO: Record<string, number> = { flux: 80, menu: 94, nuvix: 72, sites: 86, integraciones: 62, go: 50, play: 41, book: 31 };
---

<Propuesta titulo="Salix · Propuesta B · Las líneas" tema="oscuro" fondo="#0f1013">
  <header class="tope">
    <a class="marca" href="#arriba" aria-label="Salix, arriba">
      <span class="isotipo" aria-hidden="true"></span>
      <span>Salix</span>
    </a>
    <nav class="tope-nav" aria-label="Líneas">
      {hechos.map((e) => <a href={`#${e.id}`} style={`--c:var(--${e.id})`}><i aria-hidden="true"></i>{e.nombre}</a>)}
    </nav>
    <a class="boton" href={`mailto:${CORREO}`}>Escribinos</a>
  </header>

  <main id="arriba">
    <section class="abre">
      <div class="abre-texto">
        <h1>Una casa.<br />Varias líneas.</h1>
        <p>
          Salix hace software en Buenos Aires. Cada producto es una línea con su nombre, su color y
          su propia web. Algunas ya andan, otras están en obra, y todas salen de la misma casa.
        </p>
      </div>

      <!-- El plano: las líneas cuelgan de la barra de la casa. Es un diagrama, no una decoración:
           cada línea lleva a su tramo, y las combinaciones dicen qué comparten. -->
      <div class="plano" role="group" aria-label="Las líneas de Salix">
        <div class="plano-casa" aria-hidden="true"></div>
        <div class="cruce cruce--ia"><span>Salix IA</span></div>
        <div class="cruce cruce--mp"><span>Mercado Pago</span></div>
        {ENTRADAS.map((e, i) => (
          <a
            class:list={['linea', { 'linea--obra': e.viene }]}
            href={e.viene ? '#obra' : `#${e.id}`}
            style={`--c:var(--${e.viene ? 'obra' : e.id});--largo:${LARGO[e.id]}%;--i:${i}`}
          >
            <span class="linea-via" aria-hidden="true"></span>
            <span class="linea-fin">
              <span class="linea-punto" aria-hidden="true"></span>
              <strong>{e.nombre}</strong>
              <span>{e.viene ? 'En obra' : e.que}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    {hechos.map((e) => (
      <section class="tramo" id={e.id} style={`--c:var(--${e.id})`}>
        <div class="tramo-riel" aria-hidden="true"></div>
        <div class="tramo-cuerpo">
          <p class="tramo-nombre">
            <span class="tramo-ficha">
              {e.id === 'flux' && <LogoFlux tamaño={22} />}
              {e.id === 'menu' && <LogoMenu tamaño={22} />}
              {e.id === 'nuvix' && <span class="logo-nuvix"></span>}
              {(e.id === 'sites' || e.id === 'integraciones') && <span class="isotipo"></span>}
            </span>
            Línea {e.nombre}
            <span class="tramo-estado">{e.estado}</span>
          </p>
          <h2>{e.frase}</h2>
          <ol class="estaciones">
            {e.hechos.map((h) => <li>{h}</li>)}
          </ol>
          {e.id === 'flux' && (
            <figure class="vista vista--ancha">
              <img src="/propuestas/flux-mac-oscuro.webp" width="1512" height="993" loading="lazy" decoding="async" alt="La bandeja de mensajes de Flux, con las conversaciones de WhatsApp de una empresa de muestra." />
            </figure>
          )}
          {e.id === 'menu' && (
            <figure class="vista vista--duo">
              <img src="/propuestas/menu-clasica.webp" width="600" height="1304" loading="lazy" decoding="async" alt="Una carta de Menu en su versión clásica, en un teléfono." />
              <img src="/propuestas/menu-visual.webp" width="600" height="1304" loading="lazy" decoding="async" alt="La misma carta en su versión visual." />
            </figure>
          )}
          {e.id === 'nuvix' && (
            <figure class="vista vista--duo">
              <img src="/propuestas/nuvix-dia.webp" width="660" height="1434" loading="lazy" decoding="async" alt="La pantalla del día en Nuvix." />
              <img src="/propuestas/nuvix-aplicacion.webp" width="660" height="1434" loading="lazy" decoding="async" alt="La pantalla de Nuvix que muestra dónde sigue la próxima aplicación." />
            </figure>
          )}
          {e.id === 'sites' && (
            <ul class="sitios">
              {SITIOS.map((s) => (
                <li>
                  <a href={`https://${s.dominio}`} rel="noopener">
                    <img src={`/propuestas/${s.archivo}`} width="1440" height="900" loading="lazy" decoding="async" alt={`Portada de ${s.dominio}`} />
                    <strong>{s.dominio}</strong>
                    <span>{s.que}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
          <a class="combinacion" href={e.id === 'sites' ? `mailto:${CORREO}?subject=Sitio%20web` : e.url}>
            <span class="combinacion-punto" aria-hidden="true"></span>
            {e.id === 'sites' ? 'Pedir un sitio' : e.id === 'integraciones' ? 'Ver las sesiones' : `Seguir en ${e.dominio}`}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    ))}

    <section class="tramo tramo--obra" id="obra" style="--c:var(--obra)">
      <div class="tramo-riel" aria-hidden="true"></div>
      <div class="tramo-cuerpo">
        <h2>Líneas en obra.</h2>
        <p class="obra-bajada">Todavía no llevan pasajeros. Cuando abran, van a estar en este plano.</p>
        <ul class="obra-lista">
          {vienen.map((e) => (
            <li><strong>{e.nombre}</strong><span>{e.que}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="cierre">
      <h2>¿No sabés qué línea tomar? Contanos adónde querés llegar.</h2>
      <a class="boton boton--grande" href={`mailto:${CORREO}`}>{CORREO}</a>
    </section>
  </main>

  <footer class="pie">
    <span class="marca"><span class="isotipo" aria-hidden="true"></span> Salix</span>
    <span>Software And Logic for eXcellence · Buenos Aires, Argentina</span>
    <a href="/propuestas/">Volver a las propuestas</a>
  </footer>
</Propuesta>

<style>
  :global(body) {
    --fondo: #0f1013;
    --fondo-2: #17181d;
    --esmalte: #f4f1ea;
    --tenue: #a6a39b;
    --linea-fina: #2a2c33;
    --cobre: #e8922a;
    --flux: #7b7bf0;
    --menu: #9bb88f;
    --nuvix: #2fb5a6;
    --sites: #e8922a;
    --integraciones: #f4f1ea;
    --obra: #6b6e78;
    --via: 0.75rem;
    --margen: clamp(1.25rem, 4.5vw, 5rem);
    background: var(--fondo);
    color: var(--esmalte);
  }
  :global(::selection) { background: var(--cobre); color: #1c1206; }
  :global(:focus-visible) { outline: 3px solid var(--cobre); outline-offset: 4px; border-radius: 4px; }

  .isotipo, .logo-nuvix {
    display: inline-block;
    inline-size: 1.5em;
    block-size: 1.5em;
    background: currentColor;
    -webkit-mask: url('/logo-salix.svg') center / contain no-repeat;
    mask: url('/logo-salix.svg') center / contain no-repeat;
    flex: none;
  }
  .logo-nuvix { -webkit-mask-image: url('/propuestas/nuvix-isotipo.svg'); mask-image: url('/propuestas/nuvix-isotipo.svg'); }

  .tope {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.875rem max(var(--margen), env(safe-area-inset-right)) 0.875rem max(var(--margen), env(safe-area-inset-left));
    background: color-mix(in srgb, var(--fondo) 86%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--linea-fina);
  }
  .marca { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; font-stretch: 112%; font-size: 1.0625rem; text-decoration: none; }
  .tope-nav { display: none; gap: 1.5rem; margin-inline: auto; font-size: 0.9375rem; font-weight: 600; font-stretch: 92%; }
  .tope-nav a { display: inline-flex; align-items: center; gap: 0.5rem; padding-block: 0.5rem; text-decoration: none; }
  .tope-nav i { inline-size: 0.75rem; block-size: 0.75rem; border-radius: 50%; background: var(--c); }
  .tope .boton { margin-inline-start: auto; }
  @media (min-width: 58rem) {
    .tope-nav { display: flex; }
    .tope .boton { margin-inline-start: 0; }
  }
  .boton {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 999px;
    background: var(--esmalte);
    color: var(--fondo);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .boton--grande { min-block-size: 3.5rem; padding-inline: 1.75rem; font-size: 1.125rem; }

  /* ── Abre: el título y el plano ── */
  .abre {
    display: grid;
    gap: clamp(2rem, 5svh, 3.5rem);
    padding: clamp(2rem, 7svh, 5rem) var(--margen) clamp(3rem, 8svh, 6rem);
    max-inline-size: 104rem;
    margin-inline: auto;
  }
  h1 {
    font-size: clamp(2.75rem, 1rem + 8vw, 6rem);
    line-height: 0.94;
    font-weight: 800;
    font-stretch: 84%;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .abre-texto p {
    margin-top: 1.25rem;
    max-inline-size: 46ch;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.3125rem);
    color: var(--tenue);
    text-wrap: pretty;
  }
  @media (min-width: 70rem) {
    .abre { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: start; }
    .abre-texto { position: sticky; top: 6rem; }
  }

  .plano {
    position: relative;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    block-size: clamp(27rem, 70svh, 42rem);
    padding-top: var(--via);
  }
  /* La barra de la casa: de ella cuelgan todas. */
  .plano-casa {
    position: absolute;
    inset: 0 0 auto;
    block-size: var(--via);
    border-radius: 999px;
    background: var(--esmalte);
  }
  .linea {
    position: relative;
    display: block;
    text-decoration: none;
    min-inline-size: 0;
  }
  .linea-via {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: calc(50% - var(--via) / 2);
    inline-size: var(--via);
    block-size: var(--largo);
    border-radius: 0 0 999px 999px;
    background: var(--c);
    transform-origin: top;
  }
  .linea--obra .linea-via {
    background: repeating-linear-gradient(to bottom, var(--c) 0 0.75rem, transparent 0.75rem 1.25rem);
    border-radius: 0;
  }
  .linea-fin {
    position: absolute;
    inset-block-start: var(--largo);
    inset-inline: 0;
    display: grid;
    justify-items: center;
    gap: 0.125rem;
    padding-top: 0.25rem;
    text-align: center;
  }
  .linea-punto {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    margin-top: -1rem;
    border-radius: 50%;
    background: var(--fondo);
    border: 0.375rem solid var(--c);
    transition: scale 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .linea-fin strong { margin-top: 0.375rem; font-size: clamp(0.8125rem, 0.6rem + 0.5vw, 1.125rem); font-weight: 800; font-stretch: 84%; letter-spacing: 0.02em; text-transform: uppercase; }
  .linea-fin span:last-child { font-size: 0.75rem; color: var(--tenue); text-wrap: balance; max-inline-size: 9rem; }
  @media (hover: hover) { .linea:hover .linea-punto { scale: 1.25; } }
  /* Las combinaciones: lo que comparten las líneas que cruzan. */
  .cruce {
    position: absolute;
    z-index: 1;
    inset-inline-start: calc(100% / 16 - 1.125rem);
    block-size: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--esmalte);
    color: var(--fondo);
    font-size: 0.8125rem;
    font-weight: 800;
    font-stretch: 84%;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .cruce--ia { inset-block-start: 24%; inline-size: calc(100% / 8 * 2 + 2.25rem); }
  .cruce--mp { inset-block-start: 46%; inline-size: calc(100% / 8 * 1 + 2.25rem); }
  /* En el teléfono las columnas son angostas: el nombre va al costado de la línea, de arriba abajo. */
  @media (max-width: 47.99rem) {
    .plano { --via: 0.5625rem; block-size: clamp(25rem, 66svh, 34rem); }
    .linea-fin { justify-items: center; }
    .linea-fin strong { writing-mode: vertical-rl; margin-top: 0.5rem; font-size: 0.8125rem; }
    .linea-fin span:last-child { display: none; }
    .linea-punto { inline-size: 1.375rem; block-size: 1.375rem; margin-top: -0.75rem; border-width: 0.3125rem; }
    .cruce { block-size: 1.75rem; font-size: 0.625rem; inset-inline-start: calc(100% / 16 - 0.875rem); }
    .cruce--ia { inline-size: calc(100% / 8 * 2 + 1.75rem); }
    .cruce--mp { inline-size: calc(100% / 8 * 1 + 1.75rem); }
    .cruce--mp span { font-size: 0.5625rem; letter-spacing: 0; }
  }

  /* ── Los tramos: la línea sigue por el costado ── */
  .tramo {
    display: grid;
    grid-template-columns: var(--via) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    padding: 0 var(--margen);
    max-inline-size: 104rem;
    margin-inline: auto;
    scroll-margin-top: 4rem;
  }
  .tramo-riel { background: var(--c); border-radius: 999px; margin-block: clamp(2rem, 6svh, 4rem); }
  .tramo--obra .tramo-riel { background: repeating-linear-gradient(to bottom, var(--c) 0 0.75rem, transparent 0.75rem 1.25rem); border-radius: 0; }
  .tramo-cuerpo { padding-block: clamp(3rem, 9svh, 6.5rem); min-inline-size: 0; }
  .tramo-nombre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: 800;
    font-stretch: 84%;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c);
  }
  .tramo-ficha { display: grid; place-items: center; inline-size: 2.5rem; block-size: 2.5rem; border-radius: 50%; background: var(--c); color: var(--fondo); }
  .tramo-ficha :global(svg), .tramo-ficha .isotipo, .tramo-ficha .logo-nuvix { inline-size: 1.375rem; block-size: 1.375rem; }
  .tramo-estado { padding: 0.25rem 0.625rem; border-radius: 999px; border: 1.5px solid currentColor; font-size: 0.75rem; }
  .tramo h2, .cierre h2 {
    margin-top: 1.25rem;
    max-inline-size: 18ch;
    font-size: clamp(2rem, 1rem + 4vw, 4.5rem);
    line-height: 0.98;
    font-weight: 800;
    font-stretch: 88%;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  /* Las estaciones del tramo: un punto por cada cosa que se puede afirmar. */
  .estaciones { margin-top: 2rem; display: grid; max-inline-size: 38rem; }
  .estaciones li {
    position: relative;
    padding: 0.875rem 0 0.875rem 2rem;
    border-top: 1px solid var(--linea-fina);
    font-size: 1.0625rem;
    color: #dcd9d1;
    text-wrap: pretty;
  }
  .estaciones li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 1.25rem;
    inline-size: 0.875rem;
    block-size: 0.875rem;
    border-radius: 50%;
    border: 0.1875rem solid var(--c);
  }
  .vista { margin-top: 2.5rem; }
  .vista img { border-radius: 0.75rem; }
  .vista--ancha { max-inline-size: 62rem; }
  .vista--ancha img { border: 1px solid var(--linea-fina); }
  .vista--duo { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(0.75rem, 2vw, 1.5rem); max-inline-size: 30rem; }
  .vista--duo img { border-radius: 1.5rem; }
  .vista--duo img:last-child { margin-top: 2.5rem; }
  .sitios { margin-top: 2.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(0.75rem, 1.6vw, 1.25rem); max-inline-size: 62rem; }
  @media (min-width: 64rem) { .sitios { grid-template-columns: 1fr 1fr 1fr; } }
  .sitios a { display: grid; gap: 0.125rem; text-decoration: none; }
  .sitios img { border-radius: 0.5rem; margin-bottom: 0.5rem; border: 1px solid var(--linea-fina); }
  .sitios strong { font-size: 0.9375rem; font-weight: 700; }
  .sitios span { font-size: 0.8125rem; color: var(--tenue); }
  .combinacion {
    margin-top: 2.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-block-size: 2.75rem;
    font-weight: 700;
    font-size: 1.0625rem;
    text-decoration: underline;
    text-decoration-color: var(--c);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
  .combinacion-punto { inline-size: 1.25rem; block-size: 1.25rem; border-radius: 50%; background: var(--esmalte); border: 0.25rem solid var(--c); }
  .obra-bajada { margin-top: 1rem; max-inline-size: 44ch; color: var(--tenue); font-size: 1.0625rem; }
  .obra-lista { margin-top: 2rem; display: grid; gap: 0; max-inline-size: 38rem; }
  .obra-lista li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem; padding-block: 1rem; border-top: 1px dashed #4a4d57; }
  .obra-lista strong { font-size: 1.5rem; font-weight: 800; font-stretch: 84%; text-transform: uppercase; letter-spacing: 0.02em; }
  .obra-lista span { color: var(--tenue); }

  .cierre {
    display: grid;
    justify-items: start;
    gap: 2rem;
    padding: clamp(3.5rem, 10svh, 7rem) var(--margen) clamp(4rem, 12svh, 8rem);
    max-inline-size: 104rem;
    margin-inline: auto;
    border-top: 1px solid var(--linea-fina);
  }
  .cierre h2 { margin-top: 0; max-inline-size: 20ch; }
  .pie {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    padding: 1.5rem var(--margen) max(1.5rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--linea-fina);
    font-size: 0.875rem;
    color: var(--tenue);
  }
  .pie .marca { color: var(--esmalte); }
  .pie a { margin-inline-start: auto; }

  /* El momento de esta página: al abrir, las líneas bajan de la casa una tras otra. */
  @media (prefers-reduced-motion: no-preference) {
    .linea-via { animation: baja 0.9s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: calc(var(--i) * 70ms + 150ms); }
    .linea-fin { animation: asoma 0.5s ease-out both; animation-delay: calc(var(--i) * 70ms + 750ms); }
    .cruce { animation: asoma 0.5s ease-out both; animation-delay: 1.3s; }
  }
  @keyframes baja { from { transform: scaleY(0); } }
  @keyframes asoma { from { opacity: 0; } }
</style>
