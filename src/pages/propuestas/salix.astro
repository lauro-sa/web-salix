---
// Propuesta C · «La casa»: la web ES de Salix. La primera pantalla es solo la marca (el isotipo con
// sus ramas, el nombre y qué somos); los productos aparecen al bajar, con la estética de Salix, y el
// plano de líneas resume todo lo que cuelga de la casa. Usa la barra, el menú, el pie en cortina y el
// cierre que se acomoda de la familia. Claro y oscuro.
import Casa from '../../layouts/Casa.astro';
import Captura from '../../components/Captura.astro';
import LogoFlux from '../../components/LogoFlux.astro';
import LogoMenu from '../../components/LogoMenu.astro';
import ramas from '../../ramas-salix.json';
import { ENTRADAS, SITIOS, CORREO } from '../../propuestas/datos';

const productos = ENTRADAS.filter((e) => ['flux', 'menu', 'nuvix'].includes(e.id));
const vienen = ENTRADAS.filter((e) => e.viene);
const de = (id: string) => ENTRADAS.find((e) => e.id === id)!;
const sites = de('sites');
const integraciones = de('integraciones');
// Hasta dónde baja cada línea del plano, en % del alto.
const LARGO: Record<string, number> = { flux: 82, menu: 100, nuvix: 70, sites: 90, integraciones: 60, go: 48, play: 38, book: 28 };
const DESTINO: Record<string, string> = { sites: '#sitios', integraciones: '#integraciones' };
// Una frase de dos oraciones se parte como en las webs de los productos: la primera liviana, la
// segunda en tinta.
const partes = (frase: string) => {
  const corte = frase.indexOf('. ');
  return corte === -1 ? [null, frase] : [frase.slice(0, corte + 1), frase.slice(corte + 2)];
};
// Testimonios de clientes (los de la web anterior; el dueño confirmó que son reales).
const VOCES = [
  { texto: 'Desde que migramos a Flux la gestión del consorcio es otra cosa. Todo más ordenado, los presupuestos se hacen en minutos.', quien: 'Marcela Rodríguez', de: 'Administradora de consorcios' },
  { texto: 'Le pedimos la web a Salix y nos sorprendió la calidad. Rápida, moderna y en tiempo récord. Se nota que entienden el negocio.', quien: 'Juan Pablo Ferreira', de: 'Ferreira Inmobiliaria' },
  { texto: 'El soporte es excelente. No es un ticket y esperar días: te responden rápido y resuelven. Eso para nosotros vale mucho.', quien: 'Valentina López', de: 'LogiCenter SA' },
];
const { cx, cy, r } = ramas.copa;
---

<Casa
  titulo="Salix · Propuesta C · La casa"
  descripcion="Propuesta de portada para la web nueva de Salix."
  base=""
  inicio="#inicio"
  sinIndexar
>
  <!-- Primera pantalla: solo Salix. -->
  <section class="abre" id="inicio">
    <div class="abre-caja ancho">
      <svg class="copa" viewBox="0 0 24 24" role="img" aria-label="El isotipo de Salix: la copa de un sauce hecha de ramas verticales" style={`--curva-ramas:${ramas.curva}`}>
        <defs><clipPath id="copa-recorte"><circle cx={cx} cy={cy} r={r} /></clipPath></defs>
        <g clip-path="url(#copa-recorte)" fill="currentColor">
          {ramas.ramas.map((rama) => (
            <path class="rama" d={rama.d} style={`--desde:${rama.desde}px;--retraso:${rama.retraso}s;--duracion:${rama.duracion}s`} />
          ))}
        </g>
      </svg>
      <div class="abre-texto">
        <h1 class="abre-titulo">Salix. <span>Software que simplifica tu negocio.</span></h1>
        <p class="bajada">
          Somos una casa de software de Buenos Aires. Hacemos sistemas de gestión, apps y sitios web
          para negocios de verdad, y los dejamos andando.
        </p>
        <p class="lema" aria-label="Salix: Software And Logic for eXcellence">
          <span aria-hidden="true"><b>S</b>oftware <b>A</b>nd <b>L</b>og<b>i</b>c for e<b>X</b>cellence</span>
        </p>
      </div>
    </div>
    <a class="abre-baja" href="#casa">Conocé la casa <span aria-hidden="true">↓</span></a>
  </section>

  <!-- El plano: todo lo que cuelga de la casa, de un vistazo. -->
  <section class="tramo" id="casa">
    <div class="ancho">
      <div class="casa-texto">
        <h2 class="titulo"><span>Una casa.</span> Varias líneas.</h2>
        <p class="bajada">
          Cada cosa que hacemos es una línea con su nombre y su propia web. Algunas ya andan, otras
          están en obra, y todas salen de la misma casa. Donde dos se cruzan, comparten algo.
        </p>
      </div>
      <div class="plano" role="group" aria-label="Las líneas de Salix">
        <div class="plano-casa" aria-hidden="true"><span class="isotipo"></span> Salix</div>
        <div class="cruce cruce--ia"><span>Salix IA</span></div>
        <div class="cruce cruce--mp"><span>Mercado Pago</span></div>
        {ENTRADAS.map((e) => (
          <a
            class:list={['linea', { 'linea--obra': e.viene }]}
            href={e.viene ? '#viene' : DESTINO[e.id] ?? `#${e.id}`}
            style={`--c:var(--linea-${e.viene ? 'obra' : e.id});--largo:${LARGO[e.id]}%`}
          >
            <span class="linea-via" aria-hidden="true"></span>
            <span class="linea-fin">
              <span class="linea-punto" aria-hidden="true"></span>
              <strong>{e.nombre}</strong>
              <span>{e.viene ? 'En obra' : e.que}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Los productos, con la estética de Salix: cada uno pone su logo, su captura y su enlace. -->
  <div id="productos">
    {productos.map((e) => {
      const [liviana, tinta] = partes(e.frase);
      return (
        <section class="tramo" id={e.id} style={`--c:var(--linea-${e.id})`}>
          <div class="producto ancho">
            <div class="producto-texto">
              <p class="producto-nombre">
                <span class="producto-logo">
                  {e.id === 'flux' && <LogoFlux tamaño={20} />}
                  {e.id === 'menu' && <LogoMenu tamaño={20} />}
                  {e.id === 'nuvix' && <span class="logo-nuvix"></span>}
                </span>
                {e.nombre}
                <span class="producto-que">{e.que}</span>
              </p>
              <h2 class="titulo">{liviana && <span>{liviana}</span>} {tinta}</h2>
              <ul class="hechos">{e.hechos.map((h) => <li>{h}</li>)}</ul>
              <a class="enlace" href={e.url}>{e.dominio} <span aria-hidden="true">→</span></a>
            </div>
            <figure class:list={['mesa', { 'mesa--duo': e.id !== 'flux' }]}>
              {e.id === 'flux' && (
                <Captura src="/propuestas/flux-mac.webp" oscura="/propuestas/flux-mac-oscuro.webp" ancho={1512} alto={993} alt="La bandeja de mensajes de Flux, con las conversaciones de WhatsApp de una empresa de muestra." />
              )}
              {e.id === 'menu' && (
                <>
                  <Captura src="/propuestas/menu-clasica.webp" ancho={600} alto={1304} alt="Una carta de Menu en su versión clásica, en un teléfono." />
                  <Captura clase="baja" src="/propuestas/menu-visual.webp" ancho={600} alto={1304} alt="La misma carta en su versión visual." />
                </>
              )}
              {e.id === 'nuvix' && (
                <>
                  <Captura src="/propuestas/nuvix-dia.webp" oscura="/propuestas/nuvix-dia-oscuro.webp" ancho={660} alto={1434} alt="La pantalla del día en Nuvix." />
                  <Captura clase="baja" src="/propuestas/nuvix-aplicacion.webp" oscura="/propuestas/nuvix-aplicacion-oscuro.webp" ancho={660} alto={1434} alt="La pantalla de Nuvix que muestra dónde sigue la próxima aplicación." />
                </>
              )}
            </figure>
          </div>
        </section>
      );
    })}
  </div>

  <section class="tramo" id="sitios">
    <div class="ancho">
      <div class="sitios-texto">
        <h2 class="titulo"><span>Sitios web,</span> hechos por nosotros.</h2>
        <div>
          <p class="bajada">{sites.hechos[0]} {sites.hechos[1]} Estos son algunos de los que hicimos, incluidos los de nuestros productos.</p>
          <a class="enlace" href={`mailto:${CORREO}?subject=Sitio%20web`}>Pedir un sitio <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ul class="sitios-fila">
        {SITIOS.map((s) => (
          <li>
            <a href={`https://${s.dominio}`} rel="noopener">
              <span class="sitio-marco">
                <Captura src={`/propuestas/${s.archivo}`} oscura={s.oscura && `/propuestas/${s.oscura}`} ancho={1440} alto={900} alt={`Portada de ${s.dominio}`} />
              </span>
              <strong>{s.dominio}</strong>
              <span>{s.que}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="tramo">
    <div class="mas ancho">
      <div id="integraciones">
        <h2 class="titulo"><span>{integraciones.nombre}.</span> {integraciones.frase}</h2>
        <ul class="hechos">{integraciones.hechos.map((h) => <li>{h}</li>)}</ul>
        <a class="enlace" href={integraciones.url}>Ver las sesiones <span aria-hidden="true">→</span></a>
      </div>
      <div id="viene">
        <h2 class="titulo"><span>Lo que viene.</span> En obra.</h2>
        <ul class="hechos hechos--obra">
          {vienen.map((e) => <li><strong>{e.nombre}</strong> {e.que}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="tramo" id="clientes">
    <div class="ancho">
      <h2 class="titulo"><span>Lo dicen</span> quienes ya trabajan con nosotros.</h2>
      <ul class="voces">
        {VOCES.map((v) => (
          <li>
            <blockquote>{v.texto}</blockquote>
            <p><strong>{v.quien}</strong> {v.de}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- El cierre: el último bloque, el que se acomoda entre la barra y el pie cuando la cortina lo destapa. -->
  <section class="cierre psx-cierre" id="contacto">
    <div class="cierre-caja psx-cierre-caja">
      <svg class="copa-chica psx-cierre-extra" viewBox="0 0 24 24" aria-hidden="true">
        <g clip-path="url(#copa-recorte)" fill="currentColor">
          {ramas.ramas.map((rama) => <path d={rama.d} />)}
        </g>
      </svg>
      <h2 class="titulo"><span>¿No sabés por dónde empezar?</span> Contanos qué tenés.</h2>
      <p class="bajada psx-cierre-extra">Escribinos y lo vemos juntos: te respondemos rápido.</p>
      <a class="boton" href={`mailto:${CORREO}`}>{CORREO}</a>
    </div>
  </section>
</Casa>

<style>
  .isotipo,
  .logo-nuvix {
    display: inline-block;
    inline-size: 1.25em;
    block-size: 1.25em;
    background: currentColor;
    -webkit-mask: url('/logo-salix.svg') center / contain no-repeat;
    mask: url('/logo-salix.svg') center / contain no-repeat;
    flex: none;
  }
  .logo-nuvix {
    -webkit-mask-image: url('/propuestas/nuvix-isotipo.svg');
    mask-image: url('/propuestas/nuvix-isotipo.svg');
  }

  /* ── Primera pantalla: solo Salix ── */
  .abre {
    position: relative;
    display: grid;
    align-content: center;
    min-block-size: min(100svh, 58rem);
    padding-block: calc(var(--psx-alto-barra, 4.5rem) + 2rem) 5rem;
  }
  .abre-caja {
    display: grid;
    gap: clamp(1.75rem, 5svh, 2.5rem);
  }
  .copa {
    inline-size: clamp(4.5rem, 20vw, 6rem);
    block-size: auto;
    color: var(--texto);
    overflow: visible;
  }
  .abre-titulo {
    font-size: clamp(2.125rem, 1.5rem + 2.3vw, 3.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .abre-titulo span {
    display: block;
    max-inline-size: 13em;
    font-weight: 350;
    color: var(--texto-terciario);
    text-wrap: balance;
  }
  .abre .bajada {
    margin-top: clamp(1.125rem, 3svh, 1.5rem);
  }
  .lema {
    margin-top: 1.5rem;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--texto-secundario);
  }
  .lema b {
    font-weight: 700;
    color: var(--salix);
  }
  .abre-baja {
    position: absolute;
    inset-block-end: 1.25rem;
    inset-inline-start: max(var(--margen), (100% - var(--ancho)) / 2);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-block-size: 2.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--texto-secundario);
  }
  @media (hover: hover) {
    .abre-baja:hover {
      color: var(--texto);
    }
  }
  /* Tableta, computadora y televisor: el texto a un lado y la copa al otro, sin gritar. */
  @media (min-width: 48rem) and (min-height: 30rem) {
    .abre-caja {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: clamp(2rem, 7vw, 6rem);
    }
    .copa {
      order: 2;
      inline-size: clamp(10rem, 21vw, 16rem);
    }
  }
  /* Teléfono acostado: poco alto. La copa va al costado, chica, y la pantalla no pide alto. */
  @media (max-height: 30rem) and (min-width: 34rem) {
    .abre {
      min-block-size: auto;
      padding-block: calc(var(--psx-alto-barra, 4.5rem) + 1rem) 2.5rem;
    }
    .abre-caja {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 2rem;
    }
    .copa {
      order: 2;
      inline-size: min(40svh, 8rem);
    }
    .abre-baja {
      display: none;
    }
  }

  /* El momento de la página: las ramas del sauce bajan, cada una a su tiempo. */
  @media (prefers-reduced-motion: no-preference) {
    .copa .rama {
      animation: rama-baja var(--duracion) var(--curva-ramas) var(--retraso) both;
    }
    .abre-texto,
    .abre-baja {
      animation: asoma 0.8s var(--curva) 0.35s both;
    }
  }
  @keyframes rama-baja {
    from {
      transform: translateY(var(--desde));
    }
  }
  @keyframes asoma {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  /* ── La casa: el plano ── */
  .casa-texto,
  .sitios-texto {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 56rem) {
    .casa-texto,
    .sitios-texto {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 6vw, 5rem);
      align-items: end;
    }
  }
  .plano {
    --via: 0.3125rem;
    --pastilla: 1.625rem;
    --etiqueta: 3.5rem;
    position: relative;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    block-size: clamp(21rem, 54svh, 27rem);
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.875rem;
  }
  .plano-casa {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.4375rem;
    block-size: 1.875rem;
    padding-inline: 0.75rem;
    border-radius: 999px;
    background: var(--texto);
    color: var(--fondo);
    font-size: 0.8125rem;
    font-weight: 650;
  }
  /* Cada línea ocupa el alto del plano menos el lugar de su nombre, que cuelga del final. */
  .linea {
    position: relative;
    display: block;
    align-self: start;
    min-inline-size: 0;
    block-size: calc(100% - var(--etiqueta));
  }
  .linea-via {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: calc(50% - var(--via) / 2);
    inline-size: var(--via);
    block-size: var(--largo);
    border-radius: 0 0 999px 999px;
    background: var(--c);
    transform-origin: top;
  }
  .linea--obra .linea-via {
    background: repeating-linear-gradient(to bottom, var(--c) 0 0.375rem, transparent 0.375rem 0.75rem);
    border-radius: 0;
  }
  .linea-fin {
    position: absolute;
    inset-block-start: var(--largo);
    inset-inline: 0;
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .linea-punto {
    inline-size: 1rem;
    block-size: 1rem;
    margin-top: -0.5rem;
    border-radius: 50%;
    background: var(--fondo);
    border: 0.1875rem solid var(--c);
    transition: scale 0.3s var(--curva);
  }
  .linea-fin strong {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .linea-fin span:last-child {
    margin-top: 0.125rem;
    max-inline-size: 8rem;
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--texto-secundario);
    text-wrap: balance;
  }
  @media (hover: hover) {
    .linea:hover .linea-punto {
      scale: 1.35;
    }
  }
  /* Los cruces: lo que comparten dos o tres líneas. Van de la primera línea a la última que tocan. */
  .cruce {
    position: absolute;
    z-index: 1;
    inset-inline-start: calc(100% / 16 - var(--pastilla) / 2);
    block-size: var(--pastilla);
    display: flex;
    align-items: center;
    justify-content: center;
    /* Mide de línea a línea; si el nombre no entra (un teléfono angosto), se estira lo justo. */
    inline-size: max-content;
    padding-inline: 0.5rem;
    border-radius: 999px;
    background: var(--fondo);
    border: 1.5px solid var(--texto);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .cruce--ia {
    inset-block-start: 24%;
    min-inline-size: calc(100% / 8 * 2 + var(--pastilla));
  }
  .cruce--mp {
    inset-block-start: 42%;
    min-inline-size: calc(100% / 8 * 1 + var(--pastilla));
  }
  @media (max-width: 47.99rem) {
    .plano {
      --via: 0.25rem;
      --pastilla: 1.5rem;
      --etiqueta: 6.75rem;
      block-size: clamp(23rem, 62svh, 28rem);
    }
    .linea-fin strong {
      writing-mode: vertical-rl;
      font-size: 0.75rem;
    }
    .linea-fin span:last-child {
      display: none;
    }
    .linea-punto {
      inline-size: 0.875rem;
      block-size: 0.875rem;
      margin-top: -0.4375rem;
    }
    .cruce {
      font-size: 0.625rem;
    }
  }
  /* Las líneas bajan de la casa cuando el plano entra en pantalla, atadas al scroll. Un solo reloj
     para todo el plano: así bajan juntas y los nombres aparecen cuando ya llegaron. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .plano {
        view-timeline-name: --plano;
      }
      .linea-via {
        animation: linea-baja linear both;
        animation-timeline: --plano;
        animation-range: entry 10% entry 80%;
      }
      .linea-fin,
      .cruce {
        animation: asoma-quieto linear both;
        animation-timeline: --plano;
        animation-range: entry 70% entry 100%;
      }
    }
  }
  @keyframes linea-baja {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes asoma-quieto {
    from {
      opacity: 0;
    }
  }

  /* ── Productos, con la estética de Salix ── */
  .producto {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 56rem) {
    .producto {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
    #productos > :nth-child(even) .producto-texto {
      order: 2;
    }
  }
  .producto-nombre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    font-size: 1rem;
    font-weight: 650;
  }
  .producto-logo {
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: 0.625rem;
    background: var(--fondo-alt);
    color: var(--c);
    box-shadow: inset 0 0 0 1px var(--borde);
  }
  .producto-que {
    font-weight: 400;
    font-size: 0.875rem;
    color: var(--texto-secundario);
  }
  .producto .titulo {
    margin-top: 1.125rem;
    max-inline-size: 16ch;
  }
  .hechos {
    margin-top: 1.5rem;
    max-inline-size: 30rem;
  }
  .hechos li {
    padding-block: 0.75rem;
    border-top: 1px solid var(--borde);
    font-size: 0.9375rem;
    color: var(--texto-secundario);
    text-wrap: pretty;
  }
  .hechos li:last-child {
    border-bottom: 1px solid var(--borde);
  }
  .hechos--obra li strong {
    display: inline-block;
    min-inline-size: 4rem;
    font-weight: 600;
    color: var(--texto);
  }
  .hechos + .enlace,
  .sitios-texto .enlace {
    margin-top: 0.75rem;
  }
  /* La mesa: donde se apoya la captura. Un plano neutro de Salix, sin el color del producto. */
  .mesa {
    display: grid;
    place-items: center;
    padding: clamp(1rem, 3vw, 2.25rem);
    border-radius: 0.875rem;
    background: var(--fondo-alt);
    box-shadow: inset 0 0 0 1px var(--borde);
  }
  .mesa :global(img) {
    border-radius: 0.375rem;
  }
  .mesa--duo {
    grid-template-columns: repeat(2, minmax(0, 13.5rem));
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }
