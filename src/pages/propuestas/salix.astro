---
// Propuesta C · «La casa»: la web ES de Salix. La primera pantalla es solo la marca (el isotipo con
// sus ramas, el nombre y qué somos). Después, el plano de líneas se dibuja con el scroll: todo lo que
// cuelga de la casa. Las líneas de los productos siguen bajando por el costado hasta la parada de
// cada uno. Usa la barra, el menú, el pie en cortina y el cierre que se acomoda de la familia.
// El movimiento vive en src/scripts/casa.ts.
import Casa from '../../layouts/Casa.astro';
import Captura from '../../components/Captura.astro';
import FormularioContacto from '../../components/FormularioContacto.astro';
import LogoFlux from '../../components/LogoFlux.astro';
import LogoMenu from '../../components/LogoMenu.astro';
import ramas from '../../ramas-salix.json';
import { ENTRADAS, SITIOS, CORREO } from '../../propuestas/datos';

const productos = ENTRADAS.filter((e) => ['flux', 'menu', 'nuvix'].includes(e.id));
const vienen = ENTRADAS.filter((e) => e.viene);
const de = (id: string) => ENTRADAS.find((e) => e.id === id)!;
const sites = de('sites');
const integraciones = de('integraciones');

// El plano. `largo`: hasta dónde baja cada línea (% del alto). `de` y `tramo`: en qué parte del
// recorrido de la escena se dibuja (de 0 a 1), para que entren por tandas: productos, servicios,
// lo que comparten y lo que está en obra.
const PLANO: Record<string, { largo: number; de: number; tramo: number }> = {
  flux: { largo: 82, de: 0.06, tramo: 0.2 },
  menu: { largo: 100, de: 0.12, tramo: 0.22 },
  nuvix: { largo: 70, de: 0.18, tramo: 0.18 },
  sites: { largo: 90, de: 0.38, tramo: 0.18 },
  integraciones: { largo: 60, de: 0.44, tramo: 0.14 },
  go: { largo: 48, de: 0.78, tramo: 0.12 },
  play: { largo: 38, de: 0.82, tramo: 0.1 },
  book: { largo: 28, de: 0.86, tramo: 0.1 },
};
const FASES = [
  { nombre: 'Productos', de: 0.06, tramo: 0.3 },
  { nombre: 'Servicios', de: 0.38, tramo: 0.2 },
  { nombre: 'En común', de: 0.6, tramo: 0.16 },
  { nombre: 'En obra', de: 0.78, tramo: 0.18 },
];
const DESTINO: Record<string, string> = { sites: '#sitios', integraciones: '#integraciones' };

// Las capturas de cada producto, agrupadas en vistas que se eligen con los rótulos de abajo. Una vista
// lleva una captura o dos teléfonos lado a lado. Todas son capturas reales.
interface Toma { src: string; oscura?: string; ancho: number; alto: number; alt: string }
interface Vista { rotulo: string; forma: 'ancha' | 'tel'; tomas: Toma[] }
const P = '/propuestas';
const tel = (archivo: string, alt: string, conOscura = false, ancho = 660, alto = 1434): Toma => ({
  src: `${P}/${archivo}.webp`,
  oscura: conOscura ? `${P}/${archivo}-oscuro.webp` : undefined,
  ancho,
  alto,
  alt,
});
const VISTAS: Record<string, Vista[]> = {
  flux: [
    { rotulo: 'En la computadora', forma: 'ancha', tomas: [{ src: `${P}/flux-mac.webp`, oscura: `${P}/flux-mac-oscuro.webp`, ancho: 1512, alto: 993, alt: 'La bandeja de mensajes de Flux, con las conversaciones de WhatsApp de una empresa de muestra.' }] },
    { rotulo: 'En el teléfono', forma: 'tel', tomas: [tel('flux-tel', 'El inicio de Flux en el teléfono, con lo que hay para hoy.')] },
  ],
  menu: [
    {
      rotulo: 'La carta',
      forma: 'tel',
      tomas: [
        tel('menu-clasica', 'Una carta de Menu en su versión clásica, en un teléfono.', false, 600, 1304),
        tel('menu-visual', 'La misma carta en su versión visual.', false, 600, 1304),
      ],
    },
    { rotulo: 'El panel', forma: 'ancha', tomas: [{ src: `${P}/menu-panel.webp`, ancho: 1600, alto: 1000, alt: 'El panel de Menu, donde se arma la carta.' }] },
  ],
  nuvix: [
    {
      rotulo: 'El día',
      forma: 'tel',
      tomas: [
        tel('nuvix-dia', 'La pantalla del día en Nuvix.', true),
        tel('nuvix-aplicacion', 'La pantalla de Nuvix que muestra dónde sigue la próxima aplicación.', true),
      ],
    },
    {
      rotulo: 'La historia',
      forma: 'tel',
      tomas: [
        tel('nuvix-historia', 'La historia en Nuvix: lo anotado día por día.', true),
        tel('nuvix-diario', 'El diario de Nuvix: proteínas, agua y cómo se siente la persona.', true),
      ],
    },
  ],
};

// Una frase de dos oraciones se parte como en las webs de los productos: la primera liviana, la
// segunda en tinta.
const partes = (frase: string) => {
  const corte = frase.indexOf('. ');
  return corte === -1 ? [null, frase] : [frase.slice(0, corte + 1), frase.slice(corte + 2)];
};
// Testimonios de clientes (los de la web anterior; el dueño confirmó que son reales).
const VOCES = [
  { texto: 'Desde que migramos a Flux la gestión del consorcio es otra cosa. Todo más ordenado, los presupuestos se hacen en minutos.', quien: 'Marcela Rodríguez', de: 'Administradora de consorcios' },
  { texto: 'Le pedimos la web a Salix y nos sorprendió la calidad. Rápida, moderna y en tiempo récord. Se nota que entienden el negocio.', quien: 'Juan Pablo Ferreira', de: 'Ferreira Inmobiliaria' },
  { texto: 'El soporte es excelente. No es un ticket y esperar días: te responden rápido y resuelven. Eso para nosotros vale mucho.', quien: 'Valentina López', de: 'LogiCenter SA' },
];
const { cx, cy, r } = ramas.copa;
---

<Casa
  titulo="Salix · Propuesta C · La casa"
  descripcion="Propuesta de portada para la web nueva de Salix."
  base=""
  inicio="#inicio"
  sinIndexar
>
  <!-- Primera pantalla: solo Salix. -->
  <section class="abre" id="inicio">
    <div class="abre-caja ancho">
      <svg class="copa" viewBox="0 0 24 24" role="img" aria-label="El isotipo de Salix: la copa de un sauce hecha de ramas verticales" style={`--curva-ramas:${ramas.curva}`}>
        <defs><clipPath id="copa-recorte"><circle cx={cx} cy={cy} r={r} /></clipPath></defs>
        <g clip-path="url(#copa-recorte)" fill="currentColor">
          {ramas.ramas.map((rama, i) => (
            <path class="rama" d={rama.d} style={`--desde:${rama.desde}px;--retraso:${rama.retraso}s;--duracion:${rama.duracion}s;--i:${i}`} />
          ))}
        </g>
      </svg>
      <div class="abre-texto">
        <h1 class="abre-titulo">Salix. <span>Software que simplifica tu negocio.</span></h1>
        <p class="bajada">
          Somos una casa de software de Buenos Aires. Hacemos sistemas de gestión, apps y sitios web
          para negocios de verdad, y los dejamos andando.
        </p>
        <p class="lema" aria-label="Salix: Software And Logic for eXcellence">
          <span aria-hidden="true"><b>S</b>oftware <b>A</b>nd <b>L</b>og<b>i</b>c for e<b>X</b>cellence</span>
        </p>
      </div>
    </div>
    <a class="abre-baja" href="#casa">Conocé la casa <span aria-hidden="true">↓</span></a>
  </section>

  <!-- El plano: todo lo que cuelga de la casa. La escena queda quieta mientras se baja y el plano
       se va dibujando: la casa, los productos, los servicios, lo que comparten y lo que viene. -->
  <section class="escena" id="casa" data-escena>
    <div class="escena-fija" data-escena-fija>
      <div class="ancho">
        <div class="casa-texto">
          <h2 class="titulo"><span>Una casa.</span> Varias líneas.</h2>
          <p class="bajada">
            Cada cosa que hacemos es una línea con su nombre y su propia web. Algunas ya andan, otras
            están en obra, y todas salen de la misma casa. Donde dos se cruzan, comparten algo.
          </p>
        </div>
        <div class="plano" role="group" aria-label="Las líneas de Salix" data-plano>
          <div class="plano-casa" aria-hidden="true"><span class="isotipo"></span> Salix</div>
          <div class="cruce cruce--ia" style="--de:0.6;--tramo:0.1"><span>Salix IA</span></div>
          <div class="cruce cruce--mp" style="--de:0.66;--tramo:0.1"><span>Mercado Pago</span></div>
          {ENTRADAS.map((e, i) => (
            <a
              class:list={['linea', { 'linea--obra': e.viene }]}
              href={e.viene ? '#viene' : DESTINO[e.id] ?? `#${e.id}`}
              style={`--c:var(--linea-${e.viene ? 'obra' : e.id});--largo:${PLANO[e.id].largo}%;--de:${PLANO[e.id].de};--tramo:${PLANO[e.id].tramo};--i:${i}`}
            >
              <span class="linea-via" aria-hidden="true"></span>
              <span class="linea-carro">
                <span class="linea-fin">
                  <span class="linea-punto" aria-hidden="true"></span>
                  <strong>{e.nombre}</strong>
                  <span>{e.viene ? 'En obra' : e.que}</span>
                </span>
              </span>
            </a>
          ))}
        </div>
        <ol class="fases" aria-hidden="true">
          {FASES.map((f) => <li style={`--de:${f.de};--tramo:${f.tramo}`}><span>{f.nombre}</span></li>)}
        </ol>
      </div>
    </div>
  </section>

  <!-- Los productos, con la estética de Salix. Por el costado siguen bajando sus líneas: cada una
       termina en la parada de su producto. -->
  <div id="productos">
    {productos.map((e, k) => {
      const [liviana, tinta] = partes(e.frase);
      const vistas = VISTAS[e.id];
      return (
        <section class="tramo producto-tramo" id={e.id} style={`--c:var(--linea-${e.id});--x:${k}`} data-riel>
          <div class="riel" aria-hidden="true">
            {productos.slice(k).map((otro, j) => (
              <span class:list={['riel-linea', { 'riel-linea--fin': j === 0 }]} style={`--c:var(--linea-${otro.id});--x:${k + j}`}></span>
            ))}
            <span class="riel-punto" data-parada></span>
          </div>
          <div class="producto ancho">
            <div class="producto-texto">
              <p class="producto-nombre">
                <span class="producto-logo">
                  {e.id === 'flux' && <LogoFlux tamaño={20} />}
                  {e.id === 'menu' && <LogoMenu tamaño={20} />}
                  {e.id === 'nuvix' && <span class="logo-nuvix"></span>}
                </span>
                {e.nombre}
                <span class="producto-que">{e.que}</span>
                <span class:list={['estado', { 'estado--vivo': e.estado === 'En uso' }]}>{e.estado}</span>
              </p>
              <h2 class="titulo" data-asoma>{liviana && <span>{liviana}</span>} {tinta}</h2>
              <ul class="hechos" data-asoma style="--i:1">{e.hechos.map((h) => <li>{h}</li>)}</ul>
              <a class="enlace" href={e.url}>{e.dominio} <span aria-hidden="true">→</span></a>
            </div>
            <figure class="mesa" data-vistas data-asoma style="--i:2">
              <div class="vistas">
                {vistas.map((v, i) => (
                  <div class:list={['vista', `vista--${v.forma}`, { 'vista--duo': v.tomas.length > 1 }]} data-vista data-pos={i} aria-hidden={i === 0 ? 'false' : 'true'}>
                    {v.tomas.map((toma) => (
                      <span class="toma"><Captura src={toma.src} oscura={toma.oscura} ancho={toma.ancho} alto={toma.alto} alt={toma.alt} /></span>
                    ))}
                  </div>
                ))}
              </div>
              <figcaption class="rotulos" role="tablist" aria-label={`Capturas de ${e.nombre}`}>
                {vistas.map((v, i) => (
                  <button type="button" role="tab" class="rotulo" data-rotulo aria-selected={i === 0 ? 'true' : 'false'}>{v.rotulo}</button>
                ))}
              </figcaption>
            </figure>
          </div>
        </section>
      );
    })}
  </div>

  <section class="tramo" id="sitios">
    <div class="ancho">
      <div class="sitios-texto" data-asoma>
        <h2 class="titulo"><span>Sitios web,</span> hechos por nosotros.</h2>
        <div>
          <p class="bajada">{sites.hechos[0]} {sites.hechos[1]} Estos son algunos de los que hicimos, incluidos los de nuestros productos.</p>
          <a class="enlace" href="#contacto">Pedir un sitio <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ul class="sitios-fila">
        {SITIOS.map((s, i) => (
          <li data-asoma style={`--i:${i % 3}`}>
            <a href={`https://${s.dominio}`} rel="noopener">
              <span class="ventana">
                <span class="ventana-barra" aria-hidden="true"><i></i><i></i><i></i><span>{s.dominio}</span></span>
                <span class="ventana-hoja">
                  <Captura src={`/propuestas/${s.archivo}`} oscura={s.oscura && `/propuestas/${s.oscura}`} ancho={1440} alto={900} alt={`Portada de ${s.dominio}`} />
                </span>
              </span>
              <strong>{s.dominio}</strong>
              <span>{s.que}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="tramo">
    <div class="mas ancho">
      <div id="integraciones" data-asoma>
        <h2 class="titulo"><span>{integraciones.nombre}.</span> {integraciones.frase}</h2>
        <ul class="hechos">{integraciones.hechos.map((h) => <li>{h}</li>)}</ul>
        <a class="enlace" href={integraciones.url}>Ver las sesiones <span aria-hidden="true">→</span></a>
      </div>
      <div id="viene" data-asoma style="--i:1">
        <h2 class="titulo"><span>Lo que viene.</span> En obra.</h2>
        <ul class="hechos hechos--obra">
          {vienen.map((e) => <li><strong>{e.nombre}</strong> {e.que}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="tramo" id="clientes">
    <div class="ancho">
      <h2 class="titulo" data-asoma><span>Lo dicen</span> quienes ya trabajan con nosotros.</h2>
      <ul class="voces">
        {VOCES.map((v, i) => (
          <li data-asoma style={`--i:${i}`}>
            <blockquote>{v.texto}</blockquote>
            <p><strong>{v.quien}</strong> {v.de}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="tramo" id="contacto">
    <div class="contacto ancho">
      <div class="contacto-texto" data-asoma>
        <h2 class="titulo"><span>Hablemos.</span> Contanos qué necesitás.</h2>
        <p class="bajada">Elegí qué te interesa, dejanos cómo ubicarte y te respondemos nosotros, por correo o por WhatsApp.</p>
        <a class="enlace" href={`mailto:${CORREO}`}>{CORREO} <span aria-hidden="true">→</span></a>
      </div>
      <div data-asoma style="--i:1">
        <FormularioContacto sinEncabezado id="formulario" />
      </div>
    </div>
  </section>

  <!-- El cierre: el último bloque, el que se acomoda entre la barra y el pie cuando la cortina lo destapa. -->
  <section class="cierre psx-cierre">
    <div class="cierre-caja psx-cierre-caja">
      <svg class="copa-chica psx-cierre-extra" viewBox="0 0 24 24" aria-hidden="true">
        <g clip-path="url(#copa-recorte)" fill="currentColor">
          {ramas.ramas.map((rama) => <path d={rama.d} />)}
        </g>
      </svg>
      <h2 class="titulo"><span>Salix.</span> Software que simplifica tu negocio.</h2>
      <p class="lema psx-cierre-extra" aria-hidden="true"><b>S</b>oftware <b>A</b>nd <b>L</b>og<b>i</b>c for e<b>X</b>cellence</p>
      <a class="boton" href="#contacto">Hablemos</a>
    </div>
  </section>
</Casa>

<style>
  .isotipo,
  .logo-nuvix {
    display: inline-block;
    inline-size: 1.25em;
    block-size: 1.25em;
    background: currentColor;
    -webkit-mask: url('/logo-salix.svg') center / contain no-repeat;
    mask: url('/logo-salix.svg') center / contain no-repeat;
    flex: none;
  }
  .logo-nuvix {
    -webkit-mask-image: url('/propuestas/nuvix-isotipo.svg');
    mask-image: url('/propuestas/nuvix-isotipo.svg');
  }

  /* ── Primera pantalla: solo Salix ── */
  .abre {
    position: relative;
    display: grid;
    align-content: center;
    min-block-size: min(100svh, 58rem);
    padding-block: calc(var(--psx-alto-barra, 4.5rem) + 2rem) 5rem;
  }
  .abre-caja {
    display: grid;
    gap: clamp(1.75rem, 5svh, 2.5rem);
  }
  .copa {
    inline-size: clamp(4.5rem, 20vw, 6rem);
    block-size: auto;
    color: var(--texto);
    overflow: visible;
  }
  .abre-titulo {
    font-size: clamp(2.125rem, 1.5rem + 2.3vw, 3.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .abre-titulo span {
    display: block;
    max-inline-size: 13em;
    font-weight: 350;
    color: var(--texto-terciario);
    text-wrap: balance;
  }
  .abre .bajada {
    margin-top: clamp(1.125rem, 3svh, 1.5rem);
  }
  .lema {
    margin-top: 1.5rem;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--texto-secundario);
  }
  .lema b {
    font-weight: 700;
    color: var(--salix);
  }
  .abre-baja {
    position: absolute;
    inset-block-end: 1.25rem;
    inset-inline-start: max(var(--margen), (100% - var(--ancho)) / 2);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-block-size: 2.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--texto-secundario);
  }
  @media (hover: hover) {
    .abre-baja:hover {
      color: var(--texto);
    }
  }
  /* Tableta, computadora y televisor: el texto a un lado y la copa al otro, sin gritar. */
  @media (min-width: 48rem) and (min-height: 30rem) {
    .abre-caja {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: clamp(2rem, 7vw, 6rem);
    }
    .copa {
      order: 2;
      inline-size: clamp(10rem, 21vw, 16rem);
    }
  }
  /* Teléfono acostado: poco alto. La copa va al costado, chica, y la pantalla no pide alto. */
  @media (max-height: 30rem) and (min-width: 34rem) {
    .abre {
      min-block-size: auto;
      padding-block: calc(var(--psx-alto-barra, 4.5rem) + 1rem) 2.5rem;
    }
    .abre-caja {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 2rem;
    }
    .copa {
      order: 2;
      inline-size: min(40svh, 8rem);
    }
    .abre-baja {
      display: none;
    }
  }

  /* El momento de la página: las ramas del sauce bajan, cada una a su tiempo, y después quedan
     meciéndose apenas, como al viento. La entrada usa `transform` y el vaivén `translate`: no se pisan. */
  @media (prefers-reduced-motion: no-preference) {
    .copa .rama {
      animation:
        rama-baja var(--duracion) var(--curva-ramas) var(--retraso) both,
        rama-mece 5.5s ease-in-out calc(1.8s + var(--i) * 0.37s) infinite alternate;
    }
    .abre-texto,
    .abre-baja {
      animation: asoma 0.8s var(--curva) 0.35s both;
    }
    .abre-baja span {
      animation: baja-flecha 1.8s ease-in-out 2s infinite;
    }
    /* Al seguir bajando, la primera pantalla se retira: se apaga y sube un poco más lento que la página. */
    @supports (animation-timeline: view()) {
      .abre-caja {
        animation: se-retira linear both;
        animation-timeline: view();
        animation-range: exit 10% exit 90%;
      }
    }
  }
  @keyframes rama-baja {
    from {
      transform: translateY(var(--desde));
    }
  }
  @keyframes rama-mece {
    from {
      translate: 0 -0.22px;
    }
    to {
      translate: 0 0.3px;
    }
  }
  @keyframes asoma {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }
  @keyframes baja-flecha {
    50% {
      translate: 0 0.25rem;
    }
  }
  @keyframes se-retira {
    to {
      opacity: 0;
      translate: 0 4rem;
      scale: 0.97;
    }
  }

  /* ── La casa: la escena del plano ── */
  .escena {
    /* `--p`: cuánto de la escena se recorrió (lo escribe casa.ts). Sin JavaScript vale 1 y el plano
       está entero. Lo leen el plano y las tandas de abajo. */
    --p: 1;
    border-top: 1px solid var(--borde-sutil);
  }
  .escena-fija {
    padding-block: var(--aire);
  }
  /* Con alto suficiente, la escena queda quieta mientras se baja y el plano se dibuja (casa.ts
     escribe `--p`). Solo con JavaScript y sin «reducir movimiento»: si no, es un tramo común. */
  @media (min-height: 37.5rem) and (prefers-reduced-motion: no-preference) {
    :global(.con-js) .escena {
      block-size: 215svh;
    }
    :global(.con-js) .escena-fija {
      position: sticky;
      inset-block-start: 0;
      display: grid;
      align-content: center;
      block-size: 100svh;
      padding-block: calc(var(--psx-alto-barra, 4.5rem) + 1.25rem) 1.5rem;
    }
    :global(.con-js) .escena .plano {
      block-size: clamp(16rem, 100svh - 27rem, 27rem);
    }
  }
  .casa-texto,
  .sitios-texto {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 56rem) {
    .casa-texto,
    .sitios-texto {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 6vw, 5rem);
