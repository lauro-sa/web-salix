---
// Tres primeras pantallas para la web nueva de Salix, una debajo de la otra, para elegir mirando.
// El texto es el mismo en las tres; cambia la pieza que lo acompaña.
//   A · La órbita    lo que hace la casa gira alrededor del isotipo (la geometría de la familia,
//                    la misma de la portada de Flux: nucleo/ui/entrada/geometria.ts del monorepo)
//   B · La vitrina   capturas reales de los tres productos, apoyadas una sobre otra
//   C · El estante   centrada: el isotipo, la frase y todo lo que hacemos como íconos en fila
import Casa from '../../layouts/Casa.astro';
import Captura from '../../components/Captura.astro';
import IconoProducto from '../../components/IconoProducto.astro';
import LogoSalixAnimado from '../../components/LogoSalixAnimado.astro';
import Orbita from '../../components/Orbita.astro';
import { COSAS } from '../../casa/cosas';

const ANDAN = COSAS.filter((c) => !c.obra);
const VIENEN = COSAS.filter((c) => c.obra);
const P = '/propuestas';
---

<Casa titulo="Salix · Primeras pantallas para elegir" descripcion="Tres primeras pantallas para la web nueva de Salix." base="/propuestas/salix/" inicio="/propuestas/salix/" sinIndexar>
  <!-- ═════════ A · La órbita ═════════ -->
  <p class="letra ancho"><b>A</b> La órbita</p>
  <section class="abre">
    <div class="abre-caja ancho">
      <div class="abre-texto">
        <h1 class="abre-nombre">Salix</h1>
        <p class="abre-frase">Software que simplifica. <span>Sistemas, apps y sitios web.</span></p>
        <p class="bajada">Somos una casa de software de Buenos Aires. Pensamos cada producto, lo hacemos y lo dejamos andando.</p>
        <div class="abre-acciones">
          <a class="boton" href="/propuestas/salix/#productos">Ver lo que hacemos</a>
          <a class="boton boton-secundario" href="/propuestas/salix/#contacto">Hablemos</a>
        </div>
      </div>
      <Orbita base="/propuestas/salix/" />
    </div>
  </section>

  <!-- ═════════ B · La vitrina ═════════ -->
  <p class="letra ancho"><b>B</b> La vitrina</p>
  <section class="abre">
    <div class="abre-caja abre-caja--vitrina ancho">
      <div class="abre-texto">
        <p class="abre-nombre">Salix</p>
        <p class="abre-frase">Software que simplifica. <span>Sistemas, apps y sitios web.</span></p>
        <p class="bajada">Somos una casa de software de Buenos Aires. Pensamos cada producto, lo hacemos y lo dejamos andando.</p>
        <div class="abre-acciones">
          <a class="boton" href="/propuestas/salix/#productos">Ver lo que hacemos</a>
          <a class="boton boton-secundario" href="/propuestas/salix/#contacto">Hablemos</a>
        </div>
      </div>
      <div class="vit">
        <a class="vit-pieza vit-ventana" href="/propuestas/salix/#flux" style="--c:var(--linea-flux)">
          <span class="vit-barra" aria-hidden="true"><i></i><i></i><i></i></span>
          <Captura src={`${P}/flux-mac.webp`} oscura={`${P}/flux-mac-oscuro.webp`} ancho={1512} alto={993} alt="Flux en la computadora: la bandeja de mensajes de una empresa de muestra." />
          <span class="vit-rotulo">Flux</span>
        </a>
        <a class="vit-pieza vit-tel vit-tel--menu" href="/propuestas/salix/#menu" style="--c:var(--linea-menu)">
          <Captura src={`${P}/menu-clasica.webp`} ancho={600} alto={1304} alt="Una carta de Menu en un teléfono." />
          <span class="vit-rotulo">Menu</span>
        </a>
        <a class="vit-pieza vit-tel vit-tel--nuvix" href="/propuestas/salix/#nuvix" style="--c:var(--linea-nuvix)">
          <Captura src={`${P}/nuvix-dia.webp`} oscura={`${P}/nuvix-dia-oscuro.webp`} ancho={660} alto={1434} alt="La pantalla del día en Nuvix." />
          <span class="vit-rotulo">Nuvix</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═════════ C · El estante ═════════ -->
  <p class="letra ancho"><b>C</b> El estante</p>
  <section class="abre abre--centro">
    <div class="centro ancho">
      <span class="centro-logo" aria-hidden="true"><LogoSalixAnimado id="copa-estante" /></span>
      <p class="abre-nombre">Salix</p>
      <p class="abre-frase">Software que simplifica. <span>Sistemas, apps y sitios web.</span></p>
      <ul class="estante" aria-label="Lo que hace Salix">
        {ANDAN.map((c, i) => (
          <li style={`--i:${i}`}>
            <a href={`/propuestas/salix/#${c.ancla}`} style={`--c:var(--linea-${c.id})`}>
              <span class="estante-icono"><IconoProducto nombre={c.icono} tamaño={26} /></span>
              <strong>{c.nombre}</strong>
              <span>{c.que}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="estante-viene">Lo que viene: {VIENEN.map((c) => c.nombre).join(' · ')}</p>
      <div class="abre-acciones">
        <a class="boton" href="/propuestas/salix/#productos">Ver lo que hacemos</a>
        <a class="boton boton-secundario" href="/propuestas/salix/#contacto">Hablemos</a>
      </div>
    </div>
  </section>

  <section class="vuelve psx-cierre">
    <div class="psx-cierre-caja ancho">
      <a class="enlace" href="/propuestas/salix/">Volver a la página entera <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Casa>

<style>
  .letra {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding-top: calc(var(--psx-alto-barra, 4.5rem) + 1rem);
    font-size: 0.875rem;
    color: var(--texto-secundario);
  }
  .letra b {
    display: grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border-radius: 50%;
    background: var(--salix);
    color: #1c1206;
    font-weight: 700;
  }
  .letra + .abre {
    border-bottom: 1px solid var(--borde);
  }

  /* ── Lo común a las tres ── */
  .abre {
    display: grid;
    align-content: center;
    min-block-size: min(100svh - var(--psx-alto-barra, 4.5rem) - 3rem, 52rem);
    padding-block: 2.5rem 3.5rem;
    overflow: clip;
  }
  .abre-caja {
    display: grid;
    gap: 2.75rem;
  }
  .abre-nombre {
    margin: 0;
    font-size: clamp(2.75rem, 2rem + 2.8vw, 4.25rem);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .abre-frase {
    margin-top: clamp(0.875rem, 2svh, 1.25rem);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }
  .abre-frase span {
    display: block;
    font-weight: 400;
    color: var(--texto-terciario);
  }
  .abre .bajada {
    margin-top: clamp(1rem, 2.5svh, 1.375rem);
    max-inline-size: 38ch;
  }
  .abre-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: clamp(1.5rem, 3.5svh, 2rem);
  }
  @media (min-width: 56rem) {
    .abre-caja {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: clamp(2rem, 6vw, 5rem);
    }
    .abre-caja--vitrina {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  /* ── B · La vitrina: capturas reales, una apoyada sobre la otra ── */
  .vit {
    position: relative;
    inline-size: 100%;
    max-inline-size: 40rem;
    justify-self: end;
    aspect-ratio: 1.42;
  }
  .vit-pieza {
    position: absolute;
    display: block;
    transition: translate 0.5s var(--curva);
  }
  .vit-pieza :global(img) {
    inline-size: 100%;
  }
  .vit-ventana {
    inset: 0 12% auto 0;
    overflow: hidden;
    border-radius: 0.625rem;
    background: var(--fondo-alt);
    box-shadow:
      0 0 0 1px var(--borde),
      0 1.5rem 3rem -1.5rem rgba(0, 0, 0, 0.45);
  }
  .vit-barra {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    block-size: 1.375rem;
    padding-inline: 0.625rem;
    border-bottom: 1px solid var(--borde);
  }
  .vit-barra i {
    inline-size: 0.375rem;
    block-size: 0.375rem;
    border-radius: 50%;
    background: var(--borde);
  }
  .vit-tel {
    inline-size: 23%;
  }
  .vit-tel :global(img) {
    border-radius: 1.125rem;
    box-shadow:
      0 0 0 1px var(--borde),
      0 1.5rem 2.5rem -1.25rem rgba(0, 0, 0, 0.5);
  }
  .vit-tel--menu {
    inset: auto 24% 0 auto;
  }
  .vit-tel--nuvix {
    inset: auto 0 5% auto;
  }
  .vit-rotulo {
    position: absolute;
    inset: auto auto 0.625rem 0.625rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.1875rem 0.625rem;
    border-radius: 999px;
    background: var(--fondo);
    box-shadow: inset 0 0 0 1px var(--borde);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .vit-rotulo::before {
    content: '';
    inline-size: 0.4375rem;
    block-size: 0.4375rem;
    border-radius: 50%;
    background: var(--c);
  }
  @media (hover: hover) {
    .vit-pieza:hover {
      translate: 0 -0.375rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .vit-pieza {
      animation: vit-entra 0.9s var(--curva) both;
    }
    .vit-tel--menu {
      animation-delay: 0.15s;
    }
    .vit-tel--nuvix {
      animation-delay: 0.3s;
    }
  }
  @keyframes vit-entra {
    from {
      opacity: 0;
      translate: 0 1.5rem;
    }
  }

  /* ── C · El estante: centrada ── */
  .centro {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .centro-logo {
    margin-bottom: 1.25rem;
  }
  .centro-logo :global(svg) {
    inline-size: 3.5rem;
    block-size: 3.5rem;
  }
  .estante {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 0.75rem;
    inline-size: 100%;
    max-inline-size: 46rem;
    margin-top: clamp(2rem, 5svh, 3rem);
  }
  @media (min-width: 40rem) {
    .estante {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .estante a {
    display: grid;
    justify-items: center;
    gap: 0.125rem;
    font-size: 0.75rem;
    color: var(--texto-secundario);
    text-wrap: balance;
  }
  .estante strong {
    margin-top: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--texto);
  }
  .estante-icono {
    display: grid;
    place-items: center;
    inline-size: 4rem;
    block-size: 4rem;
    border-radius: 1.125rem;
    background: var(--fondo-alt);
    color: var(--c);
    box-shadow:
      inset 0 0 0 1px var(--borde),
      0 0.875rem 1.5rem -1rem rgba(0, 0, 0, 0.4);
    transition:
      translate 0.4s var(--curva),
      box-shadow 0.4s var(--curva);
  }
  @media (hover: hover) {
    .estante a:hover .estante-icono {
      translate: 0 -0.3125rem;
      box-shadow:
        inset 0 0 0 1.5px var(--c),
        0 1.25rem 1.75rem -1rem rgba(0, 0, 0, 0.5);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .estante li {
      animation: vit-entra 0.7s var(--curva) calc(0.3s + var(--i) * 70ms) both;
    }
  }
  .estante-viene {
    margin-top: 1.5rem;
    font-size: 0.8125rem;
    color: var(--texto-terciario);
  }
  .abre--centro .abre-acciones {
    justify-content: center;
  }

  .vuelve {
    align-items: center;
    padding: 3rem var(--margen);
  }
</style>
