---
// Propuesta A · «La carta de colores»: cada producto es una muestra con su color, su nombre y su
// estado, como en la carta de colores de una pinturería. Las muestras son, además, las barras del
// isotipo de Salix. Abajo, cada producto ocupa un campo entero de su color.
import Propuesta from '../../layouts/Propuesta.astro';
import LogoFlux from '../../components/LogoFlux.astro';
import LogoMenu from '../../components/LogoMenu.astro';
import { ENTRADAS, SITIOS, CORREO } from '../../propuestas/datos';

const hechos = ENTRADAS.filter((e) => !e.viene);
const vienen = ENTRADAS.filter((e) => e.viene);
const de = (id: string) => ENTRADAS.find((e) => e.id === id)!;
const flux = de('flux');
const menu = de('menu');
const nuvix = de('nuvix');
const sites = de('sites');
const integraciones = de('integraciones');
---

<Propuesta titulo="Salix · Propuesta A · La carta de colores" tema="claro" fondo="#f3efe6">
  <header class="tope">
    <a class="marca" href="#arriba" aria-label="Salix, arriba">
      <span class="isotipo" aria-hidden="true"></span>
      <span>Salix</span>
    </a>
    <nav class="tope-nav" aria-label="Secciones">
      <a href="#carta">Productos</a>
      <a href="#sites">Sitios</a>
      <a href="#viene">Lo que viene</a>
    </nav>
    <a class="boton boton--tinta" href={`mailto:${CORREO}`}>Escribinos</a>
  </header>

  <main id="arriba">
    <section class="abre">
      <h1>
        Hacemos <a href="#flux">Flux</a>, <a href="#menu">Menu</a>, <a href="#nuvix">Nuvix</a>
        y los sitios web de quien nos lo pide.
      </h1>
      <p class="abre-bajada">
        Salix es una casa de software de Buenos Aires. Cada producto tiene su nombre, su color y su
        propia web. Acá están todos, los que ya andan y los que vienen.
      </p>
    </section>

    <!-- La carta: una muestra por producto. En la computadora, en fila, como las barras del isotipo;
         en el teléfono, apiladas. Cada muestra lleva a su campo. -->
    <section class="carta" id="carta" aria-label="Todos los productos">
      <ul class="carta-fila">
        {ENTRADAS.map((e) => (
          <li>
            <a class:list={['muestra', `muestra--${e.id}`, { 'muestra--viene': e.viene }]} href={e.viene ? '#viene' : `#${e.id}`}>
              <span class="muestra-color" aria-hidden="true">
                {e.id === 'flux' && <LogoFlux tamaño={34} />}
                {e.id === 'menu' && <LogoMenu tamaño={34} />}
                {e.id === 'nuvix' && <span class="logo-nuvix"></span>}
                {e.id === 'sites' && <span class="isotipo isotipo--muestra"></span>}
                {e.id === 'integraciones' && <span class="isotipo isotipo--muestra"></span>}
              </span>
              <span class="muestra-rotulo">
                <strong>{e.nombre}</strong>
                <span class="muestra-que">{e.que}</span>
                <span class="muestra-estado">{e.estado}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="campo campo--flux" id="flux">
      <div class="campo-texto">
        <p class="campo-nombre"><LogoFlux tamaño={30} /> {flux.nombre} <span>{flux.que}</span></p>
        <h2>{flux.frase}</h2>
        <ul class="campo-hechos">{flux.hechos.map((h) => <li>{h}</li>)}</ul>
        <a class="boton boton--claro" href={flux.url}>Ir a {flux.dominio} <span aria-hidden="true">→</span></a>
      </div>
      <figure class="campo-vista campo-vista--ancha">
        <img src="/propuestas/flux-mac.webp" width="1512" height="993" loading="lazy" decoding="async" alt="La bandeja de mensajes de Flux, con las conversaciones de WhatsApp de una empresa de muestra." />
      </figure>
    </section>

    <section class="campo campo--menu" id="menu">
      <div class="campo-texto">
        <p class="campo-nombre"><LogoMenu tamaño={30} /> {menu.nombre} <span>{menu.que}</span></p>
        <h2>{menu.frase}</h2>
        <ul class="campo-hechos">{menu.hechos.map((h) => <li>{h}</li>)}</ul>
        <a class="boton boton--lima" href={menu.url}>Ir a {menu.dominio} <span aria-hidden="true">→</span></a>
      </div>
      <figure class="campo-vista campo-vista--duo">
        <img src="/propuestas/menu-clasica.webp" width="600" height="1304" loading="lazy" decoding="async" alt="Una carta de Menu en su versión clásica, en un teléfono." />
        <img src="/propuestas/menu-visual.webp" width="600" height="1304" loading="lazy" decoding="async" alt="La misma carta en su versión visual, con un plato a pantalla completa." />
      </figure>
    </section>

    <section class="campo campo--nuvix" id="nuvix">
      <div class="campo-texto">
        <p class="campo-nombre"><span class="logo-nuvix"></span> {nuvix.nombre} <span>{nuvix.que}</span></p>
        <h2>{nuvix.frase}</h2>
        <ul class="campo-hechos">{nuvix.hechos.map((h) => <li>{h}</li>)}</ul>
        <a class="boton boton--claro" href={nuvix.url}>Ir a {nuvix.dominio} <span aria-hidden="true">→</span></a>
      </div>
      <figure class="campo-vista campo-vista--duo">
        <img src="/propuestas/nuvix-dia.webp" width="660" height="1434" loading="lazy" decoding="async" alt="La pantalla del día en Nuvix." />
        <img src="/propuestas/nuvix-aplicacion.webp" width="660" height="1434" loading="lazy" decoding="async" alt="La pantalla de Nuvix que muestra dónde sigue la próxima aplicación." />
      </figure>
    </section>

    <section class="campo campo--sites" id="sites">
      <div class="campo-texto">
        <p class="campo-nombre"><span class="isotipo"></span> {sites.nombre} <span>{sites.que}</span></p>
        <h2>{sites.frase}</h2>
        <ul class="campo-hechos">{sites.hechos.map((h) => <li>{h}</li>)}</ul>
        <a class="boton boton--tinta" href={`mailto:${CORREO}?subject=Sitio%20web`}>Pedir un sitio <span aria-hidden="true">→</span></a>
      </div>
      <ul class="sitios">
        {SITIOS.map((s) => (
          <li>
            <a href={`https://${s.dominio}`} rel="noopener">
              <img src={`/propuestas/${s.archivo}`} width="1440" height="900" loading="lazy" decoding="async" alt={`Portada de ${s.dominio}`} />
              <strong>{s.dominio}</strong>
              <span>{s.que}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="campo campo--integraciones" id="integraciones">
      <div class="campo-texto">
        <p class="campo-nombre"><span class="isotipo"></span> {integraciones.nombre} <span>{integraciones.que}</span></p>
        <h2>{integraciones.frase}</h2>
        <ul class="campo-hechos">{integraciones.hechos.map((h) => <li>{h}</li>)}</ul>
        <a class="boton boton--cobre" href={integraciones.url}>Ver las sesiones <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="viene" id="viene">
      <h2>Lo que viene.</h2>
      <p class="viene-bajada">Todavía sin color: los estamos preparando. Cuando salgan, van a estar acá.</p>
      <ul class="viene-fila">
        {vienen.map((e) => (
          <li class="muestra muestra--viene muestra--grande">
            <span class="muestra-color" aria-hidden="true"></span>
            <span class="muestra-rotulo">
              <strong>{e.nombre}</strong>
              <span class="muestra-que">{e.que}</span>
              <span class="muestra-estado">{e.estado}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="cierre">
      <h2>¿No sabés cuál te sirve? Contanos qué tenés.</h2>
      <a class="boton boton--tinta boton--grande" href={`mailto:${CORREO}`}>{CORREO}</a>
    </section>
  </main>

  <footer class="pie">
    <span class="marca"><span class="isotipo" aria-hidden="true"></span> Salix</span>
    <span>Software And Logic for eXcellence · Buenos Aires, Argentina</span>
    <a href="/propuestas/">Volver a las propuestas</a>
  </footer>
</Propuesta>

<style>
  :global(body) {
    --papel: #f3efe6;
    --papel-2: #fffdf8;
    --tinta: #17150f;
    --tinta-2: #5a554a;
    --linea: #d9d2c3;
    --cobre: #e8922a;
    --flux: #4e4eb8;
    --menu: #394a42;
    --menu-papel: #e5e3d0;
    --menu-lima: #d2db8c;
    --nuvix: #136c64;
    --margen: clamp(1.25rem, 4.5vw, 5rem);
    background: var(--papel);
    color: var(--tinta);
  }
  :global(::selection) { background: var(--tinta); color: var(--papel); }
  :global(:focus-visible) { outline: 3px solid var(--tinta); outline-offset: 3px; border-radius: 4px; }

  /* El isotipo, pintado con el color de la letra de donde esté. */
  .isotipo, .logo-nuvix {
    display: inline-block;
    inline-size: 1.5em;
    block-size: 1.5em;
    background: currentColor;
    -webkit-mask: url('/logo-salix.svg') center / contain no-repeat;
    mask: url('/logo-salix.svg') center / contain no-repeat;
    flex: none;
  }
  .logo-nuvix {
    -webkit-mask-image: url('/propuestas/nuvix-isotipo.svg');
    mask-image: url('/propuestas/nuvix-isotipo.svg');
  }

  .tope {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.875rem max(var(--margen), env(safe-area-inset-right)) 0.875rem max(var(--margen), env(safe-area-inset-left));
    background: color-mix(in srgb, var(--papel) 88%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--linea);
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-stretch: 112%;
    font-size: 1.0625rem;
    text-decoration: none;
  }
  .tope-nav {
    display: none;
    gap: 1.75rem;
    margin-inline: auto;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .tope-nav a { text-decoration: none; padding-block: 0.5rem; }
  .tope .boton { margin-inline-start: auto; }
  @media (min-width: 52rem) {
    .tope-nav { display: flex; }
    .tope .boton { margin-inline-start: 0; }
  }
  @media (hover: hover) {
    .tope-nav a:hover { text-decoration: underline; text-underline-offset: 0.35em; text-decoration-thickness: 2px; }
  }

  .boton {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
    transition: translate 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .boton:active { translate: 0 1px; }
  .boton--tinta { background: var(--tinta); color: var(--papel); }
  .boton--claro { background: #fff; color: var(--tinta); }
  .boton--lima { background: var(--menu-lima); color: #232d28; }
  .boton--cobre { background: var(--cobre); color: #1c1206; }
  .boton--grande { min-block-size: 3.5rem; padding-inline: 1.75rem; font-size: 1.125rem; }

  /* ── Abre ── */
  .abre {
    padding: clamp(2rem, 6svh, 5rem) var(--margen) clamp(1.5rem, 3.5svh, 2.5rem);
    max-inline-size: 96rem;
    margin-inline: auto;
  }
  h1 {
    max-inline-size: 21ch;
    font-size: clamp(2.375rem, 1rem + 5.2vw, 5.25rem);
    line-height: 0.98;
    font-weight: 750;
    font-stretch: 108%;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  h1 a {
    text-decoration: underline;
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.12em;
  }
  h1 a[href='#flux'] { color: var(--flux); }
  h1 a[href='#menu'] { color: var(--menu); }
  h1 a[href='#nuvix'] { color: var(--nuvix); }
  .abre-bajada {
    margin-top: clamp(1rem, 2.4svh, 1.5rem);
    max-inline-size: 60ch;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.3125rem);
    color: var(--tinta-2);
    text-wrap: pretty;
  }

  /* ── La carta ── */
  .carta {
    padding: 0 var(--margen) clamp(3rem, 8svh, 6rem);
    max-inline-size: 96rem;
    margin-inline: auto;
  }
  .carta-fila {
    display: grid;
    gap: 0.5rem;
  }
  .muestra {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--papel-2);
    color: var(--tinta);
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(23, 21, 15, 0.08), 0 8px 24px -12px rgba(23, 21, 15, 0.18);
    transition: translate 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .muestra-color {
    display: grid;
    place-items: center;
    min-block-size: 4.5rem;
    background: var(--color, var(--tinta));
    color: var(--sobre, #fff);
  }
  .muestra--flux { --color: var(--flux); }
  .muestra--menu { --color: var(--menu); --sobre: var(--menu-papel); }
  .muestra--nuvix { --color: var(--nuvix); }
  .muestra--sites { --color: var(--cobre); --sobre: #1c1206; }
  .muestra--integraciones { --color: var(--tinta); --sobre: var(--papel); }
  .muestra-color :global(svg), .muestra-color .logo-nuvix, .muestra-color .isotipo { inline-size: 2rem; block-size: 2rem; }
  .muestra-rotulo {
    display: grid;
    align-content: center;
    gap: 0.0625rem;
    padding: 0.75rem 1rem;
  }
  .muestra-rotulo strong { font-size: 1.125rem; font-weight: 700; font-stretch: 108%; letter-spacing: -0.01em; }
  .muestra-que { font-size: 0.875rem; color: var(--tinta-2); }
  .muestra-estado { margin-top: 0.25rem; font-size: 0.75rem; font-weight: 600; font-stretch: 88%; letter-spacing: 0.04em; text-transform: uppercase; color: var(--tinta-2); }
  /* Sin pintar: la muestra existe, el color todavía no. */
  .muestra--viene { background: transparent; box-shadow: none; outline: 1.5px dashed color-mix(in srgb, var(--tinta) 38%, transparent); outline-offset: -1.5px; }
  .muestra--viene .muestra-color { background: transparent; }

  @media (min-width: 60rem) {
    .carta-fila {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: clamp(0.5rem, 0.8vw, 0.875rem);
      align-items: end;
    }
    .muestra {
      grid-template-columns: none;
      grid-template-rows: minmax(0, 1fr) auto;
      block-size: clamp(15rem, 36svh, 24rem);
    }
    /* El perfil de la copa del isotipo: más altas las del medio. */
    .carta-fila li:nth-child(1) .muestra, .carta-fila li:nth-child(8) .muestra { block-size: clamp(11.5rem, 27svh, 18rem); }
    .carta-fila li:nth-child(2) .muestra, .carta-fila li:nth-child(7) .muestra { block-size: clamp(13.25rem, 31.5svh, 21rem); }
    .muestra-color { place-items: start; padding: 1rem; }
    .muestra-rotulo { padding: 0.875rem 1rem 1rem; min-block-size: 6.75rem; align-content: start; }
  }
  @media (hover: hover) and (min-width: 60rem) {
    .muestra:hover { translate: 0 -0.875rem; box-shadow: 0 2px 4px rgba(23, 21, 15, 0.1), 0 28px 40px -18px rgba(23, 21, 15, 0.35); }
  }
  /* Teléfono acostado: poco alto, la carta va en dos columnas. */
  @media (max-width: 59.99rem) and (min-width: 34rem) {
    .carta-fila { grid-template-columns: 1fr 1fr; }
  }

  /* ── Los campos: cada producto, su color de borde a borde ── */
  .campo {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding: clamp(3.5rem, 10svh, 7.5rem) var(--margen);
    background: var(--fondo);
    color: var(--sobre);
    scroll-margin-top: 4rem;
  }
  .campo > * { max-inline-size: 44rem; }
  @media (min-width: 60rem) {
    .campo { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
    .campo > * { max-inline-size: none; }
    .campo--menu .campo-texto, .campo--sites .campo-texto { order: 2; }
  }
  .campo--flux { --fondo: var(--flux); --sobre: #fff; --tenue: #dedeff; }
  .campo--menu { --fondo: var(--menu); --sobre: var(--menu-papel); --tenue: #c3c8b6; }
  .campo--nuvix { --fondo: var(--nuvix); --sobre: #fff; --tenue: #cfe9e3; }
  .campo--sites { --fondo: var(--cobre); --sobre: #1c1206; --tenue: #4a2f08; }
  .campo--integraciones { --fondo: var(--tinta); --sobre: var(--papel); --tenue: #b9b3a5; grid-template-columns: minmax(0, 1fr); }
  .campo-nombre {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1.25rem;
    font-weight: 700;
    font-stretch: 108%;
  }
  .campo-nombre span:last-child { font-weight: 500; font-stretch: 100%; font-size: 0.9375rem; color: var(--tenue); }
  .campo h2 {
    margin-top: 1.25rem;
    max-inline-size: 16ch;
    font-size: clamp(2rem, 1.1rem + 3.6vw, 4.25rem);
    line-height: 1;
    font-weight: 750;
    font-stretch: 106%;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }
  .campo-hechos {
    margin-top: 1.75rem;
    display: grid;
    max-inline-size: 34rem;
  }
  .campo-hechos li {
    padding-block: 0.875rem;
    border-top: 1px solid color-mix(in srgb, var(--sobre) 28%, transparent);
    font-size: 1.0625rem;
    text-wrap: pretty;
  }
  .campo .boton { margin-top: 1.5rem; }
  .campo-vista img { border-radius: 0.75rem; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.55); }
  .campo-vista--duo { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(0.75rem, 2vw, 1.5rem); max-inline-size: 34rem; justify-self: center; }
  .campo-vista--duo img { border-radius: 1.5rem; }
  .campo-vista--duo img:last-child { margin-top: 2.5rem; }

  .sitios { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(0.75rem, 1.6vw, 1.25rem); }
  @media (min-width: 80rem) { .sitios { grid-template-columns: 1fr 1fr 1fr; } }
  .sitios a { display: grid; gap: 0.125rem; text-decoration: none; }
  .sitios img { border-radius: 0.5rem; margin-bottom: 0.5rem; box-shadow: 0 16px 30px -18px rgba(28, 18, 6, 0.6); transition: translate 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .sitios strong { font-size: 0.9375rem; font-weight: 700; }
  .sitios span { font-size: 0.8125rem; color: var(--tenue); }
  @media (hover: hover) { .sitios a:hover img { translate: 0 -0.375rem; } }

  /* ── Lo que viene ── */
  .viene { padding: clamp(3.5rem, 10svh, 7rem) var(--margen); max-inline-size: 96rem; margin-inline: auto; }
  .viene h2, .cierre h2 {
    font-size: clamp(2rem, 1.1rem + 3.6vw, 4.25rem);
    line-height: 1;
    font-weight: 750;
    font-stretch: 106%;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }
  .viene-bajada { margin-top: 1rem; max-inline-size: 46ch; color: var(--tinta-2); font-size: 1.0625rem; }
  .viene-fila { margin-top: 2rem; display: grid; gap: 0.75rem; }
  @media (min-width: 44rem) { .viene-fila { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .muestra--grande { grid-template-columns: none; grid-template-rows: 7rem auto; }
  .muestra--grande .muestra-rotulo { padding: 1rem 1.25rem 1.25rem; border-top: 1.5px dashed color-mix(in srgb, var(--tinta) 38%, transparent); }

  .cierre {
    display: grid;
    justify-items: start;
    gap: 2rem;
    padding: clamp(3.5rem, 10svh, 7rem) var(--margen) clamp(4rem, 12svh, 8rem);
    max-inline-size: 96rem;
    margin-inline: auto;
    border-top: 1px solid var(--linea);
  }
  .cierre h2 { max-inline-size: 18ch; }

  .pie {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    padding: 1.5rem var(--margen) max(1.5rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--linea);
    font-size: 0.875rem;
    color: var(--tinta-2);
  }
  .pie .marca { color: var(--tinta); }
  .pie a { margin-inline-start: auto; }

  @media (prefers-reduced-motion: reduce) {
    .muestra, .boton, .sitios img { transition: none; }
  }
</style>
