---
// ============================================================
// FormularioContacto.astro — el formulario de contacto, por pasos.
//
//   1 · Qué te interesa   (se saltea si la página ya lo sabe: productoPreseleccionado)
//   2 · Cómo te contactamos
//   3 · El mensaje        (la ayuda cambia según el producto elegido)
//   4 · Listo             (solo si el servidor confirmó el envío)
//
// Envía a /contacto.php (public/contacto.php), que lo manda por correo a hola@salixweb.com.
// Si el envío falla, el formulario lo dice y muestra el correo: nunca da por enviado algo
// que no salió.
//
// Los productos salen de src/productos.ts, la misma lista que la grilla de Productos.
// ============================================================
import IconoProducto from './IconoProducto.astro';
import IconoSVG from './ui/IconoSVG.astro';
import NombreMarca from './NombreMarca.astro';
import { PRODUCTOS, SIN_DECIDIR, CORREO_CONTACTO } from '../productos';

interface Props {
  productoPreseleccionado?: string;
}

const { productoPreseleccionado } = Astro.props;

const disponibles = PRODUCTOS.filter((p) => p.disponible);
const proximos = PRODUCTOS.filter((p) => !p.disponible);
const PASOS = ['Producto', 'Contacto', 'Mensaje', 'Listo'];
const flecha = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
---

<section class="seccion" id="contacto">
  <div class="form-encabezado aparecer">
    <span class="etiqueta">Contacto</span>
    <h2 class="titulo-seccion">Hablemos.</h2>
    {productoPreseleccionado ? (
      <p class="form-sub">Consulta sobre <strong class="form-sub-marca"><NombreMarca nombre={productoPreseleccionado} /></strong>. Dejanos tus datos y te respondemos rápido.</p>
    ) : (
      <p class="form-sub">Contanos qué necesitás y te decimos cómo te puede ayudar Salix.</p>
    )}
  </div>

  <form
    class="form-contenedor aparecer delay-2"
    data-producto-pre={productoPreseleccionado || ''}
    novalidate
    aria-label="Formulario de contacto"
  >
    <!-- Indicador de pasos -->
    <div class="form-indicador">
      <div class="form-indicador-barra" aria-hidden="true"><div class="form-indicador-progreso"></div></div>
      <ol class="form-indicador-pasos" aria-label="Pasos">
        {PASOS.map((titulo, i) => (
          <li class="form-indicador-paso">
            <button
              type="button"
              class={`form-dot${i === 0 ? ' activo' : ''}`}
              data-paso={i + 1}
              aria-label={`Paso ${i + 1} de ${PASOS.length}: ${titulo}`}
              aria-current={i === 0 ? 'step' : undefined}
              disabled
            >
              <span class="form-dot-num">{i + 1}</span>
              <svg class="form-dot-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            </button>
            <span class="form-dot-titulo" aria-hidden="true">{titulo}</span>
          </li>
        ))}
      </ol>
    </div>

    <!-- Lo elegido, a la vista mientras se completan los datos -->
    <div class="form-eleccion" hidden>
      <span class="form-eleccion-texto">Consulta sobre <strong class="form-eleccion-nombre"></strong></span>
      <button type="button" class="form-eleccion-cambiar">Cambiar</button>
    </div>

    <div class="form-cuerpo">

      <!-- Paso 1: qué te interesa -->
      <fieldset class="form-paso visible" data-form-paso="1">
        <legend class="form-pregunta">¿Qué te interesa?</legend>

        <div class="form-productos">
          {disponibles.map((p, i) => (
            <label class="form-prod" style={`--i:${i}`}>
              <input type="radio" name="producto" value={p.id} data-corto={p.corto} data-pista={p.pista} />
              <span class="form-prod-inner">
                <span class="form-prod-icono"><IconoProducto nombre={p.icono} tamaño={20} /></span>
                <span class="form-prod-texto"><strong>{p.corto}</strong><span>{p.linea}</span></span>
                <span class="form-prod-tilde" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
              </span>
            </label>
          ))}
        </div>

        <p class="form-grupo-titulo" id="form-titulo-proximos">Próximamente</p>
        <div class="form-productos form-productos--proximos" aria-describedby="form-titulo-proximos">
          {proximos.map((p, i) => (
            <label class="form-prod form-prod--proximo" style={`--i:${disponibles.length + i}`}>
              <input type="radio" name="producto" value={p.id} data-corto={p.corto} data-pista={p.pista} />
              <span class="form-prod-inner">
                <span class="form-prod-icono"><IconoProducto nombre={p.icono} tamaño={18} /></span>
                <span class="form-prod-texto"><strong>{p.corto}</strong><span>{p.linea}</span></span>
                <span class="form-prod-tilde" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
              </span>
            </label>
          ))}
        </div>

        <label class="form-prod form-prod--ancho" style={`--i:${PRODUCTOS.length}`}>
          <input type="radio" name="producto" value={SIN_DECIDIR.id} data-corto={SIN_DECIDIR.corto} data-pista={SIN_DECIDIR.pista} />
          <span class="form-prod-inner">
            <span class="form-prod-icono"><IconoSVG nombre={SIN_DECIDIR.icono} tamaño={20} /></span>
            <span class="form-prod-texto"><strong>{SIN_DECIDIR.corto}</strong><span>{SIN_DECIDIR.linea}</span></span>
            <span class="form-prod-tilde" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
          </span>
        </label>

        <p class="form-aviso" data-aviso="producto" role="alert"></p>
      </fieldset>

      <!-- Paso 2: cómo te contactamos -->
      <fieldset class="form-paso" data-form-paso="2">
        <legend class="form-pregunta">¿Cómo te contactamos?</legend>
        <div class="form-campos">
          <div class="form-grupo">
            <label for="form-nombre">Nombre</label>
            <input type="text" id="form-nombre" name="nombre" placeholder="Tu nombre o el de tu negocio" autocomplete="name" maxlength="120" aria-describedby="aviso-nombre" />
            <p class="form-aviso" id="aviso-nombre" data-aviso="nombre" role="alert"></p>
          </div>
          <div class="form-grupo">
            <label for="form-email">Correo</label>
            <input type="email" id="form-email" name="email" placeholder="tu@correo.com" autocomplete="email" inputmode="email" maxlength="200" spellcheck="false" aria-describedby="aviso-email" />
            <p class="form-aviso" id="aviso-email" data-aviso="email" role="alert"></p>
          </div>
          <div class="form-grupo">
            <label for="form-whatsapp">WhatsApp <span class="form-opc">(opcional)</span></label>
            <input type="tel" id="form-whatsapp" name="whatsapp" placeholder="+54 9 11 1234-5678" autocomplete="tel" inputmode="tel" maxlength="40" aria-describedby="aviso-whatsapp" />
            <p class="form-aviso" id="aviso-whatsapp" data-aviso="whatsapp" role="alert"></p>
          </div>
          <div class="form-grupo" role="radiogroup" aria-labelledby="form-titulo-pref">
            <span class="form-etiqueta" id="form-titulo-pref">¿Por dónde preferís que te respondamos?</span>
            <div class="form-pills">
              <label class="form-pill"><input type="radio" name="preferencia" value="email" checked /><span>Correo</span></label>
              <label class="form-pill"><input type="radio" name="preferencia" value="whatsapp" /><span>WhatsApp</span></label>
              <label class="form-pill"><input type="radio" name="preferencia" value="cualquiera" /><span>Cualquiera</span></label>
            </div>
          </div>
        </div>
      </fieldset>

      <!-- Paso 3: el mensaje -->
      <fieldset class="form-paso" data-form-paso="3">
        <legend class="form-pregunta">Contanos un poco más</legend>
        <div class="form-campos">
          <div class="form-grupo">
            <label for="form-mensaje">Mensaje <span class="form-opc">(opcional)</span></label>
            <textarea id="form-mensaje" name="mensaje" rows="5" maxlength="5000" aria-describedby="form-pista"></textarea>
            <p class="form-pista" id="form-pista"></p>
          </div>
        </div>
        <!-- Trampa para robots: una persona no la ve ni la completa -->
        <div class="form-trampa" aria-hidden="true">
          <label>Sitio web <input type="text" name="sitio_web" tabindex="-1" autocomplete="off" /></label>
        </div>
      </fieldset>

      <!-- Paso 4: listo (solo después de que el servidor confirmó) -->
      <div class="form-paso" data-form-paso="4">
        <div class="form-exito">
          <canvas class="form-confetti" aria-hidden="true"></canvas>
          <div class="form-check" aria-hidden="true">
            <svg viewBox="0 0 52 52" fill="none">
              <circle class="check-circ" cx="26" cy="26" r="24" stroke-width="2" />
              <path class="check-tick" d="M15 27l7 7 15-15" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <h3 class="form-exito-titulo" tabindex="-1">¡Listo!</h3>
          <p class="form-exito-sub"></p>
          <dl class="form-resumen">
            <div class="form-res-fila"><dt>Producto</dt><dd data-res="producto">—</dd></div>
            <div class="form-res-fila"><dt>Nombre</dt><dd data-res="nombre">—</dd></div>
            <div class="form-res-fila"><dt>Te escribimos a</dt><dd data-res="contacto">—</dd></div>
          </dl>
          <button type="button" class="form-otra">Enviar otra consulta</button>
        </div>
      </div>
    </div>

    <p class="form-error-envio" role="alert" hidden>
      <span class="form-error-envio-texto"></span>
      Si sigue fallando, escribinos a <span class="form-correo">{CORREO_CONTACTO}</span>.
    </p>

    <!-- Navegación -->
    <div class="form-nav">
      <button type="button" class="form-btn-atras boton boton-secundario" disabled>Atrás</button>
      <button type="submit" class="form-btn-sig boton boton-primario">
        <span class="form-btn-texto">Siguiente</span>
        <span class="form-btn-icono" set:html={flecha} />
        <span class="form-btn-girador" aria-hidden="true"></span>
      </button>
    </div>
  </form>
</section>

<script>
  const PREFERENCIA_TEXTO: Record<string, string> = {
    email: 'por correo',
    whatsapp: 'por WhatsApp',
    cualquiera: 'por correo o WhatsApp',
  };
  const DURACION_SALIDA = 160;

  function initForm() {
    const form = document.querySelector<HTMLFormElement>('form.form-contenedor');
    if (!form || form.dataset.init) return;
    form.dataset.init = '1';

    const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const abierto = performance.now();
    const $ = <T extends Element>(sel: string) => form.querySelector<T>(sel)!;
    const cuerpo = $<HTMLElement>('.form-cuerpo');
    const dots = Array.from(form.querySelectorAll<HTMLButtonElement>('.form-dot'));
    const progreso = $<HTMLElement>('.form-indicador-progreso');
    const btnSig = $<HTMLButtonElement>('.form-btn-sig');
    const btnTexto = $<HTMLElement>('.form-btn-texto');
    const btnAtras = $<HTMLButtonElement>('.form-btn-atras');
    const eleccion = $<HTMLElement>('.form-eleccion');
    const errorEnvio = $<HTMLElement>('.form-error-envio');
    const campo = (nombre: string) => form.elements.namedItem(nombre) as HTMLInputElement;
    const productoElegido = () => form.querySelector<HTMLInputElement>('input[name="producto"]:checked');
    const preferencia = () => form.querySelector<HTMLInputElement>('input[name="preferencia"]:checked')?.value || 'email';

    let paso = 1;
    let cambiando = false;
    let enviando = false;
    let ultimoPuntero = 0;

    // ── Avisos de cada campo ──
    function avisar(clave: string, texto: string) {
      const aviso = form.querySelector<HTMLElement>(`[data-aviso="${clave}"]`);
      if (aviso) aviso.textContent = texto;
      if (clave === 'producto') {
        form.querySelectorAll<HTMLElement>('.form-prod').forEach((p) => {
          p.classList.remove('sacudir');
          void p.offsetWidth;
          p.classList.add('sacudir');
        });
      } else {
        campo(clave)?.setAttribute('aria-invalid', 'true');
      }
    }
    function limpiarAviso(clave: string) {
      const aviso = form.querySelector<HTMLElement>(`[data-aviso="${clave}"]`);
      if (aviso) aviso.textContent = '';
      if (clave !== 'producto') campo(clave)?.removeAttribute('aria-invalid');
    }
    ['nombre', 'email', 'whatsapp'].forEach((c) => campo(c).addEventListener('input', () => limpiarAviso(c)));

    function validar(n: number): HTMLElement | null {
      if (n === 1 && !productoElegido()) {
        avisar('producto', 'Elegí una opción para seguir.');
        return form.querySelector('input[name="producto"]');
      }
      if (n === 2) {
        let primero: HTMLElement | null = null;
        const nombre = campo('nombre');
        const email = campo('email');
        const whatsapp = campo('whatsapp');
        if (!nombre.value.trim()) {
          avisar('nombre', 'Escribí tu nombre.');
          primero ??= nombre;
        }
        if (!email.value.trim()) {
          avisar('email', 'Escribí tu correo: ahí te llega la respuesta.');
          primero ??= email;
        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim())) {
          avisar('email', 'Revisá el correo: le falta algo.');
          primero ??= email;
        }
        const digitos = whatsapp.value.replace(/\D/g, '').length;
        if (preferencia() === 'whatsapp' && digitos < 8) {
          avisar('whatsapp', 'Para responderte por WhatsApp necesitamos el número.');
          primero ??= whatsapp;
        } else if (whatsapp.value.trim() && digitos < 8) {
          avisar('whatsapp', 'Revisá el número: parece incompleto.');
          primero ??= whatsapp;
        }
        return primero;
      }
      return null;
    }

    // Con «WhatsApp» elegido, el número deja de ser opcional
    const opcionalWhatsapp = $<HTMLElement>('label[for="form-whatsapp"] .form-opc');
    form.querySelectorAll<HTMLInputElement>('input[name="preferencia"]').forEach((r) =>
      r.addEventListener('change', () => {
        const obligatorio = preferencia() === 'whatsapp';
        opcionalWhatsapp.hidden = obligatorio;
        campo('whatsapp').required = obligatorio;
        if (!obligatorio) limpiarAviso('whatsapp');
      }),
    );

    // ── Lo que depende del producto elegido ──
    function reflejarProducto() {
      const elegido = productoElegido();
      if (!elegido) return;
      $<HTMLElement>('.form-eleccion-nombre').textContent = elegido.dataset.corto || elegido.value;
      $<HTMLElement>('#form-pista').textContent = elegido.dataset.pista || '';
      limpiarAviso('producto');
    }

    // ── Indicador, botones y lo elegido ──
    function pintar(n: number) {
      dots.forEach((d, i) => {
        const numero = i + 1;
        d.classList.toggle('activo', numero <= n);
        d.classList.toggle('hecho', numero < n || n === dots.length);
        if (numero === n) d.setAttribute('aria-current', 'step');
        else d.removeAttribute('aria-current');
        // Se puede volver a un paso ya hecho; después de enviar, no
        d.disabled = !(numero < n && n < 4);
      });
      progreso.style.transform = `scaleX(${(n - 1) / (dots.length - 1)})`;
      btnAtras.disabled = n === 1;
      btnTexto.textContent = n === 3 ? 'Enviar' : 'Siguiente';
      form.classList.toggle('form--terminado', n === 4);
      eleccion.hidden = !(n === 2 || n === 3);
      if (n !== 3) errorEnvio.hidden = true;
    }

    function enfocar(el: HTMLElement) {
      const destino =
        el.querySelector<HTMLElement>('input[name="producto"]:checked') ||
        el.querySelector<HTMLElement>('input[type="text"], input[type="email"], textarea, input, [tabindex="-1"]');
      destino?.focus({ preventScroll: true });
    }

    function irA(n: number, { animar = !reducir, conFoco = true } = {}) {
      if (n === paso || cambiando) return;
      const dir = n > paso ? 1 : -1;
      const viejo = $<HTMLElement>(`[data-form-paso="${paso}"]`);
      const nuevo = $<HTMLElement>(`[data-form-paso="${n}"]`);
      paso = n;
      pintar(n);

      if (!animar) {
        viejo.classList.remove('visible');
        nuevo.classList.add('visible');
        if (conFoco) enfocar(nuevo);
        return;
      }

      // Sale el paso viejo, el cuerpo acompaña el cambio de alto y entra el nuevo desde el lado del avance
      cambiando = true;
      cuerpo.style.height = `${cuerpo.offsetHeight}px`;
      form.style.setProperty('--dir', String(dir));
      viejo.classList.add('saliendo');
      window.setTimeout(() => {
        viejo.classList.remove('visible', 'saliendo');
        nuevo.classList.add('visible', 'entrando');
        cuerpo.style.height = `${nuevo.offsetHeight}px`;
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            nuevo.classList.remove('entrando');
            if (conFoco) enfocar(nuevo);
          }),
        );
        window.setTimeout(() => {
          cuerpo.style.height = '';
          cambiando = false;
        }, 320);
      }, DURACION_SALIDA);
    }

    // ── Enviar ──
    async function enviar() {
      if (enviando) return;
      enviando = true;
      errorEnvio.hidden = true;
      btnSig.disabled = true;
      btnAtras.disabled = true;
      btnSig.classList.add('cargando');
      btnTexto.textContent = 'Enviando…';

      const datos = {
        producto: productoElegido()?.value || '',
        nombre: campo('nombre').value.trim(),
        email: campo('email').value.trim(),
        whatsapp: campo('whatsapp').value.trim(),
        preferencia: preferencia(),
        mensaje: (form.elements.namedItem('mensaje') as HTMLTextAreaElement).value.trim(),
        sitio_web: campo('sitio_web').value,
        pagina: location.pathname,
        demora: Math.round(performance.now() - abierto),
      };

      const corte = new AbortController();
      const reloj = window.setTimeout(() => corte.abort(), 15000);
      try {
        const r = await fetch('/contacto.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(datos),
          signal: corte.signal,
        });
        const respuesta = await r.json().catch(() => null);
        if (!r.ok || !respuesta?.ok) {
          const error = new Error(respuesta?.error || String(r.status)) as Error & { campo?: string; estado?: number };
          error.campo = respuesta?.campo;
          error.estado = r.status;
          throw error;
        }
        llenarResumen(datos);
        try { sessionStorage.removeItem('salix-pedido-sesiones'); } catch { /* modo privado */ }
        irA(4);
        if (!reducir) window.setTimeout(lanzarConfetti, 350);
      } catch (e) {
        const error = e as Error & { campo?: string; estado?: number };
        if (error.campo && ['nombre', 'email', 'whatsapp'].includes(error.campo)) {
          // El servidor rechazó un dato: se vuelve al paso de contacto, marcándolo
          irA(2);
          avisar(error.campo, 'Revisá este dato.');
        } else {
          $<HTMLElement>('.form-error-envio-texto').textContent =
            error.estado === 429
              ? 'Recibimos varias consultas seguidas desde tu conexión. Probá de nuevo en un rato.'
              : 'No pudimos enviar tu consulta. Probá de nuevo en un momento.';
          errorEnvio.hidden = false;
        }
      } finally {
        window.clearTimeout(reloj);
        enviando = false;
        btnSig.disabled = false;
        btnSig.classList.remove('cargando');
        if (paso !== 4) {
          btnAtras.disabled = paso === 1;
          btnTexto.textContent = paso === 3 ? 'Enviar' : 'Siguiente';
        }
      }
    }

    function llenarResumen(datos: { producto: string; nombre: string; email: string; whatsapp: string; preferencia: string }) {
      const corto = productoElegido()?.dataset.corto || datos.producto;
      const nombrePila = datos.nombre.split(/\s+/)[0];
      $<HTMLElement>('.form-exito-titulo').textContent = `¡Listo, ${nombrePila}!`;
      $<HTMLElement>('.form-exito-sub').textContent =
        `Recibimos tu consulta. Te respondemos ${PREFERENCIA_TEXTO[datos.preferencia] || 'por correo'} en menos de 24 horas.`;
      $<HTMLElement>('[data-res="producto"]').textContent = corto;
      $<HTMLElement>('[data-res="nombre"]').textContent = datos.nombre;
      $<HTMLElement>('[data-res="contacto"]').textContent =
        datos.preferencia === 'whatsapp' ? datos.whatsapp : datos.email;
    }

    // Confeti corto en los colores de la marca, solo en el paso 4
    function lanzarConfetti() {
      const canvas = $<HTMLCanvasElement>('.form-confetti');
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const rect = $<HTMLElement>('.form-exito').getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
      const W = rect.width, H = rect.height;
      const marca = getComputedStyle(form).getPropertyValue('--salix').trim() || '#c2710c';
      const colores = [marca, marca, '#f0c674', '#d4a55a'];
      const piezas = Array.from({ length: 48 }, () => ({
        x: W / 2 + (Math.random() - 0.5) * 40,
        y: H * 0.3,
        vx: (Math.random() - 0.5) * 7,
        vy: -Math.random() * 8 - 4,
        tam: Math.random() * 4 + 3,
        color: colores[Math.floor(Math.random() * colores.length)],
        rot: Math.random() * 360,
        vr: (Math.random() - 0.5) * 12,
        alfa: 1,
        g: 0.18 + Math.random() * 0.08,
        rect: Math.random() > 0.5,
      }));
      let cuadro = 0;
      const animar = () => {
        ctx.clearRect(0, 0, W, H);
        let vivos = 0;
        for (const p of piezas) {
          p.vy += p.g; p.x += p.vx; p.y += p.vy; p.rot += p.vr; p.vx *= 0.99;
          if (cuadro > 30) p.alfa -= 0.018;
          if (p.alfa <= 0) continue;
          vivos++;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rot * Math.PI) / 180);
          ctx.globalAlpha = p.alfa;
          ctx.fillStyle = p.color;
          if (p.rect) ctx.fillRect(-p.tam / 2, -p.tam / 4, p.tam, p.tam / 2);
          else { ctx.beginPath(); ctx.arc(0, 0, p.tam / 2, 0, Math.PI * 2); ctx.fill(); }
          ctx.restore();
        }
        cuadro++;
        if (vivos > 0 && cuadro < 180) requestAnimationFrame(animar);
        else ctx.clearRect(0, 0, W, H);
      };
      requestAnimationFrame(animar);
    }

    // ── Eventos ──
    // Enter en un campo avanza; en el paso 3 envía (el botón es de tipo submit)
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (cambiando || enviando || paso === 4) return;
      const conError = validar(paso);
      if (conError) {
        conError.focus();
        return;
      }
      if (paso === 3) enviar();
      else irA(paso + 1);
    });
    btnAtras.addEventListener('click', () => paso > 1 && paso < 4 && irA(paso - 1));
    dots.forEach((d) => d.addEventListener('click', () => irA(Number(d.dataset.paso))));
    $<HTMLButtonElement>('.form-eleccion-cambiar').addEventListener('click', () => irA(1));
    $<HTMLButtonElement>('.form-otra').addEventListener('click', () => {
      form.reset();
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      opcionalWhatsapp.hidden = false;
      campo('whatsapp').required = false;
      irA(1);
    });

    // Elegir un producto con el mouse o el dedo avanza solo; con las flechas del teclado, no:
    // cada flecha cambia la opción, y avanzar con la primera no dejaría elegir.
    form.addEventListener('pointerdown', () => { ultimoPuntero = performance.now(); });
    form.querySelectorAll<HTMLInputElement>('input[name="producto"]').forEach((r) =>
      r.addEventListener('change', () => {
        reflejarProducto();
        if (paso === 1 && performance.now() - ultimoPuntero < 800) window.setTimeout(() => irA(2), 260);
      }),
    );

    // Los íconos se dibujan cuando el formulario entra en pantalla
    new IntersectionObserver((entradas, obs) => {
      if (!entradas.some((e) => e.isIntersecting)) return;
      form.querySelectorAll('.form-prod-icono').forEach((i) => i.classList.add('dibujado'));
      obs.disconnect();
    }, { threshold: 0.2 }).observe(form);

    // La página ya sabe de qué producto se trata: arranca en el paso 2, sin animar ni mover el foco
    const pre = form.dataset.productoPre;
    if (pre) {
      const coincide = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="producto"]')).find((r) => r.value === pre);
      if (coincide) {
        coincide.checked = true;
        reflejarProducto();
        irA(2, { animar: false, conFoco: false });
      }
    }

    // Lo que armaron en la calculadora de sesiones de Integraciones llega escrito en el mensaje
    try {
      const pedido = sessionStorage.getItem('salix-pedido-sesiones');
      if (pedido) {
        const data = JSON.parse(pedido);
        const mensaje = form.elements.namedItem('mensaje') as HTMLTextAreaElement;
        if (data.mensaje && !mensaje.value.trim()) mensaje.value = data.mensaje;
      }
    } catch { /* modo privado */ }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initForm);
  else initForm();
</script>

