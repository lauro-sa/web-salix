---
// Isotipo de Menu — el QR «Tres ojos», entero (el logo quieto de Menu: sin las mordidas, que son
// solo su animación de entrada; ver docs/familia-salix/marca-menu.md en el repo de Flux).
//
// La geometría sale de src/logos-productos.json, que escribe el generador de marca del repo de
// Flux (`node scripts/marca/generar.mjs`) desde la familia. No se escribe a mano.
import logos from '../logos-productos.json';

interface Props {
  tamaño?: number;
  clase?: string;
}

const { tamaño = 22, clase = '' } = Astro.props;
const { menu } = logos;
// En dos tonos desde el 2026-10-03 (arriba lleno, abajo al 40 %): llega con `capas`, un path por
// tono, igual que LogoFlux. Pintar `menu.d` solo perdería el segundo tono.
const capas =
  'capas' in menu && Array.isArray(menu.capas)
    ? (menu.capas as { opacidad: number; fillRule: string; d: string }[])
    : [{ opacidad: 1, fillRule: menu.fillRule, d: menu.d }];
---

<svg
  class:list={['logo-menu', clase]}
  width={tamaño}
  height={tamaño}
  viewBox={menu.viewBox}
  aria-hidden="true"
>
  {
    capas.map((c) => (
      <path
        d={c.d}
        fill-rule={c.fillRule}
        fill="currentColor"
        fill-opacity={c.opacidad < 1 ? c.opacidad : undefined}
      />
    ))
  }
</svg>

<style>
  .logo-menu {
    display: block;
    color: var(--ico-color);
    flex-shrink: 0;
  }
</style>
