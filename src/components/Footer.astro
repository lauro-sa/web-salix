---
// ============================================================
// Footer.astro — Pie de pagina rediseñado
// ============================================================
import LogoSalix from './LogoSalix.astro';

const AÑO = new Date().getFullYear();
---

<footer class="footer">
  <!-- Parte superior: links en una sola fila compacta -->
  <div class="footer-top footer-animar">
    <nav class="footer-links" aria-label="Links del footer">
      <a href="/flux">Flux</a>
      <a href="/sites">Sites</a>
      <a href="/go">Go</a>
      <a href="/play">Play</a>
      <a href="/book">Book</a>
      <span class="footer-sep"></span>
      <a href="/#porque">Nosotros</a>
      <a href="/#testimonios">Clientes</a>
      <a href="/#contacto">Contacto</a>
      <span class="footer-sep"></span>
      <a href="/privacidad">Privacidad</a>
      <a href="/terminos">Terminos</a>
    </nav>
  </div>

  <!-- Pie: logo | copyright | toggle -->
  <div class="footer-pie footer-animar">
    <a href="/" class="footer-logo" aria-label="Salix inicio">
      <LogoSalix clase="footer-logo-svg" tamaño={22} />
      <span class="footer-nombre">Salix</span>
    </a>

    <p>&copy; {AÑO} Salix &middot; Buenos Aires, Argentina</p>

    <button id="boton-tema" class="tema-toggle" aria-label="Cambiar tema" title="Cambiar tema">
      <!-- Sol (claro) -->
      <svg class="tema-icono icono-sol-f" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <circle cx="9" cy="9" r="3.5"/>
        <line x1="9" y1="1.5" x2="9" y2="3.5"/>
        <line x1="9" y1="14.5" x2="9" y2="16.5"/>
        <line x1="3.1" y1="3.1" x2="4.5" y2="4.5"/>
        <line x1="13.5" y1="13.5" x2="14.9" y2="14.9"/>
        <line x1="1.5" y1="9" x2="3.5" y2="9"/>
        <line x1="14.5" y1="9" x2="16.5" y2="9"/>
        <line x1="3.1" y1="14.9" x2="4.5" y2="13.5"/>
        <line x1="13.5" y1="4.5" x2="14.9" y2="3.1"/>
      </svg>
      <!-- Luna (oscuro) -->
      <svg class="tema-icono icono-luna-f" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15.5 9.5A7 7 0 0 1 8.5 2.5 5.5 5.5 0 1 0 15.5 9.5z"/>
      </svg>
      <!-- Monitor (sistema) -->
      <svg class="tema-icono icono-sistema-f" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="2" width="14" height="10" rx="1.5"/>
        <line x1="6" y1="15" x2="12" y2="15"/>
        <line x1="9" y1="12" x2="9" y2="15"/>
      </svg>
    </button>
  </div>

  <!-- Firma del desarrollador -->
  <div class="footer-firma footer-animar">
    <firma-stian logo="/firma-stian/logo-claro.png"></firma-stian>
  </div>
</footer>

<script>
  const footer = document.querySelector('.footer');
  if (footer) {
    function checkFooter() {
      const scrollBottom = window.scrollY + window.innerHeight;
      const docHeight = document.documentElement.scrollHeight;
      const footerH = footer.offsetHeight;
      const mostrar = scrollBottom >= docHeight - footerH * 0.3;
      footer.classList.toggle('visible', mostrar);
    }
    window.addEventListener('scroll', checkFooter, { passive: true });
    checkFooter();
  }
</script>

<style>
  .footer {
    border-top: none;
    background: var(--fondo);
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.25rem, 5vw, 3rem) clamp(1.5rem, 3vw, 2rem);
    position: sticky;
    bottom: 0;
    z-index: 1;
    transition: background var(--transicion);
  }

  /* ─── Links en fila ─── */
  .footer-top {
    max-width: 1200px; margin: 0 auto;
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--borde);
  }

  .footer-links {
    display: flex; align-items: center;
    flex-wrap: wrap; gap: 8px 20px;
    justify-content: center;
  }

  .footer-links a {
    font-size: 13px; font-weight: 450; color: var(--texto-secundario);
    transition: color .2s;
    white-space: nowrap;
    padding: 8px 4px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .footer-links a:hover { color: var(--texto); }

  .footer-sep {
    width: 1px; height: 14px;
    background: var(--borde);
    flex-shrink: 0;
  }

  /* ─── Pie: logo | copyright | toggle en fila ─── */
  .footer-pie {
    max-width: 1200px; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    padding: clamp(1.25rem, 3vw, 2rem) 0;
  }

  .footer-pie p {
    font-size: 11.5px; color: var(--texto-terciario);
    letter-spacing: 0.02em;
  }

  .footer-logo {
    display: flex; align-items: center; gap: 8px;
    text-decoration: none; color: var(--texto);
    opacity: 0.4;
    transition: opacity .3s;
  }

  .footer-logo:hover { opacity: 0.7; }

  .footer-logo-svg { height: 22px; width: auto; }
  .footer-nombre { font-size: 13px; font-weight: 600; color: var(--texto); }

  /* ─── Toggle Tema Minimalista ─── */
  .tema-toggle {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--superficie);
    border: 1px solid var(--borde);
    display: flex; align-items: center; justify-content: center;
    position: relative;
    cursor: pointer;
    transition: background .3s, border-color .3s, transform .3s;
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }

  .tema-toggle:hover {
    border-color: var(--texto-terciario);
    transform: scale(1.1);
  }

  .tema-toggle:active { transform: scale(0.95); }

  .tema-icono {
    width: 14px; height: 14px;
    color: var(--texto-secundario);
    position: absolute;
    transition: opacity .4s, transform .4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Estado sistema (default): mostrar monitor */
  .icono-sol-f     { opacity: 0; transform: scale(0.5) rotate(90deg); }
  .icono-luna-f    { opacity: 0; transform: scale(0.5) rotate(-90deg); }
  .icono-sistema-f { opacity: 1; transform: scale(1) rotate(0deg); }

  /* Estado claro forzado: mostrar sol */
  :global([data-pref="claro"]) .icono-sol-f     { opacity: 1; transform: scale(1) rotate(0deg); }
  :global([data-pref="claro"]) .icono-luna-f    { opacity: 0; transform: scale(0.5) rotate(-90deg); }
  :global([data-pref="claro"]) .icono-sistema-f { opacity: 0; transform: scale(0.5) rotate(90deg); }

  /* Estado oscuro forzado: mostrar luna */
  :global([data-pref="oscuro"]) .icono-sol-f     { opacity: 0; transform: scale(0.5) rotate(90deg); }
  :global([data-pref="oscuro"]) .icono-luna-f    { opacity: 1; transform: scale(1) rotate(0deg); color: var(--salix); }
  :global([data-pref="oscuro"]) .icono-sistema-f { opacity: 0; transform: scale(0.5) rotate(-90deg); }

  /* ─── Firma ─── */
  .footer-firma {
    max-width: 1200px; margin: 0 auto;
    display: flex; justify-content: center;
    padding-top: 1.25rem;
  }

  /* ─── Animaciones al descubrir ─── */
  .footer-animar {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Aparece: cascada de arriba a abajo */
  .footer.visible .footer-animar {
    opacity: 1;
    transform: translateY(0);
  }

  .footer.visible .footer-top { transition-delay: 0.1s; }
  .footer.visible .footer-pie { transition-delay: 0.3s; }
  .footer.visible .footer-firma { transition-delay: 0.5s; }

  /* Desaparece: cascada inversa (abajo a arriba) */
  .footer:not(.visible) .footer-firma { transition-delay: 0s; }
  .footer:not(.visible) .footer-pie { transition-delay: 0.12s; }
  .footer:not(.visible) .footer-top { transition-delay: 0.24s; }

  /* ─── Responsive ─── */
  @media (max-width: 640px) {
    .footer-sep { display: none; }
    .footer-links { gap: 6px 16px; }
    .footer-pie {
      flex-direction: column; gap: 12px;
      text-align: center;
    }
  }
</style>
