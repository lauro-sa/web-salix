---
// ============================================================
// Footer.astro — el pie de la familia Salix (publico-salix.md, en la carpeta de la familia del
// repo de Flux): marca con su lema, columnas de enlaces, la base con el copyright, la firma
// y los controles (idioma y tema). La forma y la cortina son de toda la familia (src/styles/publico-salix.css,
// GENERADO); acá solo va lo de Salix.
// ============================================================
import Idioma from './Idioma.astro';
import LogoSalixAnimado from './LogoSalixAnimado.astro';
import LemaSalix from './LemaSalix.astro';

const AÑO = new Date().getFullYear();
interface Columna { titulo: string; enlaces: { href: string; texto: string }[] }
interface Props {
  /** Las columnas de enlaces. Sin ellas, las de la web anterior. */
  columnas?: Columna[];
  /** A dónde lleva el logo. */
  inicio?: string;
  /** Sin la frase del nombre bajo el logo: la web nueva la explica en el cierre, justo arriba. */
  sinLema?: boolean;
}
const COLUMNAS_DE_ANTES: Columna[] = [
  {
    // Solo los que existen hoy (Sal, 2026-09-28): los que vienen no se listan hasta que estén.
    titulo: 'Productos',
    enlaces: [
      { href: '/flux', texto: 'Flux' },
      { href: 'https://menu.salixweb.com', texto: 'Menu' },
      { href: '/sites', texto: 'Sites' },
    ],
  },
  {
    titulo: 'Salix',
    enlaces: [
      { href: '/#porque', texto: 'Nosotros' },
      { href: '/#testimonios', texto: 'Clientes' },
      { href: '/#contacto', texto: 'Contacto' },
    ],
  },
  {
    titulo: 'Legal',
    enlaces: [
      { href: '/privacidad', texto: 'Privacidad' },
      { href: '/terminos', texto: 'Términos' },
    ],
  },
];
const { columnas: COLUMNAS = COLUMNAS_DE_ANTES, inicio = '/', sinLema = false } = Astro.props;
---

<footer class="psx-pie">
  <!-- La caja de adentro lleva el fondo y el ancho entero: el pie pegado es más angosto para que
       Safari del iPhone no lo tome como pieza del borde (publico-salix.css de la familia). -->
  <div class="psx-pie-caja">
    <div class="psx-pie-arriba psx-pie-animar">
      <div class="psx-pie-marca">
        <!-- La envoltura del logo del pie de la familia (publico-salix.md §«El logo del pie»): repite su
             entrada cada vez que la cortina destapa el pie. Salix no lleva «by Salix»: es la madre. -->
        <div class="psx-pie-logo">
          <a href={inicio} aria-label="Salix, inicio">
            <span class="msx">
              <span class="msx-icono">
                <LogoSalixAnimado clase="msx-svg" id="copa-salix-footer" tamaño={26} />
              </span>
              <span class="msx-nombre" aria-hidden="true">
                <span class="msx-letra" style="--i:0">S</span><span class="msx-letra" style="--i:1">a</span><span class="msx-letra" style="--i:2">l</span><span class="msx-letra" style="--i:3">i</span><span class="msx-letra" style="--i:4">x</span>
              </span>
            </span>
          </a>
        </div>
        {!sinLema && <LemaSalix clase="psx-pie-lema" sinSigla />}
      </div>
      <nav class="psx-pie-columnas" aria-label="Enlaces del pie">
        {COLUMNAS.map((c) => (
          <div class="psx-pie-columna">
            <span class="psx-pie-titulo">{c.titulo}</span>
            {c.enlaces.map((e) => <a class="psx-pie-enlace" href={e.href}>{e.texto}</a>)}
          </div>
        ))}
      </nav>
    </div>

    <div class="psx-pie-base psx-pie-animar">
      <span>&copy; {AÑO} Salix &middot; Buenos Aires, Argentina</span>
      <div class="psx-pie-base-extra">
        <!-- Primero lo que se lee (la firma de quien hizo el sitio) y, contra el borde, los controles
             juntos: idioma y tema (publico-salix.md §4 y §6). -->
        <firma-stian logo="/firma-stian/logo-claro.png"></firma-stian>
        <div class="psx-pie-controles">
          <Idioma id="idioma-pie" />
          <div class="psx-tema" role="group" aria-label="Tema" data-clave="salix-tema">
            <button type="button" data-tema-pref="auto" aria-pressed="true" aria-label="Automático" title="Automático"></button>
            <button type="button" data-tema-pref="claro" aria-pressed="false" aria-label="Claro" title="Claro"></button>
            <button type="button" data-tema-pref="oscuro" aria-pressed="false" aria-label="Oscuro" title="Oscuro"></button>
          </div>
        </div>
      </div>
    </div>

  </div>
</footer>

