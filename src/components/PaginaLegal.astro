---
// Una página legal de la casa (privacidad, términos): el título, la fecha, el índice de secciones al
// costado y el texto. La página pone el texto con un <h2 id="…"> por sección y pasa la misma lista
// para el índice.
import Casa from '../layouts/Casa.astro';
import { RAIZ_CASA } from '../casa/navegacion';

interface Props {
  titulo: string;
  descripcion: string;
  /** Cuándo se tocó el texto por última vez: «noviembre de 2026». */
  actualizado: string;
  secciones: { id: string; titulo: string }[];
}
const { titulo, descripcion, actualizado, secciones } = Astro.props;
---

<Casa titulo={`${titulo} · Salix`} descripcion={descripcion} base={RAIZ_CASA} inicio={RAIZ_CASA}>
  <section class="legal">
    <div class="ancho">
      <nav class="migas" aria-label="Dónde estás">
        <a href={RAIZ_CASA}>Salix</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{titulo}</span>
      </nav>
      <h1 class="titulo titulo--pagina">{titulo}</h1>
      <p class="legal-fecha">Última actualización: {actualizado}</p>
      <div class="legal-caja">
        <nav class="legal-indice" aria-label="Secciones">
          <ol>
            {secciones.map((s) => <li><a href={`#${s.id}`}>{s.titulo}</a></li>)}
          </ol>
        </nav>
        <div class="legal-texto">
          <slot />
        </div>
      </div>
    </div>
  </section>
</Casa>

<style>
  .legal {
    padding-block: calc(var(--psx-alto-barra, 4.5rem) + 2rem) var(--aire);
  }
  .legal .titulo--pagina {
    margin-top: 0;
  }
  .legal-fecha {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: var(--texto-terciario);
  }
  .legal-caja {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--borde);
  }
  @media (min-width: 56rem) {
    .legal-caja {
      grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
      gap: clamp(2rem, 6vw, 5rem);
      align-items: start;
    }
    /* El índice acompaña mientras se lee. */
    .legal-indice {
      position: sticky;
      inset-block-start: calc(var(--psx-alto-barra, 4.5rem) + 1.5rem);
    }
  }
  .legal-indice ol {
    counter-reset: seccion;
  }
  .legal-indice li {
    counter-increment: seccion;
  }
  .legal-indice a {
    display: flex;
    gap: 0.625rem;
    padding-block: 0.4375rem;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--texto-secundario);
    transition: color 0.2s;
  }
  .legal-indice a::before {
    content: counter(seccion);
    flex: none;
    inline-size: 1.25rem;
    font-variant-numeric: tabular-nums;
    color: var(--texto-terciario);
  }
  @media (hover: hover) {
    .legal-indice a:hover {
      color: var(--texto);
    }
  }
  @media (pointer: coarse) {
    .legal-indice a {
      padding-block: 0.6875rem;
    }
  }

  /* El texto llega de la página que usa la pieza: por eso los estilos alcanzan a lo que va adentro. */
  .legal-texto {
    max-inline-size: 42rem;
    counter-reset: titulo;
  }
  .legal-texto :global(h2) {
    counter-increment: titulo;
    margin-top: 2.5rem;
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.012em;
  }
  .legal-texto :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-texto :global(h2)::before {
    content: counter(titulo) '. ';
    font-weight: 400;
    color: var(--texto-terciario);
  }
  .legal-texto :global(p),
  .legal-texto :global(li) {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--texto-secundario);
    text-wrap: pretty;
  }
  .legal-texto :global(p) {
    margin-top: 0.75rem;
  }
  .legal-texto :global(ul) {
    margin-top: 0.75rem;
    padding-inline-start: 1.25rem;
    list-style: disc;
  }
  .legal-texto :global(li) {
    margin-top: 0.375rem;
  }
  .legal-texto :global(li)::marker {
    color: var(--texto-terciario);
  }
  .legal-texto :global(strong) {
    font-weight: 600;
    color: var(--texto);
  }
  .legal-texto :global(a) {
    color: var(--texto);
    text-decoration: underline;
    text-decoration-color: var(--salix);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.1875rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .legal-indice a {
      transition: none;
    }
  }
</style>
