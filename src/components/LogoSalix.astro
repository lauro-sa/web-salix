---
import { VERSION_LOGO } from '../marca-version';
// Isotipo Salix. Un solo archivo: public/logo-salix.svg
//
// ⚠️ La `?v=` NO es decorativa, y ya no se escribe a mano. Los archivos de public/
// se sirven con `cache-control: max-age=604800` (7 dias) y el CDN de Hostinger los
// cachea en el borde: reemplazar el .svg NO cambia lo que ve la gente hasta que
// expire. Paso el 2026-08-19, con el logo cruzado en produccion.
// `npm run marca` calcula la huella del archivo y la deja en marca-version.ts, asi
// que cambia sola cuando cambia el dibujo. Nadie tiene que acordarse de nada.
// El de barras queda en public/logo-salix-barras.svg por si se vuelve.
// Medidas alineadas a flux.salixweb.com: nav 26 · hero 28.
interface Props {
  clase?: string;
  tamaño?: number;
}

const { clase = '', tamaño = 26 } = Astro.props;
---

<img
  src={`/logo-salix.svg?v=${VERSION_LOGO}`}
  class:list={['logo-salix', clase]}
  alt=""
  style={`height:${tamaño}px;width:auto`}
/>

<style>
  .logo-salix {
    display: block;
  }
  :global([data-tema="oscuro"]) .logo-salix {
    filter: invert(1);
  }
</style>
