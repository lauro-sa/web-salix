---
// ============================================================
// CierreSalix.astro — el último bloque de una página, justo arriba del pie.
//
// Es el «cierre que se acomoda» de la familia (publico-salix.css / publico-salix.ts): mientras el
// pie está tapado ocupa su lugar de siempre; cuando la cortina destapa el pie, su contenido se va
// achicando y centrando para entrar entero entre la barra y el pie, en vez de quedar cortado por la
// barra (Sal, 2026-11-19). Por eso tiene que ser lo ÚLTIMO dentro de <main>.
//
// Las acciones van en el slot (enlaces o botones con las clases .boton de siempre).
// ============================================================
interface Props {
  etiqueta?: string;
  titulo: string;
  /** Segunda parte del título, en cobre. */
  resaltado?: string;
  subtitulo?: string;
}
const { etiqueta, titulo, resaltado, subtitulo } = Astro.props;
---

<section class="cierre-salix psx-cierre">
  <div class="cierre-salix-caja psx-cierre-caja">
    {etiqueta && <span class="etiqueta">{etiqueta}</span>}
    <h2 class="titulo-seccion cierre-salix-titulo">
      {titulo}{resaltado && <> <span class="cierre-salix-resaltado">{resaltado}</span></>}
    </h2>
    {subtitulo && <p class="subtitulo cierre-salix-sub">{subtitulo}</p>}
    <div class="cierre-salix-acciones"><slot /></div>
  </div>
</section>

<style>
  .cierre-salix {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: min(42rem, 78vh);
    padding: clamp(5rem, 11vw, 8rem) clamp(1.25rem, 5vw, 3rem);
    border-top: 1px solid var(--borde-sutil);
  }
  .cierre-salix-caja {
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .cierre-salix-titulo { text-wrap: balance; }
  .cierre-salix-resaltado { color: var(--salix); }
  .cierre-salix-sub { text-align: center; text-wrap: pretty; }
  .cierre-salix-acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
