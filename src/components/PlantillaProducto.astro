---
// ============================================================
// PlantillaProducto.astro — Layout reutilizable para paginas de producto
// Soporta multiples planes de precio o sin precio (consultar).
// ============================================================
import IconoSVG from './ui/IconoSVG.astro';
import IconoProducto from './IconoProducto.astro';
import FormularioContacto from './FormularioContacto.astro';
import NombreMarca from './NombreMarca.astro';

interface Feature {
  titulo:      string;
  descripcion: string;
  icono:       string;
}

interface Plan {
  nombre:    string;
  precio:    string;
  periodo:   string;
  destacado: boolean;
  items:     string[];
  textoBoton: string;
  url?:      string;
  badge?:    string;
}

interface Cta {
  texto: string;
  href:  string;
}

interface Props {
  nombre:       string;
  subtitulo:    string;
  descripcion:  string;
  icono:        string;
  disponible:   boolean;
  color:        string;
  features:     Feature[];
  planes?:      Plan[];
  sinPrecio?:   boolean;
  textoSinPrecio?: string;
  ctaPrincipal?: Cta;
  ctaSecundario?: Cta;
  planesTitulo?: string;
  planesLead?: string;
  cierreTitulo?: string;
  cierreSub?: string;
  cierreCta?: Cta;
}

const {
  nombre,
  subtitulo,
  descripcion,
  icono,
  disponible,
  color,
  features,
  planes,
  sinPrecio = false,
  textoSinPrecio = 'Cada proyecto es unico. Contanos tu idea y te armamos un presupuesto a medida.',
  ctaPrincipal,
  ctaSecundario,
  planesTitulo = 'Elegi tu plan.',
  planesLead = 'Sin costos ocultos. Cancela cuando quieras.',
  cierreTitulo = 'Listo para probarlo?',
  cierreSub = 'Contactanos y te ayudamos a arrancar. Sin compromiso.',
  cierreCta,
} = Astro.props;

const primario = ctaPrincipal ?? {
  texto: disponible ? 'Empezar ahora' : 'Avisame cuando este',
  href: '/#contacto',
};
const secundario = ctaSecundario ?? {
  texto: 'Ver todos los productos',
  href: '/#productos',
};
const esExterno = (href: string) => href.startsWith('http');

// Schema.org para el producto
const productoSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": nombre,
  "description": descripcion,
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "url": Astro.url.href,
  "author": { "@type": "Organization", "name": "Salix", "url": "https://salixweb.com" },
  "offers": planes && planes.length > 0
    ? planes.filter(p => p.precio.includes('$')).map(p => ({
        "@type": "Offer",
        "name": p.nombre,
        "price": p.precio.replace(/[^0-9.]/g, ''),
        "priceCurrency": "USD",
        "availability": disponible ? "https://schema.org/InStock" : "https://schema.org/PreOrder",
      }))
    : undefined,
};
---

<!-- Schema.org del producto -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(productoSchema)} />

<!-- Hero del producto -->
<section class="producto-hero">
  <div class="producto-hero-contenido">
    <div class="aparecer">
      <span class={`etiqueta-estado ${disponible ? 'disponible' : 'proximamente'}`}>
        <span class="punto-estado"></span>
        {disponible ? 'Disponible ahora' : 'Proximamente'}
      </span>
    </div>

    <div class="producto-icono-grande aparecer delay-1">
      <div class="icono-contenedor icono-grande item-producto">
        <IconoProducto nombre={icono} tamaño={36} />
      </div>
    </div>

    <h1 class="titulo-producto aparecer delay-2"><NombreMarca nombre={nombre} /></h1>
    <p class="producto-subtitulo aparecer delay-3">{subtitulo}</p>
    <p class="producto-desc aparecer delay-4">{descripcion}</p>

    <div class="producto-botones aparecer delay-5">
      <a
        href={primario.href}
        class={`boton ${disponible ? 'boton-verde' : 'boton-primario'}`}
        target={esExterno(primario.href) ? '_blank' : undefined}
        rel={esExterno(primario.href) ? 'noopener noreferrer' : undefined}
      >
        {primario.texto}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a
        href={secundario.href}
        class="boton boton-secundario"
        target={esExterno(secundario.href) ? '_blank' : undefined}
        rel={esExterno(secundario.href) ? 'noopener noreferrer' : undefined}
      >
        {secundario.texto}
      </a>
    </div>
  </div>
</section>

<!-- Features del producto -->
<section class="seccion">
  <div class="encabezado-seccion aparecer" style="text-align:center;align-items:center">
    <span class="etiqueta">Funcionalidades</span>
    <h2 class="titulo-seccion">Todo lo que incluye.</h2>
  </div>

  <div class="grilla-features-producto">
    {features.map((feat, indice) => (
      <div class={`card-feature aparecer delay-${(indice % 4) + 1}`}>
        <div class="icono-contenedor item-producto">
          <IconoSVG nombre={feat.icono} tamaño={22} grosor={1.5} />
        </div>
        <h3 class="feat-nombre">{feat.titulo}</h3>
        <p class="feat-desc">{feat.descripcion}</p>
      </div>
    ))}
  </div>
</section>

<!-- Planes de precio -->
{planes && planes.length > 0 && (
  <div class="fondo-puntos">
    <div class="panel-interior">
      <section class="seccion">
        <div class="encabezado-seccion aparecer" style="text-align:center;align-items:center">
          <span class="etiqueta">Precios</span>
          <h2 class="titulo-seccion">{planesTitulo}</h2>
          <p class="subtitulo" style="text-align:center">{planesLead}</p>
        </div>

        <div class={`grilla-planes grilla-planes-${planes.length}`}>
          {planes.map((plan, indice) => {
            const planUrl = plan.url ?? '/#contacto';
            return (
            <div class={`card-plan aparecer-escala delay-${indice + 1} ${plan.destacado ? 'plan-destacado' : ''}`}>
              {plan.destacado && <span class="plan-badge-popular">{plan.badge ?? 'Mas popular'}</span>}
              <h3 class="plan-nombre">{plan.nombre}</h3>
              <div class="plan-precio-bloque">
                <span class="plan-monto">{plan.precio}</span>
                <span class="plan-periodo">{plan.periodo}</span>
              </div>
              <ul class="plan-items">
                {plan.items.map((item) => (
                  <li>
                    <IconoSVG nombre="check" tamaño={15} grosor={2.5} clase="plan-check" />
                    {item}
                  </li>
                ))}
              </ul>
              <a
                href={planUrl}
                class={`boton ${plan.destacado ? 'boton-verde' : 'boton-secundario'}`}
                style="width:100%;text-align:center"
                target={esExterno(planUrl) ? '_blank' : undefined}
                rel={esExterno(planUrl) ? 'noopener noreferrer' : undefined}
              >
                {plan.textoBoton}
              </a>
            </div>
            );
          })}
        </div>
      </section>
    </div>
  </div>
)}

<!-- Sin precio: consultar -->
{sinPrecio && (
  <div class="fondo-puntos">
    <div class="panel-interior">
      <section class="seccion" style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:1.25rem">
        <span class="etiqueta">Precio</span>
        <h2 class="titulo-seccion aparecer">A medida.</h2>
        <p class="subtitulo aparecer delay-1" style="text-align:center;max-width:480px">{textoSinPrecio}</p>
        <a href="/#contacto" class="boton boton-verde aparecer delay-2">
          Pedir presupuesto
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </section>
    </div>
  </div>
)}

<!-- CTA final -->
<section class="seccion" style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:1.25rem">
  <h2 class="titulo-seccion aparecer">
    <span>{cierreTitulo}</span>
  </h2>
  <p class="subtitulo aparecer delay-1" style="text-align:center">
    {cierreSub}
  </p>
  <div class="aparecer delay-2" style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
    {cierreCta ? (
      <a
        href={cierreCta.href}
        class="boton boton-primario"
        target={esExterno(cierreCta.href) ? '_blank' : undefined}
        rel={esExterno(cierreCta.href) ? 'noopener noreferrer' : undefined}
      >
        {cierreCta.texto}
      </a>
    ) : (
      <button class="boton boton-primario abrir-form-contacto">
        Escribirnos
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      </button>
    )}
    <a href="https://wa.me/5491100000000" class="boton boton-secundario" target="_blank" rel="noopener noreferrer">WhatsApp</a>
  </div>
</section>

<!-- Modal de formulario -->
<div class="form-modal" id="form-modal">
  <div class="form-modal-overlay"></div>
  <div class="form-modal-body">
    <FormularioContacto productoPreseleccionado={nombre} />
  </div>
</div>

<style>
  /* ─── Hero ─── */
  .producto-hero {
    min-height: 70vh;
    display: flex; align-items: center; justify-content: center;
    padding: 120px 24px 80px;
    background: var(--gradiente-hero);
    position: relative; z-index: 2;
  }

  .producto-hero-contenido {
    max-width: 700px;
    text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 1rem;
  }

  .titulo-producto {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--texto);
  }

  .icono-grande { width: 60px; height: 60px; border-radius: 16px; }

  .producto-subtitulo {
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    color: var(--salix); font-weight: 600; letter-spacing: -0.01em;
  }

  .producto-desc {
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    color: var(--texto-secundario); line-height: 1.7; max-width: 480px;
  }

  .producto-botones {
    display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 0.5rem;
  }

  /* Titulos de seccion mas chicos en paginas de producto */
  :global(.titulo-seccion) {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
  }

  /* ─── Features ─── */
  .encabezado-seccion {
    margin-bottom: 3rem;
    display: flex; flex-direction: column; gap: 0.75rem;
  }

  .grilla-features-producto {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
  }

  .card-feature {
    background: var(--card); border: 1px solid var(--borde);
    border-radius: var(--radio-card);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    display: flex; flex-direction: column; gap: 0.75rem;
    transition: all var(--transicion);
  }

  .card-feature:hover {
    border-color: var(--salix-borde); transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.06);
  }

  .card-feature:hover .icono-contenedor { transform: scale(1.1) rotate(-5deg); }

  .feat-nombre { font-size: 0.92rem; font-weight: 600; color: var(--texto); }
  .feat-desc { font-size: 0.82rem; color: var(--texto-secundario); line-height: 1.7; }

  /* ─── Planes de precio ─── */
  .grilla-planes {
    display: grid; gap: 1.25rem; align-items: start;
  }

  .grilla-planes-2 { grid-template-columns: repeat(2, 1fr); max-width: 700px; margin: 0 auto; }
  .grilla-planes-3 { grid-template-columns: repeat(3, 1fr); }
  .grilla-planes-4 { grid-template-columns: repeat(4, 1fr); }

  .card-plan {
    background: var(--card); border: 1px solid var(--borde);
    border-radius: var(--radio-card);
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex; flex-direction: column; gap: 1.25rem;
    position: relative; transition: all var(--transicion);
  }

  .card-plan:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.06);
  }

  .plan-destacado {
    border-color: var(--salix-borde);
    background: var(--gradiente-card), var(--card);
    box-shadow: 0 0 0 1px var(--salix-borde);
  }

  .plan-destacado:hover {
    box-shadow: 0 12px 40px rgba(22, 163, 74, 0.12);
  }

  .plan-badge-popular {
    position: absolute; top: -10px; left: 50%; transform: translateX(-50%);
    background: var(--salix); color: #fff;
    font-size: 0.72rem; font-weight: 600;
    padding: 3px 14px; border-radius: var(--radio-pill);
  }

  .plan-nombre { font-size: 1rem; font-weight: 600; color: var(--texto); }

  .plan-precio-bloque { display: flex; align-items: baseline; gap: 0.4rem; }

  .plan-monto {
    font-size: clamp(1.5rem, 2.5vw, 1.8rem); font-weight: 600;
    color: var(--texto); letter-spacing: -0.03em;
  }

  .plan-periodo { font-size: 0.8rem; color: var(--texto-terciario); }

  .plan-items {
    display: flex; flex-direction: column; gap: 0.6rem; flex: 1;
  }

  .plan-items li {
    display: flex; align-items: center; gap: 0.6rem;
    font-size: 0.85rem; color: var(--texto-secundario);
  }

  .plan-items :global(.plan-check) {
    stroke: var(--salix) !important; flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .grilla-features-producto { grid-template-columns: repeat(2, 1fr); }
    .grilla-planes-4 { grid-template-columns: repeat(2, 1fr); }
    .grilla-planes-3 { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; }
    .grilla-planes-2 { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; }
  }

  @media (max-width: 640px) {
    .grilla-features-producto { grid-template-columns: 1fr; }
    .grilla-planes-4 { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; }
  }

  /* ─── Modal formulario ─── */
  .form-modal {
    position: fixed; inset: 0; z-index: 500;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
    transition: opacity 0.35s ease;
    padding: 1rem;
  }

  .form-modal.abierto {
    opacity: 1; pointer-events: all;
  }

  .form-modal-overlay {
    position: absolute; inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .form-modal-body {
    position: relative; z-index: 1;
    width: 100%; max-width: 560px;
    max-height: 90vh; overflow-y: auto;
    transform: translateY(20px) scale(0.97);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .form-modal.abierto .form-modal-body {
    transform: translateY(0) scale(1);
  }

</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('form-modal');
    if (!modal) return;

    const overlay = modal.querySelector('.form-modal-overlay');
    const botones = document.querySelectorAll('.abrir-form-contacto');

    function abrir() {
      modal.classList.add('abierto');
      document.body.style.overflow = 'hidden';
    }

    function cerrarModal() {
      modal.classList.remove('abierto');
      document.body.style.overflow = '';
    }

    botones.forEach(b => b.addEventListener('click', abrir));
    overlay.addEventListener('click', cerrarModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('abierto')) cerrarModal();
    });
  });
</script>
