---
// ============================================================
// Nav.astro — la barra y el menú móvil de la familia Salix (publico-salix.md, en la carpeta de la
// familia del repo de Flux). La forma y el comportamiento son los de toda la familia
// (src/styles/publico-salix.css y src/scripts/publico-salix.ts, GENERADOS): acá solo va lo de
// Salix — el logo, los enlaces y el botón.
// ============================================================
import LogoSalixAnimado from './LogoSalixAnimado.astro';

const ENLACES = [
  { href: '/#inicio', texto: 'Inicio' },
  { href: '/#productos', texto: 'Productos' },
  { href: '/#porque', texto: 'Por qué Salix' },
  { href: '/#testimonios', texto: 'Clientes' },
  { href: '/#contacto', texto: 'Contacto' },
];
const CTA = { href: '/#contacto', texto: 'Hablemos' };
---

<div class="psx-progreso" aria-hidden="true"></div>

<header id="nav-principal" class="psx-barra">
  <div class="psx-barra-marca">
    <a href="/" aria-label="Salix, inicio">
      <span class="msx">
        <span class="msx-icono">
          <LogoSalixAnimado clase="msx-svg" id="copa-salix-nav" tamaño={26} />
        </span>
        <span class="msx-nombre" aria-hidden="true">
          <span class="msx-letra" style="--i:0">S</span><span class="msx-letra" style="--i:1">a</span><span class="msx-letra" style="--i:2">l</span><span class="msx-letra" style="--i:3">i</span><span class="msx-letra" style="--i:4">x</span>
        </span>
      </span>
    </a>
  </div>

  <nav class="psx-barra-enlaces" aria-label="Secciones">
    {ENLACES.map((e) => <a class="psx-enlace" href={e.href}>{e.texto}</a>)}
  </nav>

  <div class="psx-barra-acciones">
    <a class="psx-cta" href={CTA.href}>{CTA.texto}</a>
    <button class="psx-hamburguesa" type="button" aria-label="Menú" aria-expanded="false" aria-controls="menu-movil">
      <span class="psx-h-linea"></span>
      <span class="psx-h-linea"></span>
      <span class="psx-h-linea"></span>
    </button>
  </div>
</header>

<div id="menu-movil" class="psx-menu">
  <nav class="psx-menu-enlaces" aria-label="Secciones">
    {ENLACES.map((e, i) => (
      <a class="psx-menu-enlace" href={e.href} style={`--i:${i}`}>
        <span class="psx-menu-num">{String(i + 1).padStart(2, '0')}</span>
        <span class="psx-menu-texto">{e.texto}</span>
      </a>
    ))}
  </nav>
  <div class="psx-menu-pie">
    <a class="psx-cta psx-cta--ancho" href={CTA.href}>{CTA.texto}</a>
    <firma-stian logo="/firma-stian/logo-claro.png"></firma-stian>
  </div>
</div>
