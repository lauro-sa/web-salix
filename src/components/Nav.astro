---
// ============================================================
// Nav.astro — Barra de navegacion principal (rediseño v2)
// Logo animado, hamburguesa morphing, links con underline.
// Toggle de tema movido al footer.
// ============================================================
import LogoSalix from './LogoSalix.astro';
---

<nav id="nav-principal" class="nav">
  <!-- Logo animado -->
  <a href="/" class="logo" aria-label="Salix inicio">
    <div class="logo-icono">
      <LogoSalix clase="logo-svg" tamaño={26} />
    </div>
    <span class="logo-nombre" aria-label="Salix">
      <span class="logo-letra" style="--i:0">S</span><span class="logo-letra" style="--i:1">a</span><span class="logo-letra" style="--i:2">l</span><span class="logo-letra" style="--i:3">i</span><span class="logo-letra" style="--i:4">x</span>
    </span>
  </a>

  <!-- Links de navegacion desktop -->
  <ul class="nav-links" role="list">
    <li><a href="/#inicio">Inicio</a></li>
    <li><a href="/#productos">Productos</a></li>
    <li><a href="/#porque">Por que Salix</a></li>
    <li><a href="/#testimonios">Clientes</a></li>
    <li><a href="/#contacto">Contacto</a></li>
  </ul>

  <!-- Controles de la derecha -->
  <div class="nav-derecha">
    <!-- Boton CTA nav -->
    <a href="/#contacto" class="nav-cta boton boton-primario">Hablemos</a>

    <!-- Hamburguesa minimalista -->
    <button id="boton-hamburguesa" class="hamburguesa" aria-label="Abrir menu" aria-expanded="false">
      <span class="h-linea"></span>
      <span class="h-linea"></span>
      <span class="h-linea"></span>
    </button>
  </div>
</nav>

<!-- Menu mobile fullscreen -->
<div id="menu-mobile" class="menu-mobile" role="dialog" aria-label="Menu de navegacion">
  <div class="menu-mobile-contenido">
    <a href="/"             class="link-menu"><span class="link-menu-num">00</span><span class="link-menu-texto">Inicio</span></a>
    <a href="/#productos"   class="link-menu"><span class="link-menu-num">01</span><span class="link-menu-texto">Productos</span></a>
    <a href="/#porque"      class="link-menu"><span class="link-menu-num">02</span><span class="link-menu-texto">Por que Salix</span></a>
    <a href="/#testimonios" class="link-menu"><span class="link-menu-num">03</span><span class="link-menu-texto">Clientes</span></a>
    <a href="/#contacto"    class="link-menu"><span class="link-menu-num">04</span><span class="link-menu-texto">Contacto</span></a>
  </div>
  <div class="menu-mobile-firma">
    <firma-stian logo="/firma-stian/logo-claro.png"></firma-stian>
  </div>
</div>

<style>
  /* ─── Nav Base ─── */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 300;
    display: flex; align-items: center; justify-content: space-between;
    padding: calc(14px + env(safe-area-inset-top)) 32px 14px 32px;
    background-color: transparent;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: background-color .4s, border-bottom .4s, box-shadow .4s;
  }

  .nav.fijo {
    background-color: color-mix(in srgb, var(--fondo) 60%, transparent);
    border-bottom: 1px solid var(--borde);
  }

  /* ─── Logo Animado ─── */
  .logo {
    display: flex; align-items: center; gap: 8px;
    text-decoration: none; color: var(--texto);
  }

  .logo-icono {
    position: relative;
    display: flex; align-items: center; justify-content: center;
  }

  .logo-svg {
    height: 26px; width: auto;
    animation: logoEntrada 1s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.4s;
  }

  .logo:hover .logo-svg {
    transform: scale(1.08);
  }

  @keyframes logoEntrada {
    0%   { opacity: 0; transform: scale(0) rotate(-180deg); }
    100% { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  /* Brillo pulsante detras del logo */
  .logo-icono::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: var(--salix);
    opacity: 0;
    filter: blur(12px);
    animation: logoPulso 3s ease-in-out 1.2s infinite;
    z-index: -1;
  }

  @keyframes logoPulso {
    0%, 100% { opacity: 0; transform: scale(0.8); }
    50%      { opacity: 0.15; transform: scale(1.2); }
  }

  /* Nombre "Salix" letra por letra */
  .logo-nombre {
    font-size: 16px; font-weight: 700; letter-spacing: -0.3px;
    display: flex;
  }

  .logo-letra {
    display: inline-block;
    animation: letraEntrada 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(0.6s + var(--i) * 0.08s);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.3s;
  }

  .logo:hover .logo-letra {
    color: var(--salix);
    animation: letraRebote 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    animation-delay: calc(var(--i) * 0.04s);
  }

  @keyframes letraEntrada {
    0%   { opacity: 0; transform: translateY(14px) scale(0.5); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes letraRebote {
    0%   { transform: translateY(0); }
    40%  { transform: translateY(-6px); }
    100% { transform: translateY(0); }
  }

  /* ─── Links Desktop ─── */
  .nav-links { display: flex; align-items: center; gap: 2px; }

  .nav-links a {
    font-size: 13.5px; font-weight: 500; color: var(--texto-secundario);
    padding: 10px 14px; border-radius: 8px;
    min-height: 44px; display: inline-flex; align-items: center;
    position: relative;
    transition: color .25s;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: 2px; left: 50%; right: 50%;
    height: 1.5px;
    background: var(--salix);
    border-radius: 1px;
    transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1), right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-links a:hover { color: var(--texto); }
  .nav-links a:hover::after { left: 14px; right: 14px; }

  /* ─── Controles Derecha ─── */
  .nav-derecha { display: flex; align-items: center; gap: 10px; }

  .nav-cta {
    font-size: 13px !important;
    padding: 10px 18px !important;
    min-height: 44px !important;
  }

  /* ─── Hamburguesa Minimalista (3 lineas → X) ─── */
  .hamburguesa {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 12px;
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: none;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  .h-linea {
    display: block;
    width: 20px; height: 1.5px;
    background: var(--texto);
    border-radius: 2px;
    transition: transform 0.35s ease, opacity 0.35s ease, background 0.35s;
  }

  /* Linea del medio mas corta */
  .h-linea:nth-child(2) { width: 14px; }

  /* Estado abierto → X */
  .hamburguesa.on .h-linea { background: var(--salix); width: 22px; }
  .hamburguesa.on .h-linea:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .hamburguesa.on .h-linea:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .hamburguesa.on .h-linea:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* ─── Menu Mobile Fullscreen ─── */
  .menu-mobile {
    position: fixed; inset: 0; z-index: 199;
    background: var(--fondo);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
    transition: opacity .4s ease;
    overflow: hidden;
  }

  .menu-mobile.on { opacity: 1; pointer-events: all; }

  .menu-mobile-contenido {
    display: flex; flex-direction: column; gap: 0;
    width: 100%; max-width: 340px; padding: 0 2rem;
    text-align: left;
  }

  .link-menu {
    display: flex; align-items: baseline; gap: 4px;
    padding: 14px 0;
    color: var(--texto);
  }

  .link-menu-num {
    transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    transform: translateX(-60px);
  }

  .link-menu-texto {
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.4, 0, 0.2, 1),
                filter 0.7s ease;
    opacity: 0;
    transform: translateY(16px);
    filter: blur(6px);
  }

  .menu-mobile.on .link-menu-num {
    opacity: 0.2;
    transform: translateX(0);
  }

  .menu-mobile.on .link-menu-texto {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0px);
  }

  /* Delays: num entra, 150ms después su texto */
  .menu-mobile.on .link-menu:nth-child(1) .link-menu-num   { transition-delay: 0.12s; }
  .menu-mobile.on .link-menu:nth-child(1) .link-menu-texto { transition-delay: 0.27s; }
  .menu-mobile.on .link-menu:nth-child(2) .link-menu-num   { transition-delay: 0.38s; }
  .menu-mobile.on .link-menu:nth-child(2) .link-menu-texto { transition-delay: 0.53s; }
  .menu-mobile.on .link-menu:nth-child(3) .link-menu-num   { transition-delay: 0.64s; }
  .menu-mobile.on .link-menu:nth-child(3) .link-menu-texto { transition-delay: 0.79s; }
  .menu-mobile.on .link-menu:nth-child(4) .link-menu-num   { transition-delay: 0.90s; }
  .menu-mobile.on .link-menu:nth-child(4) .link-menu-texto { transition-delay: 1.05s; }
  .menu-mobile.on .link-menu:nth-child(5) .link-menu-num   { transition-delay: 1.16s; }
  .menu-mobile.on .link-menu:nth-child(5) .link-menu-texto { transition-delay: 1.31s; }
  .menu-mobile.on .link-menu:nth-child(6) .link-menu-num   { transition-delay: 1.42s; }
  .menu-mobile.on .link-menu:nth-child(6) .link-menu-texto { transition-delay: 1.57s; }

  .link-menu-num {
    font-size: clamp(1.4rem, 5vw, 1.8rem);
    font-weight: 600;
    color: var(--texto-terciario);
    opacity: 0.2;
    font-family: var(--fuente-mono, monospace);
  }

  .link-menu-texto {
    font-size: clamp(1.4rem, 5vw, 1.8rem);
    font-weight: 500; letter-spacing: -0.3px;
  }

  .link-menu:hover {
    color: var(--salix);
    transform: translateX(6px);
  }


  /* ─── Firma en menu mobile ─── */
  .menu-mobile-firma {
    position: absolute;
    bottom: max(24px, env(safe-area-inset-bottom, 24px));
    left: 0; right: 0;
    display: flex; justify-content: center;
    opacity: 0;
    transition: opacity .4s ease .38s;
  }

  .menu-mobile.on .menu-mobile-firma {
    opacity: 1;
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .nav-links { display: none; }
    .nav-cta { display: none; }
    .hamburguesa { display: flex; }
    .nav { padding: calc(14px + env(safe-area-inset-top)) 20px 14px 20px; }
  }

  /* iOS: subir nav para cubrir zona del status bar */
  @supports (-webkit-touch-callout: none) {
    .nav {
      top: -75px;
      padding-top: calc(75px + 14px);
    }
  }
</style>
