---
// Isotipo de Flux — la «Ficha en dos tonos» desde el 2026-09-30 (antes, el círculo con la onda).
// Fill, no stroke.
//
// ⚠️ Hasta el 2026-08-19 acá había otro dibujo: el logo de la CBC, la radiodifusora
// pública de Canadá, bajado de Simple Icons. Toda la familia lo arrastraba como
// "placeholder" y nadie lo miró de cerca — en Flux llegó hasta el ícono de la App Store.
//
// La geometría sale de src/logos-productos.json, que escribe el generador de marca del repo de
// Flux (`node scripts/marca/generar.mjs`) desde su isotipo-flux.svg. No se escribe a mano: hasta
// el 2026-09-28 estaba copiada acá y se iba a desalinear en el próximo cambio.
import logos from '../logos-productos.json';
interface Props {
  tamaño?: number;
  clase?: string;
}

const { tamaño = 22, clase = '' } = Astro.props;

const { flux } = logos;
// Un logo en dos tonos llega con `capas` (un path por tono, la transparencia del mismo color);
// uno de un solo color, sin ellas. Pintar `flux.d` solo perdería el segundo tono.
const capas =
  'capas' in flux && Array.isArray(flux.capas)
    ? (flux.capas as { opacidad: number; fillRule: string; d: string }[])
    : [{ opacidad: 1, fillRule: flux.fillRule, d: flux.d }];
---

<svg
  class:list={['logo-flux', clase]}
  width={tamaño}
  height={tamaño}
  viewBox={flux.viewBox}
  aria-hidden="true"
>
  {
    capas.map((c) => (
      <path
        d={c.d}
        fill-rule={c.fillRule}
        fill="currentColor"
        fill-opacity={c.opacidad < 1 ? c.opacidad : undefined}
      />
    ))
  }
</svg>

<style>
  .logo-flux {
    display: block;
    color: var(--ico-color);
    flex-shrink: 0;
  }
</style>
