---
// Isotipo de Nuvix — «Órbita»: un arco abierto y el punto que sigue. Es la geometría del logo de
// la app (logo/isotipo.svg en el repo de Nuvix), sin redibujar.
interface Props {
  tamaño?: number;
  clase?: string;
}

const { tamaño = 22, clase = '' } = Astro.props;
---

<svg class:list={['logo-nuvix', clase]} width={tamaño} height={tamaño} viewBox="21 21 78 78" aria-hidden="true">
  <path fill="none" stroke="currentColor" stroke-width="13" stroke-linecap="round" d="M89.96,58.43A30,30 0 1 1 61.57,30.04" />
  <circle fill="currentColor" cx="81.2" cy="38.8" r="8.5" />
</svg>

<style>
  .logo-nuvix {
    display: block;
    color: var(--ico-color);
    flex-shrink: 0;
  }
</style>
