---
// Pictogramas de módulo de Flux (mismos que flux.salixweb.com).
// Siempre visibles: no usan la animación stroke-dash de IconoSVG.
import logos from '../logos-productos.json';
interface Props {
  nombre: string;
  tamaño?: number;
}

const { nombre, tamaño = 22 } = Astro.props;

const PATH_WA =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z';

// El logo de Salix IA sale de src/logos-productos.json, que escribe el generador de marca del
// repo de Flux (`node scripts/marca/generar.mjs`) desde su isotipo-salix-ia.svg. No se copia a
// mano: hasta el 2026-09-30 acá había una copia del glifo viejo que nadie iba a actualizar.
// Va por capas: sus círculos se superponen al 50 % y el cruce se oscurece.
const CAPAS_IA = logos.salixIa.capas;
---

{nombre === 'whatsapp' && (
  <svg class="icono-modulo-flux" width={tamaño} height={tamaño} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d={PATH_WA}></path>
  </svg>
)}
{nombre === 'salix-ia' && (
  <svg class="icono-modulo-flux" width={tamaño} height={tamaño} viewBox={logos.salixIa.viewBox} fill="currentColor" aria-hidden="true">
    {CAPAS_IA.map((capa) => (
      <path fill-rule={capa.fillRule} fill-opacity={capa.opacidad === 1 ? undefined : capa.opacidad} d={capa.d}></path>
    ))}
  </svg>
)}
{nombre === 'presupuestos' && (
  <svg class="icono-modulo-flux icono-trazo" width={tamaño} height={tamaño} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
    <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
    <path d="M10 9H8M16 13H8M16 17H8"></path>
  </svg>
)}
{nombre === 'facturacion' && (
  <svg class="icono-modulo-flux icono-trazo" width={tamaño} height={tamaño} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"></path>
    <path d="M14 8H8M16 12H8M13 16H8"></path>
  </svg>
)}
{nombre === 'visitas' && (
  <svg class="icono-modulo-flux icono-trazo" width={tamaño} height={tamaño} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
    <circle cx="12" cy="10" r="3"></circle>
  </svg>
)}
{nombre === 'mi-web' && (
  <svg class="icono-modulo-flux icono-trazo" width={tamaño} height={tamaño} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="10"></circle>
    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
    <path d="M2 12h20"></path>
  </svg>
)}

<style>
  .icono-modulo-flux {
    display: block;
    color: var(--salix);
    flex-shrink: 0;
  }
</style>
