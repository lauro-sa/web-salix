---
// ============================================================
// Orbita.astro — lo que hace la casa, girando alrededor del isotipo de Salix.
// Es la órbita de la familia (la misma geometría de la portada de Flux y del escenario de entrada:
// nucleo/ui/entrada/geometria.ts del monorepo): en Flux giran los módulos alrededor de Flux; acá,
// los productos y servicios alrededor de Salix. Cada burbuja lleva a su parte de la página; cada
// tanto cambia la resaltada y, con ella, el rótulo de abajo. Se frena al pasarle el mouse.
// ============================================================
import IconoProducto from './IconoProducto.astro';
import LogoSalixAnimado from './LogoSalixAnimado.astro';
import { COSAS } from '../casa/cosas';

interface Props {
  /** Lo que va antes del `#` de cada enlace: '' en la portada, la ruta de la portada en el resto. */
  base?: string;
}
const { base = '' } = Astro.props;

---

<div class="orb-caja" data-orbita>
  <div class="orb">
    <svg class="orb-anillos" viewBox="-175 -175 350 350" aria-hidden="true" focusable="false">
      <circle class="orb-anillo orb-anillo--afuera" r="140" pathLength="72" />
      <circle class="orb-anillo orb-anillo--adentro" r="88" pathLength="44" />
    </svg>
    <div class="orb-giro">
      {COSAS.map((c, i) => (
        <div class="orb-lugar" style={`--i:${i}`}>
          <div class="orb-derecho">
            <div class="orb-contra">
              <a
                class:list={['orb-burbuja', { 'orb-burbuja--obra': c.obra, 'orb-burbuja--activa': i === 0 }]}
                href={`${base}#${c.ancla}`}
                style={`--c:var(--linea-${c.id});--i:${i}`}
                aria-label={`${c.nombre}: ${c.que}`}
                data-nombre={c.nombre}
                data-que={c.que}
              >
                <IconoProducto nombre={c.icono} tamaño={25} />
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="orb-centro" aria-hidden="true"><LogoSalixAnimado id="copa-orbita" /></div>
  </div>
  <p class="orb-rotulo" aria-live="off"><strong data-orb-nombre>{COSAS[0].nombre}</strong> <span data-orb-que>{COSAS[0].que}</span></p>
</div>

<script>
  // La órbita: cada tanto cambia cuál está resaltada y, con ella, el rótulo de abajo. Pasar el mouse
  // o tocar una la resalta. Con «reducir movimiento» no cambia sola.
  document.querySelectorAll<HTMLElement>('[data-orbita]').forEach((caja) => {
    const burbujas = Array.from(caja.querySelectorAll<HTMLElement>('.orb-burbuja'));
    const nombre = caja.querySelector<HTMLElement>('[data-orb-nombre]')!;
    const que = caja.querySelector<HTMLElement>('[data-orb-que]')!;
    const rotulo = caja.querySelector<HTMLElement>('.orb-rotulo')!;
    let activa = 0;
    let encima = false;
    const resaltar = (i: number) => {
      activa = i;
      burbujas.forEach((b, j) => b.classList.toggle('orb-burbuja--activa', j === i));
      rotulo.classList.remove('orb-rotulo--cambia');
      void rotulo.offsetWidth;
      rotulo.classList.add('orb-rotulo--cambia');
      nombre.textContent = burbujas[i].dataset.nombre ?? '';
      que.textContent = burbujas[i].dataset.que ?? '';
    };
    burbujas.forEach((b, i) => {
      b.addEventListener('pointerenter', () => resaltar(i));
      b.addEventListener('focus', () => resaltar(i));
    });
    caja.addEventListener('pointerenter', () => (encima = true));
    caja.addEventListener('pointerleave', () => (encima = false));
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    window.setInterval(() => {
      if (encima || document.hidden) return;
      resaltar((activa + 1) % burbujas.length);
    }, 2800);
  });
</script>

<style>
  /* ── A · La órbita. Todas las medidas salen de `--u`, con la geometría de la familia: escenario de
     350, anillo de 140 con burbujas de 54, anillo de adentro de 88 y centro de 112. ── */
  .orb-caja {
    /* En pantallas angostas cede lugar, para que el texto, los botones y la órbita entren en la
       primera pantalla del teléfono. */
    --u: clamp(0.7px, min(100vw - 5rem, 42svh) / 350, 1.1px);
    display: grid;
    justify-items: center;
    gap: calc(var(--u) * 26);
  }
  @media (min-width: 56rem) {
    .orb-caja {
      --u: clamp(0.78px, min(34vw, 62svh) / 350, 1.32px);
    }
  }
  .orb {
    position: relative;
    inline-size: calc(var(--u) * 350);
    block-size: calc(var(--u) * 350);
  }
  .orb-anillos {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
  }
  /* Un guion de largo cero con la punta redonda es un punto: 72 afuera y 44 adentro. */
  .orb-anillo {
    fill: none;
    stroke: var(--texto);
    stroke-linecap: round;
    stroke-dasharray: 0 1;
  }
  .orb-anillo--afuera {
    stroke-width: 3;
    opacity: 0.22;
  }
  .orb-anillo--adentro {
    stroke-width: 2;
    opacity: 0.12;
  }
  .orb-giro {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-start: 50%;
    inline-size: 0;
    block-size: 0;
  }
  .orb-lugar {
    position: absolute;
    inline-size: 0;
    block-size: 0;
    transform: rotate(calc(var(--i) * 45deg)) translateY(calc(var(--u) * -140));
  }
  .orb-derecho {
    position: absolute;
    inset-inline-start: calc(var(--u) * -27);
    inset-block-start: calc(var(--u) * -27);
    inline-size: calc(var(--u) * 54);
    block-size: calc(var(--u) * 54);
    transform: rotate(calc(var(--i) * -45deg));
  }
  .orb-contra {
    inline-size: 100%;
    block-size: 100%;
  }
  .orb-burbuja {
    display: grid;
    place-items: center;
    inline-size: 100%;
    block-size: 100%;
    border-radius: 50%;
    background: var(--fondo-alt);
    box-shadow: inset 0 0 0 1px var(--borde);
    color: var(--texto-secundario);
    transition:
      box-shadow 0.5s ease,
      color 0.5s ease,
      scale 0.5s var(--curva);
  }
  .orb-burbuja :global(svg) {
    inline-size: calc(var(--u) * 25);
    block-size: calc(var(--u) * 25);
  }
  .orb-burbuja--obra {
    background: none;
    box-shadow: none;
    outline: 1px dashed var(--borde);
    outline-offset: -1px;
    color: var(--texto-terciario);
  }
  .orb-burbuja--activa {
    scale: 1.12;
    color: var(--c);
    box-shadow:
      inset 0 0 0 1.5px var(--c),
      0 0 calc(var(--u) * 26) color-mix(in srgb, var(--c) 38%, transparent);
  }
  .orb-centro {
    position: absolute;
    inset: calc(50% - var(--u) * 56);
    display: grid;
    place-items: center;
    border-radius: calc(var(--u) * 28);
    background: var(--fondo-alt);
    box-shadow:
      inset 0 0 0 1px var(--borde),
      0 calc(var(--u) * 18) calc(var(--u) * 44) calc(var(--u) * -18) rgba(0, 0, 0, 0.45);
  }
  .orb-centro :global(svg) {
    inline-size: calc(var(--u) * 66);
    block-size: calc(var(--u) * 66);
  }
  .orb-rotulo {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-block-size: 2.25rem;
    padding: 0.4375rem 1rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--borde);
    font-size: 0.8125rem;
    color: var(--texto-secundario);
  }
  .orb-rotulo strong {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--texto);
  }
  @media (prefers-reduced-motion: no-preference) {
    .orb-giro {
      animation: orb-girar 100s linear infinite;
    }
    .orb-contra {
      animation: orb-contragirar 100s linear infinite;
    }
    .orb-anillos {
      animation: orb-anillos 1s var(--curva) 0.3s both;
    }
    .orb-burbuja {
      animation: orb-nacer 0.7s cubic-bezier(0.34, 1.4, 0.5, 1) calc(0.5s + var(--i) * 55ms) both;
    }
    .orb:hover .orb-giro,
    .orb:hover .orb-contra {
      animation-play-state: paused;
    }
    :global(.orb-rotulo--cambia) > * {
      animation: orb-rotulo 0.45s var(--curva) both;
    }
  }
  @keyframes orb-girar {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes orb-contragirar {
    to {
      transform: rotate(-360deg);
    }
  }
  @keyframes orb-anillos {
    from {
      opacity: 0;
      transform: scale(0.82) rotate(-24deg);
    }
  }
  @keyframes orb-nacer {
    0% {
      transform: scale(0);
      opacity: 0;
    }
    60% {
      transform: scale(1.06);
      opacity: 1;
    }
  }
  @keyframes orb-rotulo {
    from {
      opacity: 0;
      translate: 0 0.25rem;
    }
  }
</style>
